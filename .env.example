# delegation-kit keys — a template. The installer copies it once to
# ~/.config/delegation-kit/.env (beside config.json, or beside
# $DELEGATION_CONFIG_FILE) with mode 600; fill in only the keys you use.
#
# One NAME=value per line; lines are read, never executed. A variable already
# set in your environment wins over this file. The file is ignored when it is
# a symlink or readable by group or others. Never put the real file in a
# project or commit it.

# Provider runners and HTTP profiles
DEEPSEEK_API_KEY=
QWEN_TOKEN_PLAN_API_KEY=
ZAI_API_KEY=
# The shipped minimax-m3.1-flash profile (openai-compatible)
MINIMAX_API_KEY=
# The shipped muse-spark-1.3 and muse-wonder-1.0 profiles (Meta Model API)
META_API_KEY=

# Any other openai-compatible profile names its own variable with
# `credential_env`; add it here, for example:
# OPENAI_API_KEY=

# Router deciders, only the one your router block uses
SAGE_API_KEY=
TYPESAFE_API_KEY=

# delegation-router catalog refresh (Artificial Analysis)
AA_API_KEY=
