#!/usr/bin/env bash
# Run GLM-5.2 as an external coding lane through an isolated Claude Code process
# configured for the Z.AI API. Fails closed: no fallback to another model,
# effort, or provider is ever allowed.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
ROUTING_FILE="${DELEGATION_GLM_ROUTING_FILE:-$ROOT/config/glm-5.2-routing.json}"
CENTRAL_GATES="${DELEGATION_ROUTING_GATES_FILE:-$ROOT/config/routing-gates.json}"
ROUTER="$ROOT/bin/delegation-route"
# Derived from $ROOT exactly like ROUTING_FILE, so the key and the gate can never
# disagree about where the install lives — a DELEGATION_DATA_HOME install used to
# store the key where the runner never looked. This reads, never writes, so no key
# is created inside a source checkout; running from one, point at the real key
# with DELEGATION_GLM_KEY_FILE.
KEY_FILE="${DELEGATION_GLM_KEY_FILE:-$ROOT/config/zai.env}"
MODEL="glm-5.2"
RUN_TMP=""
RUN_OUTPUT_TMP=""
RUN_METRICS_TMP=""

cleanup_run() {
  [ -z "$RUN_OUTPUT_TMP" ] || rm -f -- "$RUN_OUTPUT_TMP"
  [ -z "$RUN_METRICS_TMP" ] || rm -f -- "$RUN_METRICS_TMP"
  [ -z "$RUN_TMP" ] || rm -rf -- "$RUN_TMP"
}

normalized_destination() {
  local path="$1" parent name
  parent="$(cd "$(dirname "$path")" && pwd -P)" || return 1
  name="$(basename "$path")"
  printf '%s/%s' "$parent" "$name"
}

usage() {
  cat <<'EOF'
Usage:
  delegation-glm check [--json]
  delegation-glm run --lane <clerk|scout|builder|reviewer> \
    [--effort <auto|high|max>] [--backend <auto|claude-zai>] \
    --prompt-file <path> --output <path> --workdir <path> \
    [--metrics <path>] [--max-cost-usd <amount>] [--debug-dir <path>] \
    [--allow-provisional] [--evaluation]

Exit codes: 64 invalid input, 69 unavailable, 70 dispatch failure,
75 temporary/rate-limit failure, 78 lane not qualified.

Failures write a sanitized diagnostic to <output>.error.json. --debug-dir
additionally preserves the raw event stream and stderr in a private subdirectory.
EOF
}

die() { local code="$1"; shift; printf 'delegation-glm: %s\n' "$*" >&2; exit "$code"; }
have() { command -v "$1" >/dev/null 2>&1; }

host_status() {
  HOST_REASON=""
  if have claude || have codex; then HOST_REASON="ready"; return 0; fi
  HOST_REASON="neither Claude Code nor Codex is installed"
  return 1
}

# Each branch assigns on its own: `$(a || b)` would concatenate the stdout of
# every branch it ran, and GNU's `-f` means --file-system, printing a block and
# still failing. An undeterminable mode is not treated as a refusal — that would
# brick the lane on a platform whose stat we cannot read.
key_file_mode() {
  local mode
  if mode="$(stat -c '%a' "$KEY_FILE" 2>/dev/null)"; then printf '%s' "$mode"; return 0; fi
  if mode="$(stat -f '%Lp' "$KEY_FILE" 2>/dev/null)"; then printf '%s' "$mode"; return 0; fi
  printf ''
}

# An explicit ZAI_API_KEY in the environment always wins. Otherwise fall back to
# the key install.sh stored. Parsed, never sourced: the file holds a credential,
# not code to execute. A refusal sets ZAI_KEY_PROBLEM so the caller can report
# the real cause instead of "holds no key".
load_zai_key() {
  ZAI_KEY_PROBLEM=""
  [ -z "${ZAI_API_KEY:-}" ] || return 0
  [ -f "$KEY_FILE" ] || return 0
  local perms raw
  perms="$(key_file_mode)"
  case "$perms" in
    ""|?00) ;;
    *) ZAI_KEY_PROBLEM="key file $KEY_FILE is mode $perms; run: chmod 600 $KEY_FILE"; return 0 ;;
  esac
  # Tolerate the .env shapes the filename invites: an `export` prefix, quotes,
  # surrounding blanks, CRLF. A quoted value loaded raw would authenticate as
  # `"key"` and 401 at dispatch.
  raw="$(sed -n 's/^[[:space:]]*\(export[[:space:]][[:space:]]*\)\{0,1\}ZAI_API_KEY=//p' \
    "$KEY_FILE" 2>/dev/null | head -1)"
  raw="${raw%$'\r'}"
  raw="${raw#"${raw%%[![:space:]]*}"}"
  raw="${raw%"${raw##*[![:space:]]}"}"
  case "$raw" in
    \"*\") raw="${raw#\"}"; raw="${raw%\"}" ;;
    \'*\') raw="${raw#\'}"; raw="${raw%\'}" ;;
  esac
  if [ -n "$raw" ]; then ZAI_API_KEY="$raw"; else ZAI_KEY_PROBLEM="key file $KEY_FILE holds no ZAI_API_KEY line"; fi
}

claude_zai_status() {
  CLAUDE_ZAI_REASON=""
  have claude || { CLAUDE_ZAI_REASON="claude not on PATH"; return 1; }
  local help
  help="$(claude --help 2>&1 || true)"
  grep -q -- '--effort' <<<"$help" \
    || { CLAUDE_ZAI_REASON="claude lacks --effort"; return 1; }
  load_zai_key
  if [ -z "${ZAI_API_KEY:-}" ]; then
    CLAUDE_ZAI_REASON="${ZAI_KEY_PROBLEM:-ZAI_API_KEY is unset and $KEY_FILE holds no key}"
    return 1
  fi
  CLAUDE_ZAI_REASON="ready"
  return 0
}

qualified_lanes() {
  if [ -f "$CENTRAL_GATES" ] && have jq; then
    jq -c '[.profiles | to_entries[] | select(.value.model == "glm-5.2" and .value.harness == "claude-zai") |
      .value.lanes | to_entries[] | select(.value.status == "qualified") | .key] | unique | sort' "$CENTRAL_GATES" 2>/dev/null || printf '[]'
  else
    printf '[]'
  fi
}

provisional_lanes() {
  if [ -f "$CENTRAL_GATES" ] && have jq; then
    jq -c '[.profiles | to_entries[] | select(.value.model == "glm-5.2" and .value.harness == "claude-zai") |
      .value.lanes | to_entries[] | select(.value.status == "provisional") | .key] | unique | sort' "$CENTRAL_GATES" 2>/dev/null || printf '[]'
  else
    printf '[]'
  fi
}

# Read from the gate, never a constant: check must advertise the efforts the
# runner will actually accept, or a caller follows the advertised set straight
# into a 78 and reads it as "this lane failed evaluation".
gate_efforts() {
  if [ -f "$CENTRAL_GATES" ] && have jq; then
    jq -c '[.profiles[] | select(.model == "glm-5.2" and .harness == "claude-zai") as $p |
      $p.lanes[] | select(.status == "qualified" or .status == "provisional") | $p.effort] | unique' "$CENTRAL_GATES" 2>/dev/null || printf '[]'
  else
    printf '[]'
  fi
}

default_effort() {
  local lane="$1" backend="$2"
  [ "$backend" = claude-zai ] || return 1
  jq -r --arg profile "glm-$lane" '.profiles[$profile].effort // empty' "$CENTRAL_GATES" 2>/dev/null
}

gate_status() {
  local lane="$1" backend="$2"
  [ "$backend" = claude-zai ] || { printf 'disabled\n'; return; }
  jq -r --arg profile "glm-$lane" '.profiles[$profile].lanes[]?.status // "disabled"' \
    "$CENTRAL_GATES" 2>/dev/null || printf 'disabled\n'
}

is_allowed() {
  local lane="$1" backend="$2" allow_provisional="$3" status
  status="$(gate_status "$lane" "$backend")"
  [ "$status" = qualified ] || { [ "$status" = provisional ] && [ "$allow_provisional" = 1 ]; }
}

qualified_effort() {
  local lane="$1" backend="$2"
  default_effort "$lane" "$backend"
}

validate_gate_graph() {
  [ -x "$ROUTER" ] || return 1
  DELEGATION_ROUTING_GATES_FILE="$CENTRAL_GATES" \
    DELEGATION_GLM_ROUTING_FILE="$ROUTING_FILE" \
    "$ROUTER" check --json >/dev/null 2>&1
}

print_check() {
  local as_json="${1:-0}" host_ok=false claude_ok=false
  have jq || die 69 "jq is required"
  validate_gate_graph || die 78 "central and executable routing gates are missing, invalid, or inconsistent"
  host_status && host_ok=true || true
  claude_zai_status && claude_ok=true || true
  local lanes provisional efforts selected="none"
  lanes="$(qualified_lanes)"
  provisional="$(provisional_lanes)"
  efforts="$(gate_efforts)"
  if [ "$host_ok" = true ] && [ "$claude_ok" = true ]; then selected="claude-zai"; fi
  if [ "$as_json" = 1 ]; then
    jq -n \
      --arg model "$MODEL" --arg selected "$selected" \
      --argjson efforts "$efforts" --argjson lanes "$lanes" --argjson provisional "$provisional" \
      --argjson host "$host_ok" --arg host_reason "$HOST_REASON" \
      --argjson host_claude "$(have claude && printf true || printf false)" \
      --argjson host_codex "$(have codex && printf true || printf false)" \
      --argjson claude "$claude_ok" --arg claude_reason "$CLAUDE_ZAI_REASON" \
      '{model:$model, efforts:$efforts, selected_backend:$selected,
        host:{available:$host,reason:$host_reason,claude:$host_claude,codex:$host_codex},
        qualified_lanes:$lanes,provisional_lanes:$provisional,backends:{
          "claude-zai":{available:$claude,reason:$claude_reason}}}'
  else
    printf 'GLM-5.2: selected=%s efforts=%s qualified=%s provisional=%s\n' "$selected" "$efforts" "$lanes" "$provisional"
    printf '  host: %s (%s)\n' "$host_ok" "$HOST_REASON"
    printf '  claude-zai: %s (%s)\n' "$claude_ok" "$CLAUDE_ZAI_REASON"
  fi
}

EXTRACT_REASON=""
RESULT_SUBTYPE=""
OBSERVED_MODELS_JSON="[]"

extract_claude() {
  local events="$1" output="$2" metrics="$3" started="$4" backend="$5" effort="$6" lane="$7"
  EXTRACT_REASON=""
  RESULT_SUBTYPE=""
  OBSERVED_MODELS_JSON="[]"

  if ! jq -se 'type == "array" and all(.[]; type == "object")' \
      "$events" >/dev/null 2>&1; then
    EXTRACT_REASON="invalid_stream"
    return 1
  fi
  OBSERVED_MODELS_JSON="$(jq -sc --arg model "$MODEL" '
    [.[] | select(.type == "system" and .subtype == "init") |
      if .model == $model then $model else "<unexpected>" end] | unique
  ' "$events")"
  if ! jq -se 'any(.[]; .type == "system" and .subtype == "init")' \
      "$events" >/dev/null; then
    EXTRACT_REASON="missing_init"
    return 1
  fi
  if ! jq -se --arg model "$MODEL" '
      all(.[]; .type != "system" or .subtype != "init" or .model == $model)
    ' "$events" >/dev/null; then
    EXTRACT_REASON="model_mismatch"
    return 1
  fi
  if ! jq -se 'any(.[]; .type == "result")' "$events" >/dev/null; then
    EXTRACT_REASON="missing_result"
    return 1
  fi
  RESULT_SUBTYPE="$(jq -rs '
    [.[] | select(.type == "result") | .subtype |
      if . == "success" or . == "error_during_execution" or
          . == "error_max_turns" or . == "error_max_budget_usd"
      then . else "<unexpected>" end] | last // ""
  ' "$events")"
  if jq -se '
      ([.[] | select(.type == "result")] | last // {}) as $r |
      ($r.is_error == true) or
      (($r.subtype | type) == "string" and ($r.subtype | startswith("error")))
    ' "$events" >/dev/null; then
    EXTRACT_REASON="result_error"
    return 1
  fi
  if ! jq -se '
      ([.[] | select(.type == "result")] | last // {}) as $r |
      $r.subtype == "success" and ($r.result | type) == "string"
    ' "$events" >/dev/null; then
    EXTRACT_REASON="invalid_stream"
    return 1
  fi
  jq -rs '
    ([.[] | select(.type == "result")] | last // {}) | .result |
    select(type == "string" and length > 0) // empty
  ' "$events" >"$output" || {
    EXTRACT_REASON="invalid_stream"
    return 1
  }
  if [ ! -s "$output" ]; then
    EXTRACT_REASON="empty_result"
    return 1
  fi
  jq -s --arg model "$MODEL" --arg backend "$backend" --arg effort "$effort" \
    --arg lane "$lane" --argjson started "$started" '
    ([.[] | select(.type == "result")] | last // {}) as $r |
    ($r.usage // {}) as $u |
    {model:$model,backend:$backend,effort:$effort,lane:$lane,
     started_at_epoch:$started,finished_at_epoch:now,
     tokens:{input:($u.input_tokens // 0),output:($u.output_tokens // 0),
             reasoning:($u.reasoning_tokens // 0),
             cache_read:($u.cache_read_input_tokens // 0),
             cache_write:($u.cache_creation_input_tokens // 0)},
     provider_cost_usd:($r.total_cost_usd // 0)}' "$events" >"$metrics" || {
    EXTRACT_REASON="invalid_stream"
    return 1
  }
}

preserve_debug_artifacts() {
  local debug_parent="$1" events="$2" stderr_file="$3"
  DEBUG_RUN_DIR=""
  [ -n "$debug_parent" ] || return 0
  DEBUG_RUN_DIR="$(mktemp -d "$debug_parent/delegation-glm.XXXXXX")" || return 1
  chmod 700 "$DEBUG_RUN_DIR"
  cp "$events" "$DEBUG_RUN_DIR/events.jsonl"
  cp "$stderr_file" "$DEBUG_RUN_DIR/stderr.txt"
  chmod 600 "$DEBUG_RUN_DIR/events.jsonl" "$DEBUG_RUN_DIR/stderr.txt"
}

write_failure_diagnostic() {
  local diagnostic="$1" events="$2" stderr_file="$3" started="$4"
  local backend="$5" effort="$6" lane="$7" phase="$8" reason="$9"
  local cli_exit="${10}" debug_path="${11}"
  local stream_valid=false event_bytes=0 stderr_bytes=0 counts="{}"
  local observed_models="$OBSERVED_MODELS_JSON" result_subtype="$RESULT_SUBTYPE"
  local diagnostic_parent diagnostic_name diagnostic_tmp finished

  [ -f "$events" ] && event_bytes="$(wc -c <"$events" | tr -d ' ')"
  [ -f "$stderr_file" ] && stderr_bytes="$(wc -c <"$stderr_file" | tr -d ' ')"
  if jq -se 'type == "array" and all(.[]; type == "object")' \
      "$events" >/dev/null 2>&1; then
    stream_valid=true
    counts="$(jq -sc '
      map((.type // "unknown") as $type |
        if ["system","assistant","user","result","rate_limit_event"] |
            index($type)
        then $type else "unknown" end) |
      group_by(.) | map({key:.[0],value:length}) | from_entries
    ' "$events")"
    [ "$observed_models" != "[]" ] || observed_models="$(jq -sc --arg model "$MODEL" '
      [.[] | select(.type == "system" and .subtype == "init") |
        if .model == $model then $model else "<unexpected>" end] | unique
    ' "$events")"
    [ -n "$result_subtype" ] || result_subtype="$(jq -rs '
      [.[] | select(.type == "result") | .subtype |
        if . == "success" or . == "error_during_execution" or
            . == "error_max_turns" or . == "error_max_budget_usd"
        then . else "<unexpected>" end] | last // ""
    ' "$events")"
  fi
  finished="$(date +%s)"
  diagnostic_parent="$(dirname "$diagnostic")"
  diagnostic_name="$(basename "$diagnostic")"
  diagnostic_tmp="$(mktemp "$diagnostic_parent/.$diagnostic_name.XXXXXX")"
  jq -n \
    --arg model "$MODEL" --arg backend "$backend" --arg effort "$effort" \
    --arg lane "$lane" --arg phase "$phase" --arg reason "$reason" \
    --arg result_subtype "$result_subtype" --arg debug_dir "$debug_path" \
    --argjson cli_exit "$cli_exit" --argjson stream_valid "$stream_valid" \
    --argjson event_bytes "$event_bytes" --argjson stderr_bytes "$stderr_bytes" \
    --argjson event_counts "$counts" --argjson observed_models "$observed_models" \
    --argjson elapsed_seconds "$((finished - started))" '
    {schema_version:1,model:$model,backend:$backend,effort:$effort,lane:$lane,
     phase:$phase,reason:$reason,cli_exit_code:$cli_exit,
     result_subtype:(if $result_subtype == "" then null else $result_subtype end),
     observed_models:$observed_models,
     event_stream:{valid:$stream_valid,bytes:$event_bytes,counts:$event_counts},
     stderr_bytes:$stderr_bytes,elapsed_seconds:$elapsed_seconds,
     debug_dir:(if $debug_dir == "" then null else $debug_dir end)}
  ' >"$diagnostic_tmp"
  chmod 600 "$diagnostic_tmp"
  mv "$diagnostic_tmp" "$diagnostic"
}

run_command() {
  local lane="" effort="auto" backend="auto" prompt_file="" output="" workdir="" metrics="" diagnostic=""
  local debug_dir="" max_cost="2.00" evaluation=0 allow_provisional=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --lane) lane="${2:-}"; shift 2 ;;
      --effort) effort="${2:-}"; shift 2 ;;
      --backend) backend="${2:-}"; shift 2 ;;
      --prompt-file) prompt_file="${2:-}"; shift 2 ;;
      --output) output="${2:-}"; shift 2 ;;
      --workdir) workdir="${2:-}"; shift 2 ;;
      --metrics) metrics="${2:-}"; shift 2 ;;
      --max-cost-usd) max_cost="${2:-}"; shift 2 ;;
      --debug-dir) debug_dir="${2:-}"; shift 2 ;;
      --allow-provisional) allow_provisional=1; shift ;;
      --evaluation) evaluation=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die 64 "unknown run argument: $1" ;;
    esac
  done
  case "$lane" in clerk|scout|builder|reviewer) ;; *) die 64 "invalid lane: $lane" ;; esac
  case "$effort" in auto|high|max) ;; *) die 64 "invalid effort: $effort" ;; esac
  case "$backend" in auto|claude-zai) ;; *) die 64 "invalid backend: $backend" ;; esac
  [ -f "$prompt_file" ] || die 64 "prompt file missing: $prompt_file"
  [ -d "$workdir" ] || die 64 "workdir missing: $workdir"
  [ -n "$output" ] || die 64 "--output is required"
  if [ -n "$debug_dir" ]; then
    [ -d "$debug_dir" ] || die 64 "debug directory missing: $debug_dir"
    [ ! -L "$debug_dir" ] || die 64 "debug directory must not be a symlink: $debug_dir"
    debug_dir="$(cd "$debug_dir" && pwd -P)"
  fi
  have jq || die 69 "jq is required"
  validate_gate_graph || die 78 "central and executable routing gates are missing, invalid, or inconsistent"
  metrics="${metrics:-$output.metrics.json}"
  diagnostic="$output.error.json"
  mkdir -p "$(dirname "$output")" "$(dirname "$metrics")" "$(dirname "$diagnostic")"
  [ ! -d "$output" ] || die 64 "output path is a directory: $output"
  [ ! -d "$metrics" ] || die 64 "metrics path is a directory: $metrics"
  [ ! -d "$diagnostic" ] || die 64 "diagnostic path is a directory: $diagnostic"
  local normalized_output normalized_metrics normalized_diagnostic
  normalized_output="$(normalized_destination "$output")"
  normalized_metrics="$(normalized_destination "$metrics")"
  normalized_diagnostic="$(normalized_destination "$diagnostic")"
  [ "$normalized_output" != "$normalized_metrics" ] \
    || die 64 "output and metrics paths must be distinct"
  [ "$normalized_metrics" != "$normalized_diagnostic" ] \
    || die 64 "metrics path collides with reserved diagnostic path: $diagnostic"

  backend="claude-zai"
  # Qualification before availability: "never approved" (78) is a permanent fact
  # and must not hide behind "runtime is down" (69), which the caller reads as
  # retry-later. Checking availability first made the answer to a permanent
  # question depend on whether a key happened to be present.
  if [ "$evaluation" = 0 ] && ! is_allowed "$lane" "$backend" "$allow_provisional"; then
    status="$(gate_status "$lane" "$backend")"
    if [ "$status" != provisional ]; then
      die 78 "lane '$lane' backend '$backend' has non-dispatchable status '$status'"
    else
      die 78 "lane '$lane' backend '$backend' is provisional; pass --allow-provisional after an explicit routing decision"
    fi
  fi
  host_status || die 69 "$HOST_REASON"
  claude_zai_status || die 69 "$CLAUDE_ZAI_REASON"
  [ "$effort" != auto ] || effort="$(default_effort "$lane" "$backend")"
  # An explicit --effort must not reach past what the gate qualified; only an
  # --evaluation run, whose whole job is measuring a new combination, may.
  if [ "$evaluation" = 0 ]; then
    local expected_effort
    expected_effort="$(qualified_effort "$lane" "$backend")" \
      || die 69 "qualified lane '$lane' has no pinned effort for backend '$backend'"
    [ "$effort" = "$expected_effort" ] \
      || die 78 "lane '$lane' backend '$backend' is qualified only at effort '$expected_effort'"
  fi

  local tmp events stderr_file rc=0 started
  local output_parent output_name metrics_parent metrics_name
  local phase="" reason="" final_rc=0 cli_exit=null debug_warning=""
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/delegation-glm.XXXXXX")"
  RUN_TMP="$tmp"
  trap cleanup_run EXIT
  events="$tmp/events.jsonl"
  stderr_file="$tmp/stderr"
  : >"$events"
  : >"$stderr_file"
  output_parent="$(dirname "$output")"
  output_name="$(basename "$output")"
  metrics_parent="$(dirname "$metrics")"
  metrics_name="$(basename "$metrics")"
  RUN_OUTPUT_TMP="$(mktemp "$output_parent/.$output_name.XXXXXX")"
  RUN_METRICS_TMP="$(mktemp "$metrics_parent/.$metrics_name.XXXXXX")"
  started="$(date +%s)"

  local permission="plan"
  [ "$lane" != builder ] || permission="acceptEdits"
  mkdir -p "$tmp/claude-config"
  # Claude has no --cwd flag. Enter the delegated worktree explicitly so it
  # cannot inspect or edit the delegation-kit source checkout by accident.
  (
    cd "$workdir"
    env -u ANTHROPIC_API_KEY -u CLAUDE_CODE_OAUTH_TOKEN -u ZAI_API_KEY \
      -u ANTHROPIC_MODEL -u ANTHROPIC_CUSTOM_HEADERS \
      -u CLAUDE_CODE_USE_BEDROCK -u CLAUDE_CODE_USE_VERTEX \
      -u CLAUDE_CODE_USE_FOUNDRY \
      ANTHROPIC_AUTH_TOKEN="$ZAI_API_KEY" \
      ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic" \
      ANTHROPIC_DEFAULT_OPUS_MODEL="glm-5.2" \
      CLAUDE_CONFIG_DIR="$tmp/claude-config" \
      CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 API_TIMEOUT_MS=3000000 \
      claude -p "$(<"$prompt_file")" --model opus --effort "$effort" \
      --permission-mode "$permission" --setting-sources '' --strict-mcp-config \
      --output-format stream-json --verbose --no-session-persistence \
      --max-budget-usd "$max_cost"
  ) >"$events" 2>"$stderr_file" || rc=$?
  if [ "$rc" -eq 0 ]; then
    if ! extract_claude "$events" "$RUN_OUTPUT_TMP" "$RUN_METRICS_TMP" \
        "$started" "$backend" "$effort" "$lane"; then
      phase="extract"
      reason="$EXTRACT_REASON"
      final_rc=70
    fi
  else
    phase="dispatch"
    reason="process_exit"
    final_rc=70
    cli_exit="$rc"
  fi

  if [ "$final_rc" -ne 0 ]; then
    # A dead or malformed key is the runtime being unavailable (69), not the
    # worker breaking (70). The API key is now GLM's only credential and
    # claude_zai_status can only see that the string is non-empty — never that it
    # authenticates — so this is the first place a bad key can surface.
    #
    # Read the structured retry events, not the text: a rejected key produces
    # `result.subtype = "error_during_execution"` with an EMPTY result string and
    # nothing auth-shaped in stderr, so there is no keyword to grep for. Grepping
    # the raw stream would also misfire — an ordinary `EACCES: permission denied`
    # from a tool call would masquerade as an auth failure.
    if jq -se 'any(.[]; .type == "system" and .subtype == "api_retry"
                       and (.error_status // 0) == 401)' "$events" >/dev/null 2>&1; then
      reason="authentication_failed"
      final_rc=69
    elif jq -se 'any(.[]; .type == "system" and .subtype == "api_retry"
                         and (.error_status // 0) == 429)' "$events" >/dev/null 2>&1; then
      reason="rate_limited"
      final_rc=75
    elif grep -Eqi 'rate.?limit|too many requests|1312|1305' "$stderr_file" 2>/dev/null; then
      reason="rate_limited"
      final_rc=75
    fi

    DEBUG_RUN_DIR=""
    if [ -n "$debug_dir" ] && ! preserve_debug_artifacts "$debug_dir" "$events" "$stderr_file"; then
      debug_warning="could not preserve raw debug artifacts under $debug_dir"
      DEBUG_RUN_DIR=""
    fi
    write_failure_diagnostic "$diagnostic" "$events" "$stderr_file" "$started" \
      "$backend" "$effort" "$lane" "$phase" "$reason" "$cli_exit" "$DEBUG_RUN_DIR"
    if [ -n "$DEBUG_RUN_DIR" ]; then
      if ! cp "$diagnostic" "$DEBUG_RUN_DIR/diagnostic.json" ||
          ! chmod 600 "$DEBUG_RUN_DIR/diagnostic.json"; then
        debug_warning="could not copy the sanitized diagnostic into $DEBUG_RUN_DIR"
      fi
    fi
    [ -z "$debug_warning" ] || printf 'delegation-glm: warning: %s\n' "$debug_warning" >&2
    printf 'delegation-glm: %s (details: %s)\n' "$reason" "$diagnostic" >&2
    [ -z "$DEBUG_RUN_DIR" ] || printf 'delegation-glm: raw debug artifacts: %s\n' "$DEBUG_RUN_DIR" >&2
    exit "$final_rc"
  fi

  mv "$RUN_OUTPUT_TMP" "$output"
  RUN_OUTPUT_TMP=""
  mv "$RUN_METRICS_TMP" "$metrics"
  RUN_METRICS_TMP=""
  rm -f -- "$output.error.json"
  return 0
}

case "${1:-}" in
  check)
    shift
    if [ "${1:-}" = "--json" ]; then print_check 1; else print_check 0; fi
    ;;
  run)
    shift; run_command "$@"
    ;;
  -h|--help|"") usage ;;
  *) die 64 "unknown command: $1" ;;
esac
