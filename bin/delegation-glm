#!/usr/bin/env bash
# Run a gate-selected GLM model as an external coding lane through an isolated Claude Code process
# configured for the Z.AI API. Fails closed: no fallback to another model,
# effort, or provider is ever allowed.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
ROUTING_FILE="${DELEGATION_GLM_ROUTING_FILE:-$ROOT/config/glm-5.3-flash-max-routing.json}"
CENTRAL_GATES="${DELEGATION_ROUTING_GATES_FILE:-$ROOT/config/routing-gates.json}"
ROUTER="$ROOT/bin/delegation-route"
SCHEMA_COMPILER="$ROOT/bin/delegation-schema"
# Derived from $ROOT exactly like ROUTING_FILE, so the key and the gate can never
# disagree about where the install lives — a DELEGATION_DATA_HOME install used to
# store the key where the runner never looked. This reads, never writes, so no key
# is created inside a source checkout; running from one, point at the real key
# with DELEGATION_GLM_KEY_FILE.
KEY_FILE="${DELEGATION_GLM_KEY_FILE:-$ROOT/config/zai.env}"
CLAUDE_BIN_OVERRIDE="${DELEGATION_GLM_CLAUDE_BIN:-}"
CAPABILITY_TIMEOUT_SECONDS="${DELEGATION_GLM_CAPABILITY_TIMEOUT_SECONDS:-10}"
MODEL=""
PROFILE_PREFIX=""
CLAUDE_BIN=""
RUN_TMP=""
RUN_OUTPUT_TMP=""
RUN_METRICS_TMP=""
EVALUATION_MANIFEST_SHA256=""
EVALUATION_PROMPT_SHA256=""
EVALUATION_RUNNER_SOURCE_COMMIT=""
EVALUATION_RUNNER_SHA256=""
EVALUATION_WORKDIR_COMMIT=""
EVALUATION_TASK_COUNT=0
EVALUATION_TIMEOUT_SECONDS=""
EVALUATION_MAX_OUTPUT_CHARS=""
EVALUATION_MAX_COST_USD=""
EVALUATION_OUTPUT_SCHEMA_JSON=""
EVALUATION_GIT_DIR=""

cleanup_run() {
  [ -z "$RUN_OUTPUT_TMP" ] || rm -f -- "$RUN_OUTPUT_TMP"
  [ -z "$RUN_METRICS_TMP" ] || rm -f -- "$RUN_METRICS_TMP"
  [ -z "$RUN_TMP" ] || rm -rf -- "$RUN_TMP"
}

normalized_destination() {
  local path="$1" parent name
  parent="$(cd "$(dirname "$path")" && pwd -P)" || return 1
  name="$(basename "$path")"
  printf '%s/%s' "$parent" "$name"
}

usage() {
  cat <<'EOF'
Usage:
  delegation-glm check [--json]
  delegation-glm run --lane <clerk|scout|builder|reviewer|policy-annotation> \
    [--effort <auto|max>] [--backend <auto|claude-zai>] \
    --prompt-file <path> --output <path> --workdir <path> \
    [--metrics <path>] [--max-cost-usd <amount>] [--debug-dir <path>] \
    [--allow-provisional] [--evaluation --evaluation-manifest <path>]

Exit codes: 64 invalid input, 69 unavailable, 70 dispatch failure,
75 temporary/rate-limit failure, 78 lane not qualified. A 75 with reason
`rate_limited` is worth a backed-off retry; reason `quota_exhausted` is not
until the epoch in the diagnostic's `next_flush_time` has passed.

Failures write a sanitized diagnostic to <output>.error.json. --debug-dir
additionally preserves the raw event stream and stderr in a private subdirectory.
Lane-qualification evaluation accepts only a hash-allowlisted manifest for the
exact model/claude-zai/effort tuple selected by the executable gate and never
changes a routing gate itself.
EOF
}

die() { local code="$1"; shift; printf 'delegation-glm: %s\n' "$*" >&2; exit "$code"; }
have() { command -v "$1" >/dev/null 2>&1; }

load_gate_identity() {
  have jq || die 69 "jq is required"
  [ -r "$ROUTING_FILE" ] || die 78 "cannot read executable GLM gate $ROUTING_FILE"
  MODEL="$(jq -r '.model // empty' "$ROUTING_FILE" 2>/dev/null)"
  PROFILE_PREFIX="$(jq -r '.profile_prefix // empty' "$ROUTING_FILE" 2>/dev/null)"
  [ "$MODEL" = "glm-5.3-flash" ] \
    || die 78 "executable GLM gate must select glm-5.3-flash"
  [[ "$PROFILE_PREFIX" =~ ^[a-z0-9-]+$ ]] \
    || die 78 "executable GLM gate has an invalid profile prefix"
}

resolve_claude_bin() {
  local candidate="${CLAUDE_BIN_OVERRIDE:-}"
  if [ -z "$candidate" ]; then
    candidate="$(command -v claude 2>/dev/null || true)"
  fi
  [ -n "$candidate" ] && [ -x "$candidate" ] \
    || { CLAUDE_ZAI_REASON="claude not on PATH and no executable DELEGATION_GLM_CLAUDE_BIN was provided"; return 1; }
  candidate="$(cd "$(dirname "$candidate")" && pwd -P)/$(basename "$candidate")"
  while [ -L "$candidate" ]; do
    local target
    target="$(readlink "$candidate")" || return 1
    case "$target" in
      /*) candidate="$target" ;;
      *) candidate="$(cd "$(dirname "$candidate")" && cd "$(dirname "$target")" && pwd -P)/$(basename "$target")" ;;
    esac
  done
  [ -x "$candidate" ] || { CLAUDE_ZAI_REASON="resolved Claude Code binary is not executable"; return 1; }
  CLAUDE_BIN="$candidate"
}

sha256_file() {
  if have shasum; then shasum -a 256 "$1" | awk '{print $1}'
  elif have sha256sum; then sha256sum "$1" | awk '{print $1}'
  else return 1; fi
}

normalized_mode() {
  local raw
  if raw="$(stat -f '%Lp' "$1" 2>/dev/null)"; then :
  elif raw="$(stat -c '%a' "$1" 2>/dev/null)"; then :
  else return 1; fi
  printf '%04o' "$((8#$raw & 07777))"
}

# Hash every tracked, untracked, and ignored path in a fixture worktree. Git's
# binary diff is useful evidence for tracked changes, but it deliberately omits
# untracked and ignored files. The NUL-delimited inventory makes those bytes
# part of the canonical evaluation receipt without relying on path quoting.
worktree_snapshot_sha256() {
  local workdir="$1" inventory="$2" paths path digest target mode
  paths="$inventory.paths"
  {
    git -C "$workdir" ls-files -z
    git -C "$workdir" ls-files -z --others --exclude-standard
    git -C "$workdir" ls-files -z --others --ignored --exclude-standard
  } | LC_ALL=C sort -zu >"$paths" || return 1
  : >"$inventory"
  while IFS= read -r -d '' path; do
    if [ -L "$workdir/$path" ]; then
      target="$(readlink "$workdir/$path")" || return 1
      mode="$(normalized_mode "$workdir/$path")" || return 1
      printf 'symlink\0%s\0%s\0%s\0' "$path" "$mode" "$target" >>"$inventory"
    elif [ -f "$workdir/$path" ]; then
      digest="$(sha256_file "$workdir/$path")" || return 1
      mode="$(normalized_mode "$workdir/$path")" || return 1
      printf 'file\0%s\0%s\0%s\0' "$path" "$mode" "$digest" >>"$inventory"
    elif [ -d "$workdir/$path" ]; then
      mode="$(normalized_mode "$workdir/$path")" || return 1
      printf 'directory\0%s\0%s\0\0' "$path" "$mode" >>"$inventory"
    else
      printf 'missing\0%s\0\0\0' "$path" >>"$inventory"
    fi
  done <"$paths"
  rm -f -- "$paths"
  sha256_file "$inventory"
}

directory_snapshot_sha256() {
  local root="$1" inventory="$2" paths path digest target mode
  paths="$inventory.paths"
  (
    cd "$root"
    find . -mindepth 1 \( -type f -o -type l -o -type d \) -print0 | LC_ALL=C sort -zu
  ) >"$paths" || return 1
  : >"$inventory"
  while IFS= read -r -d '' path; do
    path="${path#./}"
    if [ -L "$root/$path" ]; then
      target="$(readlink "$root/$path")" || return 1
      mode="$(normalized_mode "$root/$path")" || return 1
      printf 'symlink\0%s\0%s\0%s\0' "$path" "$mode" "$target" >>"$inventory"
    elif [ -f "$root/$path" ]; then
      digest="$(sha256_file "$root/$path")" || return 1
      mode="$(normalized_mode "$root/$path")" || return 1
      printf 'file\0%s\0%s\0%s\0' "$path" "$mode" "$digest" >>"$inventory"
    elif [ -d "$root/$path" ]; then
      mode="$(normalized_mode "$root/$path")" || return 1
      printf 'directory\0%s\0%s\0\0' "$path" "$mode" >>"$inventory"
    fi
  done <"$paths"
  rm -f -- "$paths"
  sha256_file "$inventory"
}

evaluation_manifest() {
  local manifest="$1" prompt_file="$2" effort="$3" lane="$4" workdir="$5"
  local manifest_hash prompt_hash source_head contract schema runner_hash manifest_schema
  local expected_permission expected_workdir_mode workdir_head git_dir
  [ -f "$manifest" ] && [ ! -L "$manifest" ] || die 78 "evaluation manifest is missing or symlinked"
  manifest_hash="$(sha256_file "$manifest")" || die 69 "sha256 tool is required for evaluation"
  prompt_hash="$(sha256_file "$prompt_file")" || die 69 "sha256 tool is required for evaluation"
  source_head="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null)" || die 78 "runner source checkout is unavailable"
  workdir_head=""
  contract="$(jq -r '.contract_path // empty' "$manifest" 2>/dev/null)"; schema="$(jq -r '.output_schema_path // empty' "$manifest" 2>/dev/null)"
  case "$contract" in /*|*..*) die 78 "evaluation contract_path must be root-relative";; esac; case "$schema" in /*|*..*) die 78 "evaluation output_schema_path must be root-relative";; esac
  contract="$ROOT/$contract"; schema="$ROOT/$schema"; runner_hash="$(sha256_file "$SOURCE")" || die 69 "sha256 tool is required for evaluation"
  [ -n "$contract" ] && [ -n "$schema" ] || die 78 "evaluation manifest requires contract_path and output_schema_path"
  [ -f "$contract" ] && [ ! -L "$contract" ] && [ -f "$schema" ] && [ ! -L "$schema" ] || die 78 "evaluation contract or schema is missing or symlinked"
  git -C "$ROOT" diff --quiet && git -C "$ROOT" diff --cached --quiet && [ -z "$(git -C "$ROOT" ls-files --others --exclude-standard)" ] || die 78 "runner source checkout is dirty"
  manifest_schema="$(jq -r '.schema // empty' "$manifest" 2>/dev/null)"
  if [ "$manifest_schema" = delegation_policy_annotation_evaluation_v1 ]; then
    [ "$lane" = policy-annotation ] || die 78 "policy-annotation manifest cannot evaluate another lane"
    jq -e --arg prompt_sha256 "$prompt_hash" --arg contract_sha256 "$(sha256_file "$contract")" --arg schema_sha256 "$(sha256_file "$schema")" --arg runner_sha256 "$runner_hash" --arg effort "$effort" --arg model "$MODEL" --arg profile "$PROFILE_PREFIX-policy-annotation" '
      (keys | sort) == ["backend","contract_path","contract_sha256","effort","lane","max_output_chars","model","output_schema_path","output_schema_sha256","profile","prompt_sha256","runner_sha256","runner_source_commit","schema","timeout_seconds"] and
      .schema == "delegation_policy_annotation_evaluation_v1" and .profile == $profile and .lane == "policy-annotation" and .model == $model and .backend == "claude-zai" and .effort == $effort and .prompt_sha256 == $prompt_sha256 and .contract_sha256 == $contract_sha256 and .output_schema_sha256 == $schema_sha256 and
      .runner_sha256 == $runner_sha256 and ([.prompt_sha256,.contract_sha256,.output_schema_sha256,.runner_sha256] | all(test("^[0-9a-f]{64}$"))) and (.runner_source_commit | test("^[0-9a-f]{40}$")) and
      (.timeout_seconds | type == "number" and floor == . and . >= 1 and . <= 600) and (.max_output_chars | type == "number" and floor == . and . >= 1 and . <= 65536)
    ' "$manifest" >/dev/null 2>&1 || die 78 "evaluation manifest is malformed or does not bind this exact run"
    git -C "$ROOT" merge-base --is-ancestor "$(jq -r '.runner_source_commit' "$manifest")" "$source_head" || die 78 "evaluation manifest source commit is not an ancestor of this runner"
    EVALUATION_MAX_COST_USD="2.00"
    EVALUATION_TASK_COUNT=20
  elif [ "$manifest_schema" = delegation_glm_lane_evaluation_v1 ]; then
    case "$lane" in clerk|scout|builder) ;; *) die 78 "GLM lane evaluation supports clerk, scout, or builder only" ;; esac
    workdir_head="$(git -C "$workdir" rev-parse HEAD 2>/dev/null)" || die 78 "evaluation workdir must be a git checkout"
    git_dir="$(git -C "$workdir" rev-parse --absolute-git-dir 2>/dev/null)" \
      || die 78 "evaluation workdir has no resolvable git directory"
    git_dir="$(cd "$git_dir" && pwd -P)"
    [ "$git_dir" = "$workdir/.git" ] \
      || die 78 "evaluation workdir must use an in-tree .git directory"
    git -C "$workdir" diff --quiet && git -C "$workdir" diff --cached --quiet &&
      [ -z "$(git -C "$workdir" ls-files --others --exclude-standard)" ] &&
      [ -z "$(git -C "$workdir" ls-files --others --ignored --exclude-standard)" ] \
      || die 78 "evaluation workdir is dirty, including ignored paths"
    expected_permission=plan; expected_workdir_mode=read-only
    if [ "$lane" = builder ]; then expected_permission=acceptEdits; expected_workdir_mode=writable-fixture; fi
    jq -e --arg prompt_sha256 "$prompt_hash" --arg contract_sha256 "$(sha256_file "$contract")" --arg schema_sha256 "$(sha256_file "$schema")" --arg runner_sha256 "$runner_hash" --arg source_head "$source_head" --arg workdir_head "$workdir_head" --arg effort "$effort" --arg lane "$lane" --arg permission "$expected_permission" --arg workdir_mode "$expected_workdir_mode" --arg model "$MODEL" --arg profile "$PROFILE_PREFIX-$lane" '
      (keys | sort) == ["backend","contract_path","contract_sha256","effort","lane","max_cost_usd","max_output_chars","model","output_schema_path","output_schema_sha256","permission_mode","profile","prompt_sha256","runner_sha256","runner_source_commit","schema","task_count","timeout_seconds","workdir_commit","workdir_mode"] and
      .schema == "delegation_glm_lane_evaluation_v1" and .profile == $profile and .lane == $lane and .model == $model and .backend == "claude-zai" and .effort == $effort and
      .permission_mode == $permission and .workdir_mode == $workdir_mode and .workdir_commit == $workdir_head and .runner_source_commit == $source_head and
      .prompt_sha256 == $prompt_sha256 and .contract_sha256 == $contract_sha256 and .output_schema_sha256 == $schema_sha256 and .runner_sha256 == $runner_sha256 and
      ([.prompt_sha256,.contract_sha256,.output_schema_sha256,.runner_sha256] | all(test("^[0-9a-f]{64}$"))) and
      ([.runner_source_commit,.workdir_commit] | all(test("^[0-9a-f]{40}$"))) and
      (.task_count | type == "number" and floor == . and . >= 1 and . <= 100) and
      (.timeout_seconds | type == "number" and floor == . and . >= 1 and . <= 900) and
      (.max_output_chars | type == "number" and floor == . and . >= 1 and . <= 65536) and
      (.max_cost_usd | type == "number" and . >= 0.01 and . <= 25)
    ' "$manifest" >/dev/null 2>&1 || die 78 "evaluation manifest is malformed or does not bind this exact run"
    EVALUATION_MAX_COST_USD="$(jq -r '.max_cost_usd' "$manifest")"
    EVALUATION_TASK_COUNT="$(jq -r '.task_count' "$manifest")"
    if [ ! -x "$SCHEMA_COMPILER" ] || ! have python3; then
      die 69 "delegation-schema and python3 are required for structured evaluation output"
    fi
    # The manifest binds the normative schema. Compile only the provider transport
    # representation in memory; never rewrite or silently replace the bound file.
    if ! EVALUATION_OUTPUT_SCHEMA_JSON="$(
      "$SCHEMA_COMPILER" compile --provider claude --schema "$schema"
    )"; then
      die 78 "evaluation output schema is incompatible with Claude transport"
    fi
    EVALUATION_GIT_DIR="$git_dir"
  else
    die 78 "unsupported evaluation manifest schema"
  fi
  jq -e --arg hash "$manifest_hash" --arg lane "$lane" --arg profile "$PROFILE_PREFIX-$lane" '.profiles[$profile].lanes[$lane].evaluation_manifest_sha256 | type == "array" and index($hash) != null' "$CENTRAL_GATES" >/dev/null 2>&1 || die 78 "evaluation manifest is not allowlisted by the central gate"
  jq -e --arg hash "$manifest_hash" --arg lane "$lane" '.lanes[$lane].backends["claude-zai"].evaluation_manifest_sha256 | type == "array" and index($hash) != null' "$ROUTING_FILE" >/dev/null 2>&1 || die 78 "evaluation manifest is not allowlisted by the executable gate"
  EVALUATION_MANIFEST_SHA256="$manifest_hash"
  EVALUATION_PROMPT_SHA256="$prompt_hash"
  EVALUATION_RUNNER_SOURCE_COMMIT="$(jq -r '.runner_source_commit' "$manifest")"
  EVALUATION_RUNNER_SHA256="$runner_hash"
  EVALUATION_WORKDIR_COMMIT="$workdir_head"
  EVALUATION_TIMEOUT_SECONDS="$(jq -r '.timeout_seconds' "$manifest")"
  EVALUATION_MAX_OUTPUT_CHARS="$(jq -r '.max_output_chars' "$manifest")"
}

host_status() {
  HOST_REASON=""
  if [ -n "$CLAUDE_BIN_OVERRIDE" ] || have claude || have codex; then HOST_REASON="ready"; return 0; fi
  HOST_REASON="neither Claude Code nor Codex is installed"
  return 1
}

# Each branch assigns on its own: `$(a || b)` would concatenate the stdout of
# every branch it ran, and GNU's `-f` means --file-system, printing a block and
# still failing. An undeterminable mode is not treated as a refusal — that would
# brick the lane on a platform whose stat we cannot read.
key_file_mode() {
  local mode
  if mode="$(stat -c '%a' "$KEY_FILE" 2>/dev/null)"; then printf '%s' "$mode"; return 0; fi
  if mode="$(stat -f '%Lp' "$KEY_FILE" 2>/dev/null)"; then printf '%s' "$mode"; return 0; fi
  printf ''
}

# An explicit ZAI_API_KEY in the environment always wins. Otherwise fall back to
# the key install.sh stored. Parsed, never sourced: the file holds a credential,
# not code to execute. A refusal sets ZAI_KEY_PROBLEM so the caller can report
# the real cause instead of "holds no key".
load_zai_key() {
  ZAI_KEY_PROBLEM=""
  [ -z "${ZAI_API_KEY:-}" ] || return 0
  [ -f "$KEY_FILE" ] || return 0
  local perms raw
  perms="$(key_file_mode)"
  case "$perms" in
    ""|?00) ;;
    *) ZAI_KEY_PROBLEM="key file $KEY_FILE is mode $perms; run: chmod 600 $KEY_FILE"; return 0 ;;
  esac
  # Tolerate the .env shapes the filename invites: an `export` prefix, quotes,
  # surrounding blanks, CRLF. A quoted value loaded raw would authenticate as
  # `"key"` and 401 at dispatch.
  raw="$(sed -n 's/^[[:space:]]*\(export[[:space:]][[:space:]]*\)\{0,1\}ZAI_API_KEY=//p' \
    "$KEY_FILE" 2>/dev/null | head -1)"
  raw="${raw%$'\r'}"
  raw="${raw#"${raw%%[![:space:]]*}"}"
  raw="${raw%"${raw##*[![:space:]]}"}"
  case "$raw" in
    \"*\") raw="${raw#\"}"; raw="${raw%\"}" ;;
    \'*\') raw="${raw#\'}"; raw="${raw%\'}" ;;
  esac
  if [ -n "$raw" ]; then ZAI_API_KEY="$raw"; else ZAI_KEY_PROBLEM="key file $KEY_FILE holds no ZAI_API_KEY line"; fi
}

claude_zai_status() {
  CLAUDE_ZAI_REASON=""
  resolve_claude_bin || return 1
  local help timeout_bin rc=0
  if ! [[ "$CAPABILITY_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] \
      || [ "$CAPABILITY_TIMEOUT_SECONDS" -lt 1 ] \
      || [ "$CAPABILITY_TIMEOUT_SECONDS" -gt 30 ]; then
    CLAUDE_ZAI_REASON="DELEGATION_GLM_CAPABILITY_TIMEOUT_SECONDS must be an integer from 1 to 30"
    return 1
  fi
  if have gtimeout; then timeout_bin="$(command -v gtimeout)"
  elif have timeout; then timeout_bin="$(command -v timeout)"
  else CLAUDE_ZAI_REASON="gtimeout or timeout is required for the Claude Code capability probe"; return 1
  fi
  help="$("$timeout_bin" "$CAPABILITY_TIMEOUT_SECONDS" "$CLAUDE_BIN" --help 2>&1)" || rc=$?
  if [ "$rc" -eq 124 ]; then
    CLAUDE_ZAI_REASON="Claude Code capability probe timed out"
    return 1
  fi
  [ "$rc" -eq 0 ] || { CLAUDE_ZAI_REASON="Claude Code capability probe failed"; return 1; }
  grep -q -- '--effort' <<<"$help" \
    || { CLAUDE_ZAI_REASON="claude lacks --effort"; return 1; }
  load_zai_key
  if [ -z "${ZAI_API_KEY:-}" ]; then
    CLAUDE_ZAI_REASON="${ZAI_KEY_PROBLEM:-ZAI_API_KEY is unset and $KEY_FILE holds no key}"
    return 1
  fi
  CLAUDE_ZAI_REASON="ready"
  return 0
}

qualified_lanes() {
  if [ -f "$CENTRAL_GATES" ] && have jq; then
    jq -c --arg prefix "$PROFILE_PREFIX" '[.profiles | to_entries[] | select(.key | startswith($prefix + "-")) |
      .value.lanes | to_entries[] | select(.value.status == "qualified") | .key] | unique | sort' "$CENTRAL_GATES" 2>/dev/null || printf '[]'
  else
    printf '[]'
  fi
}

provisional_lanes() {
  if [ -f "$CENTRAL_GATES" ] && have jq; then
    jq -c --arg prefix "$PROFILE_PREFIX" '[.profiles | to_entries[] | select(.key | startswith($prefix + "-")) |
      .value.lanes | to_entries[] | select(.value.status == "provisional") | .key] | unique | sort' "$CENTRAL_GATES" 2>/dev/null || printf '[]'
  else
    printf '[]'
  fi
}

# Read from the gate, never a constant: check must advertise the efforts the
# runner will actually accept, or a caller follows the advertised set straight
# into a 78 and reads it as "this lane failed evaluation".
gate_efforts() {
  if [ -f "$CENTRAL_GATES" ] && have jq; then
    jq -c --arg prefix "$PROFILE_PREFIX" '[.profiles | to_entries[] | select(.key | startswith($prefix + "-")) | .value as $p |
      $p.lanes[] | select(.status == "qualified" or .status == "provisional") | $p.effort] | unique' "$CENTRAL_GATES" 2>/dev/null || printf '[]'
  else
    printf '[]'
  fi
}

default_effort() {
  local lane="$1" backend="$2"
  [ "$backend" = claude-zai ] || return 1
  jq -r --arg profile "$PROFILE_PREFIX-$lane" '.profiles[$profile].effort // empty' "$CENTRAL_GATES" 2>/dev/null
}

gate_status() {
  local lane="$1" backend="$2"
  [ "$backend" = claude-zai ] || { printf 'disabled\n'; return; }
  jq -r --arg profile "$PROFILE_PREFIX-$lane" '.profiles[$profile].lanes[]?.status // "disabled"' \
    "$CENTRAL_GATES" 2>/dev/null || printf 'disabled\n'
}

is_allowed() {
  local lane="$1" backend="$2" allow_provisional="$3" status
  status="$(gate_status "$lane" "$backend")"
  [ "$status" = qualified ] || { [ "$status" = provisional ] && [ "$allow_provisional" = 1 ]; }
}

qualified_effort() {
  local lane="$1" backend="$2"
  default_effort "$lane" "$backend"
}

validate_gate_graph() {
  [ -x "$ROUTER" ] || return 1
  DELEGATION_ROUTING_GATES_FILE="$CENTRAL_GATES" \
    DELEGATION_GLM_ROUTING_FILE="$ROUTING_FILE" \
    "$ROUTER" check --json >/dev/null 2>&1
}

print_check() {
  local as_json="${1:-0}" host_ok=false claude_ok=false
  have jq || die 69 "jq is required"
  validate_gate_graph || die 78 "central and executable routing gates are missing, invalid, or inconsistent"
  host_status && host_ok=true || true
  claude_zai_status && claude_ok=true || true
  local lanes provisional efforts selected="none"
  lanes="$(qualified_lanes)"
  provisional="$(provisional_lanes)"
  efforts="$(gate_efforts)"
  if [ "$host_ok" = true ] && [ "$claude_ok" = true ]; then selected="claude-zai"; fi
  if [ "$as_json" = 1 ]; then
    jq -n \
      --arg model "$MODEL" --arg selected "$selected" \
      --argjson efforts "$efforts" --argjson lanes "$lanes" --argjson provisional "$provisional" \
      --argjson host "$host_ok" --arg host_reason "$HOST_REASON" \
      --argjson host_claude "$(have claude && printf true || printf false)" \
      --argjson host_codex "$(have codex && printf true || printf false)" \
      --argjson claude "$claude_ok" --arg claude_reason "$CLAUDE_ZAI_REASON" \
      '{model:$model, efforts:$efforts, selected_backend:$selected,
        host:{available:$host,reason:$host_reason,claude:$host_claude,codex:$host_codex},
        qualified_lanes:$lanes,provisional_lanes:$provisional,backends:{
          "claude-zai":{available:$claude,reason:$claude_reason}}}'
  else
    printf '%s: selected=%s efforts=%s qualified=%s provisional=%s\n' "$MODEL" "$selected" "$efforts" "$lanes" "$provisional"
    printf '  host: %s (%s)\n' "$host_ok" "$HOST_REASON"
    printf '  claude-zai: %s (%s)\n' "$claude_ok" "$CLAUDE_ZAI_REASON"
  fi
}

EXTRACT_REASON=""
RESULT_SUBTYPE=""
OBSERVED_MODELS_JSON="[]"
NEXT_FLUSH_TIME=""

extract_claude() {
  local events="$1" output="$2" metrics="$3" started="$4" backend="$5" effort="$6" lane="$7"
  EXTRACT_REASON=""
  RESULT_SUBTYPE=""
  OBSERVED_MODELS_JSON="[]"

  if ! jq -se 'type == "array" and all(.[]; type == "object")' \
      "$events" >/dev/null 2>&1; then
    EXTRACT_REASON="invalid_stream"
    return 1
  fi
  OBSERVED_MODELS_JSON="$(jq -sc --arg model "$MODEL" '
    [.[] | select(.type == "system" and .subtype == "init") |
      if .model == $model then $model else "<unexpected>" end] | unique
  ' "$events")"
  if ! jq -se 'any(.[]; .type == "system" and .subtype == "init")' \
      "$events" >/dev/null; then
    EXTRACT_REASON="missing_init"
    return 1
  fi
  if ! jq -se --arg model "$MODEL" '
      all(.[]; .type != "system" or .subtype != "init" or .model == $model)
    ' "$events" >/dev/null; then
    EXTRACT_REASON="model_mismatch"
    return 1
  fi
  if ! jq -se 'any(.[]; .type == "result")' "$events" >/dev/null; then
    EXTRACT_REASON="missing_result"
    return 1
  fi
  RESULT_SUBTYPE="$(jq -rs '
    [.[] | select(.type == "result") | .subtype |
      if . == "success" or . == "error_during_execution" or
          . == "error_max_turns" or . == "error_max_budget_usd"
      then . else "<unexpected>" end] | last // ""
  ' "$events")"
  if jq -se '
      ([.[] | select(.type == "result")] | last // {}) as $r |
      ($r.is_error == true) or
      (($r.subtype | type) == "string" and ($r.subtype | startswith("error")))
    ' "$events" >/dev/null; then
    EXTRACT_REASON="result_error"
    return 1
  fi
  if ! jq -se --arg structured "$EVALUATION_OUTPUT_SCHEMA_JSON" '
      ([.[] | select(.type == "result")] | last // {}) as $r |
      $r.subtype == "success" and
      (($structured != "" and ($r.structured_output | type) == "object") or
       (($r.result | type) == "string"))
    ' "$events" >/dev/null; then
    EXTRACT_REASON="invalid_stream"
    return 1
  fi
  jq -rcs --arg structured "$EVALUATION_OUTPUT_SCHEMA_JSON" '
    ([.[] | select(.type == "result")] | last // {}) as $r |
    if $structured != "" and ($r.structured_output | type) == "object"
    then $r.structured_output
    else ($r.result | select(type == "string" and length > 0))
    end
  ' "$events" >"$output" || {
    EXTRACT_REASON="invalid_stream"
    return 1
  }
  if [ ! -s "$output" ]; then
    EXTRACT_REASON="empty_result"
    return 1
  fi
  jq -s --arg model "$MODEL" --arg backend "$backend" --arg effort "$effort" \
    --arg lane "$lane" --argjson started "$started" '
    ([.[] | select(.type == "result")] | last // {}) as $r |
    ($r.usage // {}) as $u |
    {model:$model,backend:$backend,effort:$effort,lane:$lane,
     started_at_epoch:$started,finished_at_epoch:now,
     tokens:{input:($u.input_tokens // 0),output:($u.output_tokens // 0),
             reasoning:($u.reasoning_tokens // 0),
             cache_read:($u.cache_read_input_tokens // 0),
             cache_write:($u.cache_creation_input_tokens // 0)},
     provider_cost_usd:($r.total_cost_usd // 0)}' "$events" >"$metrics" || {
    EXTRACT_REASON="invalid_stream"
    return 1
  }
}

preserve_debug_artifacts() {
  local debug_parent="$1" events="$2" stderr_file="$3"
  DEBUG_RUN_DIR=""
  [ -n "$debug_parent" ] || return 0
  DEBUG_RUN_DIR="$(mktemp -d "$debug_parent/delegation-glm.XXXXXX")" || return 1
  chmod 700 "$DEBUG_RUN_DIR"
  cp "$events" "$DEBUG_RUN_DIR/events.jsonl"
  cp "$stderr_file" "$DEBUG_RUN_DIR/stderr.txt"
  chmod 600 "$DEBUG_RUN_DIR/events.jsonl" "$DEBUG_RUN_DIR/stderr.txt"
}

write_failure_diagnostic() {
  local diagnostic="$1" events="$2" stderr_file="$3" started="$4"
  local backend="$5" effort="$6" lane="$7" phase="$8" reason="$9"
  local cli_exit="${10}" debug_path="${11}"
  local stream_valid=false event_bytes=0 stderr_bytes=0 counts="{}"
  local observed_models="$OBSERVED_MODELS_JSON" result_subtype="$RESULT_SUBTYPE"
  local diagnostic_parent diagnostic_name diagnostic_tmp finished

  [ -f "$events" ] && event_bytes="$(wc -c <"$events" | tr -d ' ')"
  [ -f "$stderr_file" ] && stderr_bytes="$(wc -c <"$stderr_file" | tr -d ' ')"
  if jq -se 'type == "array" and all(.[]; type == "object")' \
      "$events" >/dev/null 2>&1; then
    stream_valid=true
    counts="$(jq -sc '
      map((.type // "unknown") as $type |
        if ["system","assistant","user","result","rate_limit_event"] |
            index($type)
        then $type else "unknown" end) |
      group_by(.) | map({key:.[0],value:length}) | from_entries
    ' "$events")"
    [ "$observed_models" != "[]" ] || observed_models="$(jq -sc --arg model "$MODEL" '
      [.[] | select(.type == "system" and .subtype == "init") |
        if .model == $model then $model else "<unexpected>" end] | unique
    ' "$events")"
    [ -n "$result_subtype" ] || result_subtype="$(jq -rs '
      [.[] | select(.type == "result") | .subtype |
        if . == "success" or . == "error_during_execution" or
            . == "error_max_turns" or . == "error_max_budget_usd"
        then . else "<unexpected>" end] | last // ""
    ' "$events")"
  fi
  finished="$(date +%s)"
  diagnostic_parent="$(dirname "$diagnostic")"
  diagnostic_name="$(basename "$diagnostic")"
  diagnostic_tmp="$(mktemp "$diagnostic_parent/.$diagnostic_name.XXXXXX")"
  jq -n \
    --arg model "$MODEL" --arg backend "$backend" --arg effort "$effort" \
    --arg lane "$lane" --arg phase "$phase" --arg reason "$reason" \
    --arg result_subtype "$result_subtype" --arg debug_dir "$debug_path" \
    --argjson cli_exit "$cli_exit" --argjson stream_valid "$stream_valid" \
    --argjson event_bytes "$event_bytes" --argjson stderr_bytes "$stderr_bytes" \
    --argjson event_counts "$counts" --argjson observed_models "$observed_models" \
    --argjson next_flush_time "${NEXT_FLUSH_TIME:-null}" \
    --argjson elapsed_seconds "$((finished - started))" '
    {schema_version:2,model:$model,backend:$backend,effort:$effort,lane:$lane,
     phase:$phase,reason:$reason,cli_exit_code:$cli_exit,
     result_subtype:(if $result_subtype == "" then null else $result_subtype end),
     observed_models:$observed_models,
     event_stream:{valid:$stream_valid,bytes:$event_bytes,counts:$event_counts},
     stderr_bytes:$stderr_bytes,elapsed_seconds:$elapsed_seconds,
     next_flush_time:$next_flush_time,
     debug_dir:(if $debug_dir == "" then null else $debug_dir end)}
  ' >"$diagnostic_tmp"
  chmod 600 "$diagnostic_tmp"
  mv "$diagnostic_tmp" "$diagnostic"
}

run_command() {
  local lane="" effort="auto" backend="auto" prompt_file="" output="" workdir="" metrics="" diagnostic=""
  local debug_dir="" max_cost="2.00" evaluation=0 evaluation_manifest_path="" allow_provisional=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --lane) lane="${2:-}"; shift 2 ;;
      --effort) effort="${2:-}"; shift 2 ;;
      --backend) backend="${2:-}"; shift 2 ;;
      --prompt-file) prompt_file="${2:-}"; shift 2 ;;
      --output) output="${2:-}"; shift 2 ;;
      --workdir) workdir="${2:-}"; shift 2 ;;
      --metrics) metrics="${2:-}"; shift 2 ;;
      --max-cost-usd) max_cost="${2:-}"; shift 2 ;;
      --debug-dir) debug_dir="${2:-}"; shift 2 ;;
      --allow-provisional) allow_provisional=1; shift ;;
      --evaluation) evaluation=1; shift ;;
      --evaluation-manifest) evaluation_manifest_path="${2:-}"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die 64 "unknown run argument: $1" ;;
    esac
  done
  case "$lane" in clerk|scout|builder|reviewer|policy-annotation) ;; *) die 64 "invalid lane: $lane" ;; esac
  case "$effort" in auto|max) ;; *) die 64 "invalid effort: $effort (only max is supported)" ;; esac
  case "$backend" in auto|claude-zai) ;; *) die 64 "invalid backend: $backend" ;; esac
  [ -f "$prompt_file" ] || die 64 "prompt file missing: $prompt_file"
  if [ "$evaluation" = 1 ]; then
    [ -n "$evaluation_manifest_path" ] || die 64 "--evaluation requires --evaluation-manifest"
    [ "$allow_provisional" = 0 ] || die 64 "--evaluation cannot be combined with --allow-provisional"
  else
    [ -z "$evaluation_manifest_path" ] || die 64 "--evaluation-manifest requires --evaluation"
  fi
  [ -d "$workdir" ] || die 64 "workdir missing: $workdir"
  [ -n "$output" ] || die 64 "--output is required"
  if [ -n "$debug_dir" ]; then
    [ -d "$debug_dir" ] || die 64 "debug directory missing: $debug_dir"
    [ ! -L "$debug_dir" ] || die 64 "debug directory must not be a symlink: $debug_dir"
    debug_dir="$(cd "$debug_dir" && pwd -P)"
  fi
  have jq || die 69 "jq is required"
  validate_gate_graph || die 78 "central and executable routing gates are missing, invalid, or inconsistent"
  metrics="${metrics:-$output.metrics.json}"
  diagnostic="$output.error.json"
  mkdir -p "$(dirname "$output")" "$(dirname "$metrics")" "$(dirname "$diagnostic")"
  [ ! -d "$output" ] || die 64 "output path is a directory: $output"
  [ ! -d "$metrics" ] || die 64 "metrics path is a directory: $metrics"
  [ ! -d "$diagnostic" ] || die 64 "diagnostic path is a directory: $diagnostic"
  local normalized_output normalized_metrics normalized_diagnostic
  normalized_output="$(normalized_destination "$output")"
  normalized_metrics="$(normalized_destination "$metrics")"
  normalized_diagnostic="$(normalized_destination "$diagnostic")"
  [ "$normalized_output" != "$normalized_metrics" ] \
    || die 64 "output and metrics paths must be distinct"
  [ "$normalized_metrics" != "$normalized_diagnostic" ] \
    || die 64 "metrics path collides with reserved diagnostic path: $diagnostic"

  workdir="$(cd "$workdir" && pwd -P)"
  if [ "$evaluation" = 1 ]; then
    case "$normalized_output" in "$workdir"/*) die 64 "evaluation output must be outside workdir" ;; esac
    case "$normalized_metrics" in "$workdir"/*) die 64 "evaluation metrics must be outside workdir" ;; esac
    case "$normalized_diagnostic" in "$workdir"/*) die 64 "evaluation diagnostic must be outside workdir" ;; esac
    if [ -n "$debug_dir" ]; then case "$debug_dir" in "$workdir"|"$workdir"/*) die 64 "evaluation debug directory must be outside workdir" ;; esac; fi
  fi

  backend="claude-zai"
  # Qualification before availability: "never approved" (78) is a permanent fact
  # and must not hide behind "runtime is down" (69), which the caller reads as
  # retry-later. Checking availability first made the answer to a permanent
  # question depend on whether a key happened to be present.
  if [ "$evaluation" = 0 ] && ! is_allowed "$lane" "$backend" "$allow_provisional"; then
    status="$(gate_status "$lane" "$backend")"
    if [ "$status" != provisional ]; then
      die 78 "lane '$lane' backend '$backend' has non-dispatchable status '$status'"
    else
      die 78 "lane '$lane' backend '$backend' is provisional; pass --allow-provisional after an explicit routing decision"
    fi
  fi
  if [ "$evaluation" = 1 ]; then
    status="$(gate_status "$lane" "$backend")"
    case "$lane:$status" in
      policy-annotation:candidate|builder:candidate|clerk:candidate|scout:candidate|clerk:provisional|scout:provisional) ;;
      *) die 78 "lane '$lane' with status '$status' is not eligible for GLM qualification evaluation" ;;
    esac
  fi
  host_status || die 69 "$HOST_REASON"
  claude_zai_status || die 69 "$CLAUDE_ZAI_REASON"
  [ "$effort" != auto ] || effort="$(default_effort "$lane" "$backend")"
  # An explicit --effort must not reach past what the gate qualified; only an
  # --evaluation run, whose whole job is measuring a new combination, may.
  if [ "$evaluation" = 0 ]; then
    local expected_effort
    expected_effort="$(qualified_effort "$lane" "$backend")" \
      || die 69 "qualified lane '$lane' has no pinned effort for backend '$backend'"
    [ "$effort" = "$expected_effort" ] \
      || die 78 "lane '$lane' backend '$backend' is qualified only at effort '$expected_effort'"
  fi
  if [ "$evaluation" = 1 ]; then
    [ "$effort" = max ] || die 78 "GLM qualification evaluation supports only effort 'max'"
    evaluation_manifest "$evaluation_manifest_path" "$prompt_file" "$effort" "$lane" "$workdir"
    max_cost="$EVALUATION_MAX_COST_USD"
  fi

  local tmp events stderr_file rc=0 started workdir_tree_before_sha="" workdir_tree_after_sha=""
  local git_control_before_sha="" git_control_after_sha=""
  local output_parent output_name metrics_parent metrics_name
  local phase="" reason="" final_rc=0 cli_exit=null debug_warning=""
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/delegation-glm.XXXXXX")"
  tmp="$(cd "$tmp" && pwd -P)"
  RUN_TMP="$tmp"
  trap cleanup_run EXIT
  events="$tmp/events.jsonl"
  stderr_file="$tmp/stderr"
  : >"$events"
  : >"$stderr_file"
  output_parent="$(dirname "$output")"
  output_name="$(basename "$output")"
  metrics_parent="$(dirname "$metrics")"
  metrics_name="$(basename "$metrics")"
  RUN_OUTPUT_TMP="$(mktemp "$output_parent/.$output_name.XXXXXX")"
  RUN_METRICS_TMP="$(mktemp "$metrics_parent/.$metrics_name.XXXXXX")"
  if [ "$evaluation" = 1 ] && [ -n "$EVALUATION_WORKDIR_COMMIT" ]; then
    workdir_tree_before_sha="$(worktree_snapshot_sha256 "$workdir" "$tmp/workdir.before")" \
      || die 69 "could not attest the evaluation worktree before dispatch"
    git_control_before_sha="$(directory_snapshot_sha256 "$EVALUATION_GIT_DIR" "$tmp/git-control.before")" \
      || die 69 "could not attest evaluation git control state before dispatch"
  fi
  started="$(date +%s)"

  local permission="plan"
  local -a evaluation_tail=(--max-budget-usd "$max_cost")
  [ "$lane" != builder ] || permission="acceptEdits"
  if [ -n "$EVALUATION_OUTPUT_SCHEMA_JSON" ]; then
    evaluation_tail=(--json-schema "$EVALUATION_OUTPUT_SCHEMA_JSON" --max-budget-usd "$max_cost")
  fi
  mkdir -p "$tmp/claude-config" "$tmp/home"
  local timeout_bin='' sandbox_profile='' claude_bin='' git_dir=''
  if [ "$evaluation" = 1 ]; then
    [ "$(uname)" = Darwin ] && [ -x /usr/bin/sandbox-exec ] || die 69 "GLM evaluation requires macOS sandbox-exec"
    if have gtimeout; then timeout_bin="$(command -v gtimeout)"
    elif have timeout; then timeout_bin="$(command -v timeout)"
    else die 69 "GLM evaluation requires gtimeout or timeout"; fi
    claude_bin="$CLAUDE_BIN"
    if IFS= read -r shebang <"$claude_bin" 2>/dev/null && [[ "$shebang" == '#!'* ]]; then
      die 69 "GLM evaluation requires a native Claude Code executable, not a script launcher"
    fi
    git_dir="${EVALUATION_GIT_DIR:-$tmp/empty-git-control}"
    mkdir -p "$git_dir"
    sandbox_profile='(version 1)
      (allow default)
      (deny process-exec
        (require-all
          (require-not (literal (param "CLAUDE_BIN")))
          (require-not (literal "/usr/bin/true"))))
      (deny file-read-data
        (require-all
          (require-not (literal "/"))
          (require-not (subpath (param "SCRATCH")))
          (require-not (subpath (param "WORKDIR")))
          (require-not (literal (param "CLAUDE_BIN")))
          (require-not (subpath "/System"))
          (require-not (subpath "/usr/lib"))
          (require-not (subpath "/usr/share"))
          (require-not (subpath "/usr/bin"))
          (require-not (subpath "/bin"))
          (require-not (subpath "/dev"))
          (require-not (subpath "/private/etc"))
          (require-not (subpath "/private/var/db/timezone"))
          (require-not (subpath "/Library/Apple"))))'
    if [ "$lane" = builder ]; then
      sandbox_profile+=$'\n      (deny file-write* (require-all (require-not (subpath (param "SCRATCH"))) (require-not (subpath (param "WORKDIR")))))'
    else
      sandbox_profile+=$'\n      (deny file-write* (require-not (subpath (param "SCRATCH"))))'
    fi
    sandbox_profile+=$'\n      (deny file-write* (subpath (param "GIT_DIR")))'
  fi
  # Claude has no --cwd flag. Enter the delegated worktree explicitly so it
  # cannot inspect or edit the delegation-kit source checkout by accident.
  (
    cd "$workdir"
    if [ "$evaluation" = 1 ]; then
      env -i PATH="/usr/bin:/bin" LANG="${LANG:-C}" NO_COLOR=1 CI=1 \
        USER="${USER:-$(id -un)}" \
        FAKE_CLAUDE_CASE="${FAKE_CLAUDE_CASE:-}" \
        FAKE_FORBIDDEN_HOME="${FAKE_FORBIDDEN_HOME:-}" \
        FAKE_FORBIDDEN_SOURCE="${FAKE_FORBIDDEN_SOURCE:-}" \
        FAKE_FORBIDDEN_HOST="${FAKE_FORBIDDEN_HOST:-}" \
        ANTHROPIC_AUTH_TOKEN="$ZAI_API_KEY" \
        ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic" \
        ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL" \
        HOME="$tmp/home" TMPDIR="$tmp" BUN_TMPDIR="$tmp" \
        CLAUDE_TMPDIR="$tmp" CLAUDE_CODE_TMPDIR="$tmp" \
        CLAUDE_CONFIG_DIR="$tmp/claude-config" \
        CLAUDE_CODE_SIMPLE=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
        API_TIMEOUT_MS=3000000 \
        "$timeout_bin" "$EVALUATION_TIMEOUT_SECONDS" \
        /usr/bin/sandbox-exec -D "SCRATCH=$tmp" -D "WORKDIR=$workdir" \
        -D "GIT_DIR=$git_dir" -D "CLAUDE_BIN=$claude_bin" \
        -p "$sandbox_profile" "$claude_bin" -p "$(<"$prompt_file")" --model opus --effort "$effort" \
        --permission-mode "$permission" --setting-sources '' --strict-mcp-config \
        --output-format stream-json --verbose --no-session-persistence \
        "${evaluation_tail[@]}"
    else
      env -u ANTHROPIC_API_KEY -u CLAUDE_CODE_OAUTH_TOKEN -u ZAI_API_KEY \
        -u ANTHROPIC_MODEL -u ANTHROPIC_CUSTOM_HEADERS \
        -u CLAUDE_CODE_USE_BEDROCK -u CLAUDE_CODE_USE_VERTEX \
        -u CLAUDE_CODE_USE_FOUNDRY \
        ANTHROPIC_AUTH_TOKEN="$ZAI_API_KEY" \
        ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic" \
        ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL" \
        CLAUDE_CONFIG_DIR="$tmp/claude-config" \
        CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 API_TIMEOUT_MS=3000000 \
        "$CLAUDE_BIN" -p "$(<"$prompt_file")" --model opus --effort "$effort" \
        --permission-mode "$permission" --setting-sources '' --strict-mcp-config \
        --output-format stream-json --verbose --no-session-persistence \
        --max-budget-usd "$max_cost"
    fi
  ) >"$events" 2>"$stderr_file" || rc=$?
  if [ "$rc" -eq 0 ]; then
    if ! extract_claude "$events" "$RUN_OUTPUT_TMP" "$RUN_METRICS_TMP" \
        "$started" "$backend" "$effort" "$lane"; then
      phase="extract"
      reason="$EXTRACT_REASON"
      final_rc=70
    fi
    if [ "$final_rc" -eq 0 ] && [ "$evaluation" = 1 ] &&
        [ "$(wc -m <"$RUN_OUTPUT_TMP" | tr -d ' ')" -gt "$EVALUATION_MAX_OUTPUT_CHARS" ]; then
      phase="extract"
      reason="max_output_chars"
      final_rc=70
    fi
    if [ "$final_rc" -eq 0 ] && [ -n "$EVALUATION_WORKDIR_COMMIT" ]; then
      workdir_tree_after_sha="$(worktree_snapshot_sha256 "$workdir" "$tmp/workdir.after")" \
        || { phase="extract"; reason="workdir_snapshot_failed"; final_rc=70; }
      git_control_after_sha="$(directory_snapshot_sha256 "$EVALUATION_GIT_DIR" "$tmp/git-control.after")" \
        || { phase="extract"; reason="git_control_snapshot_failed"; final_rc=70; }
      if [ "$final_rc" -eq 0 ] && [ "$git_control_before_sha" != "$git_control_after_sha" ]; then
        phase="dispatch"
        reason="git_control_modified"
        final_rc=70
      fi
      if [ "$final_rc" -eq 0 ] && [ "$lane" != builder ] &&
          [ "$workdir_tree_before_sha" != "$workdir_tree_after_sha" ]; then
        phase="dispatch"
        reason="workdir_modified"
        final_rc=70
      fi
    fi
    if [ "$final_rc" -eq 0 ] && [ -n "$EVALUATION_WORKDIR_COMMIT" ]; then
      local receipt_tmp raw_output_sha changed_paths ignored_paths changed_path_modes diff_sha changed_paths_file ignored_paths_file path mode
      receipt_tmp="$(mktemp "$metrics_parent/.${metrics_name}.receipt.XXXXXX")"
      raw_output_sha="$(sha256_file "$RUN_OUTPUT_TMP")" || die 69 "sha256 tool is required for evaluation receipt"
      changed_paths_file="$tmp/changed-paths"
      ignored_paths_file="$tmp/ignored-paths"
      {
        git -C "$workdir" diff --name-only -z HEAD --
        git -C "$workdir" ls-files -z --others --exclude-standard
        git -C "$workdir" ls-files -z --others --ignored --exclude-standard
      } | LC_ALL=C sort -zu >"$changed_paths_file"
      git -C "$workdir" ls-files -z --others --ignored --exclude-standard \
        | LC_ALL=C sort -zu >"$ignored_paths_file"
      changed_paths="$(jq -Rsc 'split("\u0000") | map(select(length > 0))' "$changed_paths_file")"
      ignored_paths="$(jq -Rsc 'split("\u0000") | map(select(length > 0))' "$ignored_paths_file")"
      changed_path_modes="$({
        while IFS= read -r -d '' path; do
          mode="$(normalized_mode "$workdir/$path" 2>/dev/null || true)"
          jq -nc --arg path "$path" --arg mode "$mode" \
            '{path:$path,mode:(if $mode == "" then null else $mode end)}'
        done <"$changed_paths_file"
      } | jq -sc '.')"
      if git -C "$workdir" diff --binary HEAD -- >"$tmp/workdir.diff"; then
        diff_sha="$(sha256_file "$tmp/workdir.diff")"
      else
        phase="extract"; reason="workdir_diff_failed"; final_rc=70; diff_sha=""
      fi
      if [ "$final_rc" -eq 0 ]; then
        jq --arg manifest_sha256 "$EVALUATION_MANIFEST_SHA256" \
          --arg prompt_sha256 "$EVALUATION_PROMPT_SHA256" \
          --arg runner_source_commit "$EVALUATION_RUNNER_SOURCE_COMMIT" \
          --arg runner_sha256 "$EVALUATION_RUNNER_SHA256" \
          --arg workdir_commit "$EVALUATION_WORKDIR_COMMIT" \
          --arg raw_output_sha256 "$raw_output_sha" \
          --arg workdir_diff_sha256 "$diff_sha" \
          --arg workdir_tree_before_sha256 "$workdir_tree_before_sha" \
          --arg workdir_tree_after_sha256 "$workdir_tree_after_sha" \
          --arg git_control_before_sha256 "$git_control_before_sha" \
          --arg git_control_after_sha256 "$git_control_after_sha" \
          --argjson changed_paths "$changed_paths" \
          --argjson ignored_paths "$ignored_paths" \
          --argjson changed_path_modes "$changed_path_modes" \
          --argjson task_count "$EVALUATION_TASK_COUNT" '
            . + {evaluation_receipt:{
              schema_version:"delegation_glm_lane_evaluation_attempt_receipt_v2",
              evaluation_manifest_sha256:$manifest_sha256,
              prompt_sha256:$prompt_sha256,
              runner_source_commit:$runner_source_commit,
              runner_sha256:$runner_sha256,
              workdir_commit:(if $workdir_commit == "" then null else $workdir_commit end),
              task_count:$task_count,provider_attempts:1,post_observation_retries:0,
              raw_output_sha256:$raw_output_sha256,
              workdir_diff_sha256:$workdir_diff_sha256,
              workdir_tree_before_sha256:$workdir_tree_before_sha256,
              workdir_tree_after_sha256:$workdir_tree_after_sha256,
              git_control_before_sha256:$git_control_before_sha256,
              git_control_after_sha256:$git_control_after_sha256,
              changed_paths:$changed_paths,
              ignored_paths:$ignored_paths,
              changed_path_modes:$changed_path_modes}}
          ' "$RUN_METRICS_TMP" >"$receipt_tmp" || { phase="extract"; reason="evaluation_receipt_failed"; final_rc=70; }
        if [ "$final_rc" -eq 0 ]; then mv "$receipt_tmp" "$RUN_METRICS_TMP"; else rm -f -- "$receipt_tmp"; fi
      fi
    fi
  else
    phase="dispatch"
    reason="process_exit"
    final_rc=70
    cli_exit="$rc"
    if [ "$evaluation" = 1 ] && { [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; }; then
      reason="evaluation_timeout"
      final_rc=75
    fi
  fi

  if [ "$final_rc" -ne 0 ]; then
    # A dead or malformed key is the runtime being unavailable (69), not the
    # worker breaking (70). The API key is now GLM's only credential and
    # claude_zai_status can only see that the string is non-empty — never that it
    # authenticates — so this is the first place a bad key can surface.
    #
    # Read the structured retry events, not the text: a rejected key produces
    # `result.subtype = "error_during_execution"` with an EMPTY result string and
    # nothing auth-shaped in stderr, so there is no keyword to grep for. Grepping
    # the raw stream would also misfire — an ordinary `EACCES: permission denied`
    # from a tool call would masquerade as an auth failure.
    #
    # Only a dispatch failure gets reclassified: an extract-phase reason
    # (empty_result, model_mismatch, …) already names the real defect, and a
    # stray 429 earlier in an otherwise-completed stream must not overwrite it.
    if [ "$phase" = dispatch ]; then
      if jq -se 'any(.[]; .type == "system" and .subtype == "api_retry"
                         and (.error_status // 0) == 401)' "$events" >/dev/null 2>&1; then
        reason="authentication_failed"
        final_rc=69
      elif jq -se 'any(.[]; .type == "system" and .subtype == "api_retry"
                           and (.error_status // 0) == 429)' "$events" >/dev/null 2>&1; then
        # Z.AI's numeric body codes (1302 rate/concurrency vs 1308/1310/1316/
        # 1317 quota-window) never reach this runner: a captured api_retry
        # event carries only the HTTP status and a normalized error string
        # (verified 2026-08-04). The one observable quota signal is a
        # rate_limit_event carrying an epoch reset; when present, the 429 is
        # quota exhaustion and retrying before that instant is guaranteed
        # waste, so surface the timestamp and a distinct reason. Both stay
        # exit 75: the retry/stop split lives in reason + next_flush_time.
        NEXT_FLUSH_TIME="$(jq -rs '
          [.[] | select(.type == "rate_limit_event")] | last // {} |
          (.resets_at // .rate_limit.resets_at // .info.resets_at // empty) |
          select(type == "number") | floor
        ' "$events" 2>/dev/null)"
        if [ -n "$NEXT_FLUSH_TIME" ]; then
          reason="quota_exhausted"
        else
          reason="rate_limited"
        fi
        final_rc=75
      elif grep -Eqi 'rate.?limit|too many requests|1302|1305' "$stderr_file" 2>/dev/null; then
        reason="rate_limited"
        final_rc=75
      fi
    fi

    DEBUG_RUN_DIR=""
    if [ -n "$debug_dir" ] && ! preserve_debug_artifacts "$debug_dir" "$events" "$stderr_file"; then
      debug_warning="could not preserve raw debug artifacts under $debug_dir"
      DEBUG_RUN_DIR=""
    fi
    write_failure_diagnostic "$diagnostic" "$events" "$stderr_file" "$started" \
      "$backend" "$effort" "$lane" "$phase" "$reason" "$cli_exit" "$DEBUG_RUN_DIR"
    if [ -n "$DEBUG_RUN_DIR" ]; then
      if ! cp "$diagnostic" "$DEBUG_RUN_DIR/diagnostic.json" ||
          ! chmod 600 "$DEBUG_RUN_DIR/diagnostic.json"; then
        debug_warning="could not copy the sanitized diagnostic into $DEBUG_RUN_DIR"
      fi
    fi
    [ -z "$debug_warning" ] || printf 'delegation-glm: warning: %s\n' "$debug_warning" >&2
    printf 'delegation-glm: %s (details: %s)\n' "$reason" "$diagnostic" >&2
    [ -z "$DEBUG_RUN_DIR" ] || printf 'delegation-glm: raw debug artifacts: %s\n' "$DEBUG_RUN_DIR" >&2
    exit "$final_rc"
  fi

  mv "$RUN_OUTPUT_TMP" "$output"
  RUN_OUTPUT_TMP=""
  mv "$RUN_METRICS_TMP" "$metrics"
  RUN_METRICS_TMP=""
  rm -f -- "$output.error.json"
  return 0
}

load_gate_identity

case "${1:-}" in
  check)
    shift
    if [ "${1:-}" = "--json" ]; then print_check 1; else print_check 0; fi
    ;;
  run)
    shift; run_command "$@"
    ;;
  -h|--help|"") usage ;;
  *) die 64 "unknown command: $1" ;;
esac
