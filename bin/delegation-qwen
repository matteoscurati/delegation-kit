#!/usr/bin/env bash
# Run Qwen3.8-Max through the Qwen Cloud Token Plan OpenAI-compatible endpoint.
# Only the builder lane is promoted, and only as provisional/explicit-only: it
# requires --allow-provisional after an explicit routing decision. Every other
# lane stays blocked until exact local evaluation promotes it in both the
# central and executable gates.
#
# Model upgrade monitoring: `delegation-qwen check` reports whether the
# Qwen3.8-Max-0902 snapshot (qwen3.8-max-0902) is available on this endpoint.
# When it appears, the migration is a model-id re-pin in the routing gates
# plus a fresh evidence row — see docs/external-executors.md.
set -euo pipefail
umask 077

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
RUNNER_NAME="delegation-qwen"
PROVIDER_LABEL="Qwen3.8-Max"
ROUTING_FILE="${DELEGATION_QWEN_ROUTING_FILE:-$ROOT/config/qwen3.8-max-routing.json}"
ROUTING_FILE_ENV="DELEGATION_QWEN_ROUTING_FILE"
CENTRAL_GATES="${DELEGATION_ROUTING_GATES_FILE:-$ROOT/config/routing-gates.json}"
ROUTER="$ROOT/bin/delegation-route"
KEY_FILE="${DELEGATION_QWEN_KEY_FILE:-$ROOT/config/qwen-token-plan.env}"
API_KEY_VAR="QWEN_TOKEN_PLAN_API_KEY"
MODEL="qwen3.8-max"
# Post-training refresh released 2026-09-02 on QwenCloud; not yet on this
# Token Plan endpoint. check reports its availability so the re-pin is
# deliberate when Alibaba propagates it.
MODEL_NEXT="qwen3.8-max-0902"
PROFILE="qwen3.8-max"
BACKEND="token-plan-openai"
API_URL="https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/chat/completions"
PINNED_EFFORT="xhigh"
BILLING="credits"

# shellcheck source=bin/lib/delegation-runner-common.sh
. "$ROOT/bin/lib/delegation-runner-common.sh"
# shellcheck source=bin/lib/delegation-chat-completions.sh
. "$ROOT/bin/lib/delegation-chat-completions.sh"

usage() {
  cat <<'EOF'
Usage:
  delegation-qwen check [--json]
  delegation-qwen run --lane <builder|clerk|scout|reviewer|senior|judgement|policy-annotation> \
    [--effort <auto|none|minimal|low|medium|high|xhigh|max>] \
    [--backend <auto|token-plan-openai>] --prompt-file <path> \
    --output <path> --workdir <path> [--metrics <path>] \
    [--debug-dir <path>] [--allow-provisional] \
    [--evaluation --evaluation-manifest <path>] [--preflight-only]

The builder lane is provisional: pass --allow-provisional after an explicit
routing decision. It is text-only — the Token Plan chat-completions transport
cannot edit a worktree, so builder returns a patch the lead applies and
verifies. Normal dispatch is refused while lanes are candidate/disabled.

--evaluation is reserved for allowlisted controlled qualification runs of
candidate lanes, never promotes or mutates a gate, and adds no operational
route. It cannot be combined with --allow-provisional. Policy-annotation
does not qualify broad architecture/trade-off judgement. --preflight-only is
valid only with --evaluation and --evaluation-manifest: it traverses the same
pre-provider validation path as the real evaluation run, prints a
delegation_policy_annotation_preflight_receipt_v1 receipt on stdout, and exits
zero before provider dispatch and before any caller-visible artifact exists.

Exit codes: 64 invalid input, 69 unavailable/authentication failure,
70 dispatch/extract failure, 75 temporary/rate-limit failure, 78 routing gate
refusal. Failures write sanitized metadata to <output>.error.json. Raw provider
responses and stderr are preserved only when --debug-dir is supplied.
EOF
}

# Token Plan keys carry the sk-sp- prefix; a DashScope key is refused rather
# than silently billed to the wrong plan.
provider_validate_key() {
  case "$QWEN_TOKEN_PLAN_API_KEY" in
    sk-sp-*) return 0 ;;
    *) PROVIDER_REASON="configured key is not a Token Plan key (expected sk-sp- prefix)"; return 1 ;;
  esac
}

provider_request_body() {
  local prompt_file="$1" effort="$2" max_tokens="$3"
  jq -n --arg model "$MODEL" --rawfile prompt "$prompt_file" --arg effort "$effort" \
    --argjson max_tokens "$max_tokens" \
    '{model:$model,messages:[{role:"user",content:$prompt}],max_tokens:$max_tokens,reasoning_effort:$effort}'
}

# Whether the QwenCloud post-training refresh (qwen3.8-max-0902) is available
# on this Token Plan endpoint. Read-only GET /models; never dispatches. The
# result is informational: the re-pin is a routing-gate decision, not a
# runtime side effect.
models_endpoint_available() {
  local key="$1" body
  body="$(curl -sS --connect-timeout 10 --max-time 20 \
    "${API_URL%/chat/completions}/models" \
    -H "Authorization: Bearer $key" 2>/dev/null)" || return 1
  printf '%s' "$body" | jq -e --arg id "$MODEL_NEXT" \
    '.data | type == "array" and any(.[]; .id == $id)' >/dev/null 2>&1
}

next_snapshot_status() {
  local key="${QWEN_TOKEN_PLAN_API_KEY:-}"
  [ -n "$key" ] || { printf 'unknown'; return; }
  if models_endpoint_available "$key"; then printf 'available'; else printf 'not-yet-available'; fi
}

provider_check_extra_json() {
  jq -n --arg next_model "$MODEL_NEXT" --arg next_snapshot "$(next_snapshot_status)" \
    '{next_snapshot:{model:$next_model,availability:$next_snapshot}}'
}

provider_check_extra_text() {
  case "$(next_snapshot_status)" in
    available)         printf '  next snapshot: %s AVAILABLE on this endpoint — re-pin is ready (see docs/external-executors.md)\n' "$MODEL_NEXT" ;;
    not-yet-available) printf '  next snapshot: %s not yet on this endpoint\n' "$MODEL_NEXT" ;;
    *)                 printf '  next snapshot: %s availability unknown (key not configured)\n' "$MODEL_NEXT" ;;
  esac
}

chat_completions_main "$@"
