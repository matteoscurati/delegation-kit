#!/usr/bin/env bash
# Run Qwen3.8 Max Preview through the Qwen Cloud Token Plan OpenAI-compatible
# endpoint. The model is a blocked candidate until exact local evaluation
# promotes a lane in both the central and executable gates.
set -euo pipefail
umask 077

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
ROUTING_FILE="${DELEGATION_QWEN_ROUTING_FILE:-$ROOT/config/qwen3.8-max-preview-routing.json}"
CENTRAL_GATES="${DELEGATION_ROUTING_GATES_FILE:-$ROOT/config/routing-gates.json}"
ROUTER="$ROOT/bin/delegation-route"
KEY_FILE="${DELEGATION_QWEN_KEY_FILE:-$ROOT/config/qwen-token-plan.env}"
MODEL="qwen3.8-max-preview"
BACKEND="token-plan-openai"
API_URL="https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/chat/completions"
RUN_TMP="" RUN_OUTPUT_TMP="" RUN_METRICS_TMP=""

cleanup_run() {
  [ -z "$RUN_OUTPUT_TMP" ] || rm -f -- "$RUN_OUTPUT_TMP"
  [ -z "$RUN_METRICS_TMP" ] || rm -f -- "$RUN_METRICS_TMP"
  [ -z "$RUN_TMP" ] || rm -rf -- "$RUN_TMP"
}

usage() {
  cat <<'EOF'
Usage:
  delegation-qwen check [--json]
  delegation-qwen run --lane <clerk|scout|reviewer|senior|judgement|policy-annotation> \
    [--effort <auto|none|minimal|low|medium|high|xhigh|max>] \
    [--backend <auto|token-plan-openai>] --prompt-file <path> \
    --output <path> --workdir <path> [--metrics <path>] \
    [--debug-dir <path>] [--evaluation --evaluation-manifest <path>]

Normal dispatch is refused while lanes are candidate/disabled. --evaluation is
reserved for allowlisted controlled qualification runs of candidate lanes, never
promotes or mutates a gate, and adds no operational route. Policy-annotation
does not qualify broad architecture/trade-off judgement.

Exit codes: 64 invalid input, 69 unavailable/authentication failure,
70 dispatch/extract failure, 75 temporary/rate-limit failure, 78 routing gate
refusal. Failures write sanitized metadata to <output>.error.json. Raw provider
responses and stderr are preserved only when --debug-dir is supplied.
EOF
}

die() { local code="$1"; shift; printf 'delegation-qwen: %s\n' "$*" >&2; exit "$code"; }
have() { command -v "$1" >/dev/null 2>&1; }
normalized_destination() { local parent name; parent="$(cd "$(dirname "$1")" && pwd -P)" || return 1; name="$(basename "$1")"; printf '%s/%s' "$parent" "$name"; }

key_file_mode() {
  local mode
  if mode="$(stat -c '%a' "$KEY_FILE" 2>/dev/null)"; then printf '%s' "$mode"; return; fi
  if mode="$(stat -f '%Lp' "$KEY_FILE" 2>/dev/null)"; then printf '%s' "$mode"; return; fi
  printf ''
}

load_key() {
  QWEN_KEY_PROBLEM=""
  [ -z "${QWEN_TOKEN_PLAN_API_KEY:-}" ] || return 0
  [ -f "$KEY_FILE" ] || return 0
  local perms raw
  perms="$(key_file_mode)"
  case "$perms" in ""|?00) ;; *) QWEN_KEY_PROBLEM="key file $KEY_FILE is mode $perms; run: chmod 600 $KEY_FILE"; return 0 ;; esac
  raw="$(sed -n 's/^[[:space:]]*\(export[[:space:]][[:space:]]*\)\{0,1\}QWEN_TOKEN_PLAN_API_KEY=//p' "$KEY_FILE" 2>/dev/null | head -1)"
  raw="${raw%$'\r'}"; raw="${raw#"${raw%%[![:space:]]*}"}"; raw="${raw%"${raw##*[![:space:]]}"}"
  case "$raw" in \"*\") raw="${raw#\"}"; raw="${raw%\"}" ;; \'*\') raw="${raw#\'}"; raw="${raw%\'}" ;; esac
  if [ -n "$raw" ]; then QWEN_TOKEN_PLAN_API_KEY="$raw"; else QWEN_KEY_PROBLEM="key file $KEY_FILE holds no QWEN_TOKEN_PLAN_API_KEY line"; fi
}

runtime_status() {
  QWEN_REASON=""
  have curl || { QWEN_REASON="curl not on PATH"; return 1; }
  have jq || { QWEN_REASON="jq not on PATH"; return 1; }
  load_key
  if [ -z "${QWEN_TOKEN_PLAN_API_KEY:-}" ]; then QWEN_REASON="${QWEN_KEY_PROBLEM:-QWEN_TOKEN_PLAN_API_KEY is unset and $KEY_FILE holds no key}"; return 1; fi
  case "$QWEN_TOKEN_PLAN_API_KEY" in sk-sp-*) ;; *) QWEN_REASON="configured key is not a Token Plan key (expected sk-sp- prefix)"; return 1 ;; esac
  QWEN_REASON="ready"; return 0
}

validate_gate_graph() {
  [ -x "$ROUTER" ] || return 1
  DELEGATION_ROUTING_GATES_FILE="$CENTRAL_GATES" DELEGATION_QWEN_ROUTING_FILE="$ROUTING_FILE" "$ROUTER" check --json >/dev/null 2>&1
}

lane_status() { jq -r --arg lane "$1" '.profiles["qwen3.8-max-preview"].lanes[$lane].status // "disabled"' "$CENTRAL_GATES"; }
lane_effort() { jq -r '.profiles["qwen3.8-max-preview"].effort // empty' "$CENTRAL_GATES"; }
qualified_lanes() { jq -c '[.profiles["qwen3.8-max-preview"].lanes | to_entries[] | select(.value.status == "qualified") | .key] | sort' "$CENTRAL_GATES"; }
provisional_lanes() { jq -c '[.profiles["qwen3.8-max-preview"].lanes | to_entries[] | select(.value.status == "provisional") | .key] | sort' "$CENTRAL_GATES"; }
candidate_lanes() { jq -c '[.profiles["qwen3.8-max-preview"].lanes | to_entries[] | select(.value.status == "candidate") | .key] | sort' "$CENTRAL_GATES"; }

sha256_file() {
  if have shasum; then shasum -a 256 "$1" | awk '{print $1}';
  elif have sha256sum; then sha256sum "$1" | awk '{print $1}';
  else return 1; fi
}

evaluation_manifest() {
  local manifest="$1" lane="$2" prompt_file="$3" expected_effort="$4" hash expected_hash source_head
  [ -f "$manifest" ] && [ ! -L "$manifest" ] || die 78 "evaluation manifest is missing or symlinked"
  hash="$(sha256_file "$manifest")" || die 69 "sha256 tool is required for evaluation"
  expected_hash="$(sha256_file "$prompt_file")" || die 69 "sha256 tool is required for evaluation"
  source_head="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null)" || die 78 "runner source checkout is unavailable"
  git -C "$ROOT" diff --quiet && git -C "$ROOT" diff --cached --quiet &&
    [ -z "$(git -C "$ROOT" ls-files --others --exclude-standard)" ] || die 78 "runner source checkout is dirty"
  jq -e --arg lane "$lane" --arg model "$MODEL" --arg effort "$expected_effort" \
    --arg prompt_sha256 "$expected_hash" --arg source_head "$source_head" '
      (keys | sort) == ["backend","contract_sha256","effort","lane","max_output_chars","model","output_schema_sha256","profile","prompt_sha256","runner_source_commit","schema","timeout_seconds"] and
      .schema == "delegation_policy_annotation_evaluation_v1" and
      .profile == "qwen3.8-max-preview" and .lane == $lane and .model == $model and
      .backend == "token-plan-openai" and .effort == $effort and .prompt_sha256 == $prompt_sha256 and
      .runner_source_commit == $source_head and
      ([.prompt_sha256,.output_schema_sha256,.contract_sha256] | all(test("^[0-9a-f]{64}$"))) and
      (.runner_source_commit | test("^[0-9a-f]{40}$")) and
      (.timeout_seconds | type == "number" and floor == . and . >= 1 and . <= 600) and
      (.max_output_chars | type == "number" and floor == . and . >= 1 and . <= 65536)
    ' "$manifest" >/dev/null 2>&1 || die 78 "evaluation manifest is malformed or does not bind this exact run"
  jq -e --arg lane "$lane" --arg hash "$hash" '
    .profiles["qwen3.8-max-preview"].lanes[$lane].evaluation_manifest_sha256 | type == "array" and index($hash) != null
  ' "$CENTRAL_GATES" >/dev/null 2>&1 || die 78 "evaluation manifest is not allowlisted by the central gate"
  jq -e --arg lane "$lane" --arg hash "$hash" '
    .lanes[$lane].backends["token-plan-openai"].evaluation_manifest_sha256 | type == "array" and index($hash) != null
  ' "$ROUTING_FILE" >/dev/null 2>&1 || die 78 "evaluation manifest is not allowlisted by the executable gate"
  EVALUATION_TIMEOUT_SECONDS="$(jq -r '.timeout_seconds' "$manifest")"
  EVALUATION_MAX_OUTPUT_CHARS="$(jq -r '.max_output_chars' "$manifest")"
}

DEBUG_RUN_DIR=""
preserve_debug() {
  local parent="$1" response_file="$2" stderr_file="$3"
  DEBUG_RUN_DIR=""
  [ -n "$parent" ] || return 0
  DEBUG_RUN_DIR="$(mktemp -d "$parent/delegation-qwen.XXXXXX")" || return 1
  chmod 700 "$DEBUG_RUN_DIR"
  cp "$response_file" "$DEBUG_RUN_DIR/response.json"
  cp "$stderr_file" "$DEBUG_RUN_DIR/stderr.txt"
  chmod 600 "$DEBUG_RUN_DIR/response.json" "$DEBUG_RUN_DIR/stderr.txt"
}

write_diagnostic() {
  local diagnostic="$1" response_file="$2" stderr_file="$3" started="$4"
  local effort="$5" lane="$6" phase="$7" reason="$8" http_code="$9"
  local curl_exit="${10}" debug_path="${11}"
  local parent name tmp finished response_bytes stderr_bytes
  response_bytes="$(wc -c <"$response_file" | tr -d ' ')"
  stderr_bytes="$(wc -c <"$stderr_file" | tr -d ' ')"
  finished="$(date +%s)"
  parent="$(dirname "$diagnostic")"
  name="$(basename "$diagnostic")"
  tmp="$(mktemp "$parent/.$name.XXXXXX")"
  jq -n --arg model "$MODEL" --arg backend "$BACKEND" --arg effort "$effort" \
    --arg lane "$lane" --arg phase "$phase" --arg reason "$reason" \
    --arg http_code "$http_code" --arg debug_dir "$debug_path" \
    --argjson curl_exit "$curl_exit" --argjson response_bytes "$response_bytes" \
    --argjson stderr_bytes "$stderr_bytes" \
    --argjson elapsed_seconds "$((finished - started))" \
    '{schema_version:1,model:$model,backend:$backend,effort:$effort,lane:$lane,
      phase:$phase,reason:$reason,http_code:$http_code,curl_exit_code:$curl_exit,
      response_bytes:$response_bytes,stderr_bytes:$stderr_bytes,
      elapsed_seconds:$elapsed_seconds,
      debug_dir:(if $debug_dir == "" then null else $debug_dir end)}' >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$diagnostic"
}

print_check() {
  local as_json="${1:-0}" ready=false selected=none
  validate_gate_graph || die 78 "central and executable routing gates are missing, invalid, or inconsistent"
  runtime_status && ready=true || true
  [ "$ready" = true ] && selected="$BACKEND"
  if [ "$as_json" = 1 ]; then
    jq -n --arg model "$MODEL" --arg selected "$selected" --arg reason "$QWEN_REASON" \
      --argjson available "$ready" --argjson qualified "$(qualified_lanes)" \
      --argjson provisional "$(provisional_lanes)" --argjson candidate "$(candidate_lanes)" \
      '{model:$model,efforts:["xhigh"],selected_backend:$selected,qualified_lanes:$qualified,provisional_lanes:$provisional,candidate_lanes:$candidate,backends:{"token-plan-openai":{available:$available,reason:$reason}}}'
  else
    printf 'Qwen3.8 Max Preview: selected=%s qualified=%s provisional=%s candidate=%s\n' "$selected" "$(qualified_lanes)" "$(provisional_lanes)" "$(candidate_lanes)"
    printf '  token-plan-openai: %s (%s; effort=xhigh)\n' "$ready" "$QWEN_REASON"
  fi
}

run_command() {
  local lane="" effort=auto backend=auto prompt_file="" output="" workdir="" metrics="" debug_dir="" evaluation=0 evaluation_manifest_path=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --lane) lane="${2:-}"; shift 2 ;; --effort) effort="${2:-}"; shift 2 ;;
      --backend) backend="${2:-}"; shift 2 ;; --prompt-file) prompt_file="${2:-}"; shift 2 ;;
      --output) output="${2:-}"; shift 2 ;; --workdir) workdir="${2:-}"; shift 2 ;;
      --metrics) metrics="${2:-}"; shift 2 ;; --debug-dir) debug_dir="${2:-}"; shift 2 ;;
      --evaluation) evaluation=1; shift ;;
      --evaluation-manifest) evaluation_manifest_path="${2:-}"; shift 2 ;;
      -h|--help) usage; exit 0 ;; *) die 64 "unknown run argument: $1" ;;
    esac
  done
  case "$lane" in clerk|scout|reviewer|senior|judgement|policy-annotation) ;; *) die 64 "invalid lane: $lane" ;; esac
  case "$effort" in auto|none|minimal|low|medium|high|xhigh|max) ;; *) die 64 "invalid effort: $effort" ;; esac
  case "$backend" in auto|token-plan-openai) ;; *) die 64 "invalid backend: $backend" ;; esac
  [ -f "$prompt_file" ] || die 64 "prompt file missing: $prompt_file"
  if [ "$evaluation" = 1 ]; then
    [ -n "$evaluation_manifest_path" ] || die 64 "--evaluation requires --evaluation-manifest"
  else
    [ -z "$evaluation_manifest_path" ] || die 64 "--evaluation-manifest requires --evaluation"
  fi
  [ -d "$workdir" ] || die 64 "workdir missing: $workdir"
  [ -n "$output" ] || die 64 "--output is required"
  [ -z "$debug_dir" ] || {
    [ -d "$debug_dir" ] && [ ! -L "$debug_dir" ] || die 64 "debug directory missing or symlinked: $debug_dir"
    debug_dir="$(cd "$debug_dir" && pwd -P)"
  }
  validate_gate_graph || die 78 "central and executable routing gates are missing, invalid, or inconsistent"
  backend="$BACKEND"
  local status; status="$(lane_status "$lane")"
  if [ "$evaluation" = 0 ]; then
    case "$status" in qualified) ;; provisional) die 78 "lane '$lane' is provisional but this candidate runner requires an explicit future policy update" ;; *) die 78 "lane '$lane' has non-dispatchable status '$status'" ;; esac
  else
    [ "$status" = candidate ] || die 78 "lane '$lane' has status '$status'; --evaluation permits candidate lanes only"
  fi
  [ "$effort" != auto ] || effort="$(lane_effort)"
  if [ "$effort" != "$(lane_effort)" ]; then die 78 "lane '$lane' is pinned only at effort '$(lane_effort)'"; fi
  [ "$effort" != none ] || die 64 "qwen3.8-max-preview requires thinking; effort 'none' is not supported"
  if [ "$evaluation" = 1 ]; then
    evaluation_manifest "$evaluation_manifest_path" "$lane" "$prompt_file" "$effort"
  fi
  runtime_status || die 69 "$QWEN_REASON"

  metrics="${metrics:-$output.metrics.json}"
  local diagnostic="$output.error.json"
  local output_parent metrics_parent diagnostic_parent output_name metrics_name diagnostic_name
  output_parent="$(dirname "$output")"; output_name="$(basename "$output")"
  metrics_parent="$(dirname "$metrics")"; metrics_name="$(basename "$metrics")"
  diagnostic_parent="$(dirname "$diagnostic")"; diagnostic_name="$(basename "$diagnostic")"
  [ -d "$output_parent" ] || die 64 "output parent directory must already exist: $output_parent"
  [ -d "$metrics_parent" ] || die 64 "metrics parent directory must already exist: $metrics_parent"
  [ -d "$diagnostic_parent" ] || die 64 "diagnostic parent directory must already exist: $diagnostic_parent"
  output="$(cd "$output_parent" && pwd -P)/$output_name"
  metrics="$(cd "$metrics_parent" && pwd -P)/$metrics_name"
  diagnostic="$(cd "$diagnostic_parent" && pwd -P)/$diagnostic_name"
  workdir="$(cd "$workdir" && pwd -P)"
  if [ -n "$debug_dir" ]; then
    case "$debug_dir" in
      "$workdir"|"$workdir"/*) die 64 "read-only lane debug directory must be outside workdir" ;;
    esac
  fi
  [ ! -e "$output" ] && [ ! -e "$metrics" ] && [ ! -e "$diagnostic" ] \
    || die 64 "output, metrics, and diagnostic paths must not already exist"
  [ ! -L "$output" ] && [ ! -L "$metrics" ] && [ ! -L "$diagnostic" ] \
    || die 64 "output, metrics, and diagnostic paths must not be symlinks"
  local norm_output norm_metrics norm_diagnostic
  norm_output="$(normalized_destination "$output")"
  norm_metrics="$(normalized_destination "$metrics")"
  norm_diagnostic="$(normalized_destination "$diagnostic")"
  [ "$norm_output" != "$norm_metrics" ] || die 64 "output and metrics paths resolve to the same file"
  [ "$norm_output" != "$norm_diagnostic" ] && [ "$norm_metrics" != "$norm_diagnostic" ] \
    || die 64 "path collides with reserved diagnostic path"
  case "$output" in "$workdir"/*) die 64 "read-only lane output must be outside workdir" ;; esac
  case "$metrics" in "$workdir"/*) die 64 "read-only lane metrics must be outside workdir" ;; esac
  case "$diagnostic" in "$workdir"/*) die 64 "read-only lane diagnostic must be outside workdir" ;; esac

  local tmp body response stderr_file http_code started curl_rc=0 curl_config provider_model=""
  local phase="" reason="" final_rc=0
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/delegation-qwen.XXXXXX")"
  RUN_TMP="$tmp"
  trap cleanup_run EXIT
  body="$tmp/request.json"; response="$tmp/response.json"; stderr_file="$tmp/stderr"
  curl_config="$tmp/curl.conf"; started="$(date +%s)"
  : >"$response"; : >"$stderr_file"
  RUN_OUTPUT_TMP="$(mktemp "$output_parent/.$output_name.XXXXXX")"
  RUN_METRICS_TMP="$(mktemp "$metrics_parent/.$metrics_name.XXXXXX")"
  jq -n --arg model "$MODEL" --rawfile prompt "$prompt_file" --arg effort "$effort" \
    '{model:$model,messages:[{role:"user",content:$prompt}],max_tokens:4096,reasoning_effort:$effort}' >"$body"
  # Keep the bearer token out of the process argv. The runner-wide umask makes
  # this transient curl config mode 600, and the EXIT trap removes it.
  printf 'header = "Authorization: Bearer %s"\nheader = "Content-Type: application/json"\n' \
    "$QWEN_TOKEN_PLAN_API_KEY" >"$curl_config"
  local max_time=600
  [ "$evaluation" = 0 ] || max_time="$EVALUATION_TIMEOUT_SECONDS"
  http_code="$(curl --config "$curl_config" -sS -o "$response" -w '%{http_code}' \
    --connect-timeout 20 --max-time "$max_time" --data-binary "@$body" "$API_URL" 2>"$stderr_file")" || curl_rc=$?
  if [ "$curl_rc" -ne 0 ]; then
    http_code=000; phase=dispatch; reason=transport_failure; final_rc=75
  else
    case "$http_code" in
      200) ;;
      401|403) phase=dispatch; reason=authentication_failed; final_rc=69 ;;
      429) phase=dispatch; reason=rate_limited; final_rc=75 ;;
      5??) phase=dispatch; reason=provider_temporary_failure; final_rc=75 ;;
      *) phase=dispatch; reason=provider_error; final_rc=70 ;;
    esac
  fi
  if [ "$final_rc" -eq 0 ] && ! provider_model="$(jq -er '.model | select(type == "string" and . == "qwen3.8-max-preview")' "$response")"; then
    phase=extract; reason=provider_identity_mismatch; final_rc=70
  fi
  if [ "$final_rc" -eq 0 ] && ! jq -er \
    '.choices[0].message.content | select(type == "string" and length > 0)' \
    "$response" >"$RUN_OUTPUT_TMP"; then
    phase=extract; reason=invalid_or_empty_response; final_rc=70
  fi
  if [ "$final_rc" -eq 0 ] && [ "$evaluation" = 1 ] && [ "$(wc -m <"$RUN_OUTPUT_TMP" | tr -d ' ')" -gt "$EVALUATION_MAX_OUTPUT_CHARS" ]; then
    phase=extract; reason=output_limit_exceeded; final_rc=70
  fi
  if [ "$final_rc" -eq 0 ] && ! jq -n --arg model "$provider_model" --arg effort "$effort" \
    --arg lane "$lane" --argjson started "$started" \
    --argjson input "$(jq '.usage.prompt_tokens // 0' "$response")" \
    --argjson output_tokens "$(jq '.usage.completion_tokens // 0' "$response")" \
    '{model:$model,backend:"token-plan-openai",effort:$effort,lane:$lane,
      started_at_epoch:$started,finished_at_epoch:now,billing:"credits",
      provider_cost_usd:null,tokens:{input:$input,output:$output_tokens,
      reasoning:0,cache_read:0,cache_write:0}}' >"$RUN_METRICS_TMP"; then
    phase=extract; reason=metrics_write_failed; final_rc=70
  fi
  if [ "$final_rc" -eq 0 ]; then
    if ! mv "$RUN_METRICS_TMP" "$metrics"; then
      phase=publish; reason=metrics_publish_failed; final_rc=70
    else
      RUN_METRICS_TMP=""
      if ! mv "$RUN_OUTPUT_TMP" "$output"; then
        rm -f -- "$metrics"
        phase=publish; reason=output_publish_failed; final_rc=70
      else
        RUN_OUTPUT_TMP=""
      fi
    fi
  fi
  if [ "$final_rc" -ne 0 ]; then
    preserve_debug "$debug_dir" "$response" "$stderr_file" || DEBUG_RUN_DIR=""
    write_diagnostic "$diagnostic" "$response" "$stderr_file" "$started" \
      "$effort" "$lane" "$phase" "$reason" "$http_code" "$curl_rc" "$DEBUG_RUN_DIR"
    if [ -n "$DEBUG_RUN_DIR" ]; then
      cp "$diagnostic" "$DEBUG_RUN_DIR/diagnostic.json" \
        && chmod 600 "$DEBUG_RUN_DIR/diagnostic.json" || true
    fi
    printf 'delegation-qwen: %s (details: %s)\n' "$reason" "$diagnostic" >&2
    exit "$final_rc"
  fi
}

case "${1:-}" in
  check) shift; if [ "${1:-}" = --json ]; then print_check 1; else print_check 0; fi ;;
  run) shift; run_command "$@" ;; -h|--help|"") usage ;; *) die 64 "unknown command: $1" ;;
esac
