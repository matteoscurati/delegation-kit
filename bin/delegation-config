#!/usr/bin/env python3
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from delegation_config import load, initialize, apply, config_path
import json

p = argparse.ArgumentParser()
p.add_argument("command", choices=["init", "validate", "show", "apply"])
p.add_argument("--preset", choices=["default", "strict"], default="default")
a = p.parse_args()
try:
    if a.command == "init":
        result = initialize(a.preset == "strict")
    else:
        c = load()
        if a.command == "apply":
            result = apply()
        elif a.command == "show":
            result = c
        else:
            result = {"schema_version": 1, "valid": True, "file": str(config_path())}
    print(json.dumps(result, indent=2))
except (OSError, ValueError, KeyError, TypeError) as e:
    print("delegation-config: " + str(e), file=sys.stderr)
    sys.exit(65)
