#!/usr/bin/env bash
# Run the gated Grok 4.5 model through Grok Build CLI. Fails closed: only the
# capability-compatible builder lanes, exact model, effort, backend, and scoped workspace
# sandbox can dispatch.
set -euo pipefail
umask 077

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
ROUTING_FILE="${DELEGATION_GROK_ROUTING_FILE:-$ROOT/config/grok-4.5-routing.json}"
CENTRAL_GATES="${DELEGATION_ROUTING_GATES_FILE:-$ROOT/config/routing-gates.json}"
ROUTER="$ROOT/bin/delegation-route"
MODEL="grok-4.5"
RUNTIME_MODEL="grok-4.5"
USAGE_MODEL="grok-4.5-build"
BACKEND="grok-build"
EFFORTS='["high"]'
CLI_COMPATIBILITY="capability-probed"
SANDBOX_PROFILE="delegation-kit"
MAX_TURNS=40
TIMEOUT_SECONDS="${DELEGATION_GROK_TIMEOUT_SECONDS:-900}"
SOURCE_GROK_HOME="${DELEGATION_GROK_HOME:-${HOME:?HOME is required}/.grok}"
GROK_BIN_STORE="${DELEGATION_GROK_BIN_STORE:-${DELEGATION_DATA_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/delegation-kit}/grok-cli}"
GROK_BIN=""
GROK_BIN_SOURCE="none"
GROK_CLI_VERSION="unknown"
RUN_TMP=""

cleanup() { [ -z "$RUN_TMP" ] || rm -rf -- "$RUN_TMP"; }
trap cleanup EXIT

usage() {
  cat <<'EOF'
Usage:
  delegation-grok check [--json]
  delegation-grok pin [--from <path>] [--force]
  delegation-grok run --lane <builder|frontend-builder|policy-annotation> \
    [--effort <auto|high>] [--backend <auto|grok-build>] \
    --prompt-file <path> --output <path> --workdir <path> \
    [--metrics <path>] [--debug-dir <existing-private-directory>] \
    [--allow-provisional] [--evaluation --evaluation-manifest <path>]

`pin` archives a capability-compatible CLI build into a private store so a
vendor auto-update of the ambient CLI never disturbs the selected lane. The
runner resolves its binary in this order: DELEGATION_GROK_BIN, the private
archive, then `grok` on PATH. CLI version is recorded as provenance only.

Exit codes: 64 invalid input, 69 unavailable/authentication failure,
70 dispatch/extract failure, 75 temporary/rate-limit failure,
78 routing gate refusal.
EOF
}

die() { local code="$1"; shift; printf 'delegation-grok: %s\n' "$*" >&2; exit "$code"; }
have() { command -v "$1" >/dev/null 2>&1; }

evaluation_manifest() {
  local manifest="$1" prompt_file="$2" manifest_hash prompt_hash source_head contract schema runner_hash
  [ -f "$manifest" ] && [ ! -L "$manifest" ] || die 78 "evaluation manifest is missing or symlinked"
  manifest_hash="$(file_digest "$manifest")" || die 69 "sha256 tool is required for evaluation"
  prompt_hash="$(file_digest "$prompt_file")" || die 69 "sha256 tool is required for evaluation"
  source_head="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null)" || die 78 "runner source checkout is unavailable"
  contract="$(jq -r '.contract_path // empty' "$manifest" 2>/dev/null)"; schema="$(jq -r '.output_schema_path // empty' "$manifest" 2>/dev/null)"; case "$contract" in /*|*..*) die 78 "evaluation contract_path must be root-relative";; esac; case "$schema" in /*|*..*) die 78 "evaluation output_schema_path must be root-relative";; esac; contract="$ROOT/$contract"; schema="$ROOT/$schema"; runner_hash="$(file_digest "$SOURCE")" || die 69 "sha256 tool is required for evaluation"
  [ -n "$contract" ] && [ -n "$schema" ] && [ -f "$contract" ] && [ ! -L "$contract" ] && [ -f "$schema" ] && [ ! -L "$schema" ] || die 78 "evaluation contract or schema is missing or symlinked"
  git -C "$ROOT" diff --quiet && git -C "$ROOT" diff --cached --quiet && [ -z "$(git -C "$ROOT" ls-files --others --exclude-standard)" ] || die 78 "runner source checkout is dirty"
  jq -e --arg prompt_sha256 "$prompt_hash" --arg contract_sha256 "$(file_digest "$contract")" --arg schema_sha256 "$(file_digest "$schema")" --arg runner_sha256 "$runner_hash" '
    (keys | sort) == ["backend","contract_path","contract_sha256","effort","lane","max_output_chars","model","output_schema_path","output_schema_sha256","profile","prompt_sha256","runner_sha256","runner_source_commit","schema","timeout_seconds"] and
    .schema == "delegation_policy_annotation_evaluation_v1" and .profile == "grok-build" and .lane == "policy-annotation" and .model == "grok-4.5" and .backend == "grok-build" and .effort == "high" and .prompt_sha256 == $prompt_sha256 and .contract_sha256 == $contract_sha256 and .output_schema_sha256 == $schema_sha256 and
    .runner_sha256 == $runner_sha256 and ([.prompt_sha256,.contract_sha256,.output_schema_sha256,.runner_sha256] | all(test("^[0-9a-f]{64}$"))) and (.runner_source_commit | test("^[0-9a-f]{40}$")) and
    (.timeout_seconds | type == "number" and floor == . and . >= 1 and . <= 600) and (.max_output_chars | type == "number" and floor == . and . >= 1 and . <= 65536)
  ' "$manifest" >/dev/null 2>&1 || die 78 "evaluation manifest is malformed or does not bind this exact run"
  git -C "$ROOT" merge-base --is-ancestor "$(jq -r '.runner_source_commit' "$manifest")" "$source_head" || die 78 "evaluation manifest source commit is not an ancestor of this runner"
  jq -e --arg hash "$manifest_hash" '.profiles["grok-build"].lanes["policy-annotation"].evaluation_manifest_sha256 | type == "array" and index($hash) != null' "$CENTRAL_GATES" >/dev/null 2>&1 || die 78 "evaluation manifest is not allowlisted by the central gate"
  jq -e --arg hash "$manifest_hash" '.lanes["policy-annotation"].backends["grok-build"].evaluation_manifest_sha256 | type == "array" and index($hash) != null' "$ROUTING_FILE" >/dev/null 2>&1 || die 78 "evaluation manifest is not allowlisted by the executable gate"
  EVALUATION_TIMEOUT_SECONDS="$(jq -r '.timeout_seconds' "$manifest")"; EVALUATION_MAX_OUTPUT_CHARS="$(jq -r '.max_output_chars' "$manifest")"
}

pinned_bin_path() { printf '%s/current/grok' "$GROK_BIN_STORE"; }
pinned_digest_path() { printf '%s/current/grok.sha256' "$GROK_BIN_STORE"; }

file_digest() {
  if have shasum; then shasum -a 256 "$1" 2>/dev/null | awk '{print $1}'
  elif have sha256sum; then sha256sum "$1" 2>/dev/null | awk '{print $1}'
  else return 1
  fi
}

observed_cli_version() {
  local bin="$1" probe_home="$2" version
  version="$(HOME="$probe_home" "$bin" --version 2>/dev/null | head -1 || true)"
  if [[ "$version" =~ ^grok[[:space:]]+([^[:space:]]+) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  elif [ -n "$version" ]; then
    printf '%s\n' "$version"
  else
    printf 'unknown\n'
  fi
}

supports_required_interface() {
  local bin="$1" probe_home="$2" help inspect_help command_name
  help="$(HOME="$probe_home" "$bin" --help 2>&1 || true)"
  # Parse the complete dispatch surface under `--help`. This catches removed or
  # renamed flags without starting a session, including hidden compatibility
  # flags that may not be printed in the top-level help.
  HOME="$probe_home" "$bin" \
    --prompt-file /dev/null \
    --model "$RUNTIME_MODEL" --reasoning-effort high \
    --permission-mode dontAsk --sandbox "$SANDBOX_PROFILE" \
    --output-format json --no-memory --no-subagents \
    --disable-web-search --no-auto-update \
    --tools 'grep,read_file,search_replace,list_dir,todo_write' \
    --allow 'Edit(**)' --max-turns "$MAX_TURNS" \
    --deny 'Edit(**/.grok/config.toml)' \
    --deny 'Edit(**/.grok/sandbox.toml)' \
    --deny 'Edit(**/.grok/auth.json)' \
    --help >/dev/null 2>&1 || return 1
  for command_name in models inspect; do
    grep -Eq "^[[:space:]]+$command_name([[:space:]]|$)" <<<"$help" || return 1
    HOME="$probe_home" "$bin" "$command_name" --help >/dev/null 2>&1 || return 1
  done
  inspect_help="$(HOME="$probe_home" "$bin" inspect --help 2>&1 || true)"
  grep -q -- '--json' <<<"$inspect_help"
}

verify_archived_bin() {
  local candidate="$1" digest_file expected actual
  [ -x "$candidate" ] && [ ! -L "$candidate" ] || return 1
  digest_file="$candidate.sha256"
  [ -r "$digest_file" ] || return 1
  expected="$(cut -d' ' -f1 <"$digest_file")"
  actual="$(file_digest "$candidate")" || return 1
  [ -n "$expected" ] && [ "$actual" = "$expected" ]
}

# Resolution order: explicit override, private archive, ambient PATH. The archive
# store is what makes a vendor auto-update a non-event: it is a private copy
# the updater cannot see, prune, or replace.
resolve_grok_bin() {
  local probe_home="$1" candidate="" pinned legacy
  GROK_BIN=""
  GROK_BIN_SOURCE="none"
  mkdir -p "$probe_home"
  if [ -n "${DELEGATION_GROK_BIN:-}" ]; then
    [ -x "${DELEGATION_GROK_BIN}" ] \
      || { GROK_REASON="DELEGATION_GROK_BIN is not an executable file: $DELEGATION_GROK_BIN"; return 1; }
    candidate="$DELEGATION_GROK_BIN"
    GROK_BIN_SOURCE="override"
  else
    pinned="$(pinned_bin_path)"
    if [ -x "$pinned" ] && [ ! -L "$pinned" ]; then
      [ -r "$(pinned_digest_path)" ] \
        || { GROK_REASON="pinned Grok Build CLI has no recorded digest; re-run: delegation-grok pin --force"; return 1; }
      file_digest "$pinned" >/dev/null \
        || { GROK_REASON="shasum or sha256sum is required to verify the pinned Grok Build CLI"; return 1; }
      verify_archived_bin "$pinned" \
        || { GROK_REASON="pinned Grok Build CLI digest mismatch; re-run: delegation-grok pin --force"; return 1; }
      candidate="$pinned"
      GROK_BIN_SOURCE="pinned"
    else
      # Pre-capability-gate releases stored archives under a version-named
      # directory. Resolve any digest-valid, interface-compatible legacy copy
      # when `current/` and PATH are absent; install.sh will then migrate it.
      for legacy in "$GROK_BIN_STORE"/*/grok; do
        [ "$legacy" != "$pinned" ] || continue
        if verify_archived_bin "$legacy" &&
          supports_required_interface "$legacy" "$probe_home"; then
          candidate="$legacy"
          GROK_BIN_SOURCE="legacy"
          break
        fi
      done
      if [ -z "$candidate" ] && have grok; then
        candidate="$(command -v grok)"
        GROK_BIN_SOURCE="path"
      fi
      if [ -z "$candidate" ]; then
        GROK_REASON="no compatible archived Grok Build CLI and grok is not on PATH; run: delegation-grok pin"
        return 1
      fi
    fi
  fi
  supports_required_interface "$candidate" "$probe_home" || {
    GROK_REASON="Grok Build CLI lacks the required interface (resolved from $GROK_BIN_SOURCE: $candidate)"
    GROK_BIN_SOURCE="none"
    return 1
  }
  GROK_BIN="$candidate"
  GROK_CLI_VERSION="$(observed_cli_version "$candidate" "$probe_home")"
}

timeout_bin() {
  if have timeout; then
    command -v timeout
  elif have gtimeout; then
    command -v gtimeout
  else
    return 1
  fi
}

prepare_isolated_home() {
  local isolated_home="$1" auth_path config_path sandbox_path
  auth_path="$isolated_home/.grok/auth.json"
  config_path="$isolated_home/.grok/config.toml"
  sandbox_path="$isolated_home/.grok/sandbox.toml"
  [ -r "$SOURCE_GROK_HOME/auth.json" ] || {
    GROK_REASON="Grok Build credentials missing; run: grok login"
    return 1
  }
  mkdir -p "$isolated_home/.grok"
  cp "$SOURCE_GROK_HOME/auth.json" "$auth_path"
  chmod 600 "$auth_path"
  cat >"$config_path" <<'EOF'
[compat.claude]
skills = false
rules = false
agents = false
mcps = false
hooks = false
sessions = false

[compat.cursor]
skills = false
rules = false
agents = false
mcps = false
hooks = false
sessions = false

[compat.codex]
sessions = false

[workflows]
enabled = false
EOF
  cat >"$sandbox_path" <<'EOF'
[profiles.delegation-kit]
extends = "strict"
restrict_network = true

[profiles.delegation-kit-read-only]
extends = "read-only"
restrict_network = true
EOF
  chmod 600 "$config_path" "$sandbox_path"
}

inspect_isolation() {
  local isolated_home="$1" inspect_file="$2" inspect_workdir="${3:-$PWD}"
  (cd "$inspect_workdir" && HOME="$isolated_home" "$GROK_BIN" inspect --json) \
    >"$inspect_file" 2>/dev/null || {
    GROK_REASON="Grok Build isolation inspection failed"
    return 1
  }
  jq -e '
    (.mcpServers | length) == 0 and
    (.plugins | length) == 0 and
    (.permissions.sources | length) == 0 and
    (.hooks | length) == 0
  ' "$inspect_file" >/dev/null 2>&1 || {
    GROK_REASON="Grok Build isolation is contaminated by plugins, MCP, permissions, or hooks"
    return 1
  }
}

validate_gate_graph() {
  [ -x "$ROUTER" ] || return 1
  DELEGATION_ROUTING_GATES_FILE="$CENTRAL_GATES" \
    DELEGATION_GROK_ROUTING_FILE="$ROUTING_FILE" \
    "$ROUTER" check --json >/dev/null 2>&1
}

runtime_status() {
  GROK_REASON=""
  have jq || { GROK_REASON="jq is required"; return 1; }
  timeout_bin >/dev/null || { GROK_REASON="timeout or gtimeout is required"; return 1; }
  [[ "$TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] \
    || { GROK_REASON="DELEGATION_GROK_TIMEOUT_SECONDS must be a positive integer"; return 1; }
  local models status_tmp
  status_tmp="$(mktemp -d "${TMPDIR:-/tmp}/delegation-grok-status.XXXXXX")"
  resolve_grok_bin "$status_tmp/probe" || { rm -rf -- "$status_tmp"; return 1; }
  prepare_isolated_home "$status_tmp/home" || { rm -rf -- "$status_tmp"; return 1; }
  models="$(HOME="$status_tmp/home" "$GROK_BIN" models 2>&1)" \
    || { rm -rf -- "$status_tmp"; GROK_REASON="Grok Build model inventory unavailable; run: grok login"; return 1; }
  grep -Fq "You are logged in with grok.com." <<<"$models" \
    || { rm -rf -- "$status_tmp"; GROK_REASON="Grok Build is logged out; run: grok login"; return 1; }
  grep -Eq '^[[:space:]]*\*?[[:space:]]*grok-4\.5([[:space:]]|$)' <<<"$models" \
    || { rm -rf -- "$status_tmp"; GROK_REASON="Grok Build does not expose required model grok-4.5"; return 1; }
  inspect_isolation "$status_tmp/home" "$status_tmp/inspect.json" \
    || { rm -rf -- "$status_tmp"; return 1; }
  rm -rf -- "$status_tmp"
  GROK_REASON="ready"
}

qualified_lanes() {
  jq -c '[.profiles["grok-build"].lanes | to_entries[] |
    select(.value.status == "qualified") | .key] | sort' "$CENTRAL_GATES" 2>/dev/null || printf '[]'
}

provisional_lanes() {
  jq -c '[.profiles["grok-build"].lanes | to_entries[] |
    select(.value.status == "provisional") | .key] | sort' "$CENTRAL_GATES" 2>/dev/null || printf '[]'
}

gate_status() {
  local lane="$1"
  jq -r --arg lane "$lane" '.profiles["grok-build"].lanes[$lane].status // "disabled"' \
    "$CENTRAL_GATES" 2>/dev/null || printf 'disabled\n'
}

is_allowed() {
  local lane="$1" allow_provisional="$2" status
  status="$(gate_status "$lane")"
  [ "$status" = qualified ] || { [ "$status" = provisional ] && [ "$allow_provisional" = 1 ]; }
}

default_effort() {
  jq -r '.profiles["grok-build"].effort // empty' "$CENTRAL_GATES" 2>/dev/null
}

print_check() {
  local as_json="${1:-0}" available=false selected="none" lanes provisional
  have jq || die 69 "jq is required"
  validate_gate_graph || die 78 "central and executable routing gates are missing, invalid, or inconsistent"
  runtime_status && available=true || true
  lanes="$(qualified_lanes)"
  provisional="$(provisional_lanes)"
  [ "$available" = true ] && selected="$BACKEND"
  if [ "$as_json" = 1 ]; then
    jq -n --arg model "$MODEL" --arg runtime_model "$RUNTIME_MODEL" \
      --arg usage_model "$USAGE_MODEL" --arg selected "$selected" \
      --argjson available "$available" --arg reason "$GROK_REASON" \
      --argjson efforts "$EFFORTS" --argjson lanes "$lanes" \
      --argjson provisional "$provisional" --arg cli_version "$GROK_CLI_VERSION" \
      --arg cli_compatibility "$CLI_COMPATIBILITY" \
      --arg cli_source "$GROK_BIN_SOURCE" --arg cli_path "$GROK_BIN" \
      --arg sandbox "$SANDBOX_PROFILE" --argjson max_turns "$MAX_TURNS" \
      --argjson timeout_seconds "$TIMEOUT_SECONDS" \
      '{model:$model,runtime_model:$runtime_model,usage_model:$usage_model,
        runtime_cli_version:$cli_version,runtime_cli_compatibility:$cli_compatibility,
        runtime_cli_source:$cli_source,
        runtime_cli_path:(if $cli_path == "" then null else $cli_path end),
        efforts:$efforts,selected_backend:$selected,qualified_lanes:$lanes,
        provisional_lanes:$provisional,backends:{"grok-build":{
          available:$available,reason:$reason,efforts:["high"],
          sandbox:$sandbox,permission_mode:"dontAsk",
          max_turns:$max_turns,timeout_seconds:$timeout_seconds,
          isolated_home:true,plugins:false,mcp:false,terminal:false}}}'
  else
    printf 'Grok 4.5: selected=%s qualified=%s provisional=%s\n' "$selected" "$lanes" "$provisional"
    printf '  grok-build: %s (%s; model=%s; cli=%s from %s; effort=high; sandbox=%s; max-turns=%s; timeout=%ss)\n' \
      "$available" "$GROK_REASON" "$RUNTIME_MODEL" "$GROK_CLI_VERSION" \
      "$GROK_BIN_SOURCE" "$SANDBOX_PROFILE" "$MAX_TURNS" "$TIMEOUT_SECONDS"
  fi
}

auth_failure() {
  grep -Eqi 'not logged in|logged out|login required|unauthorized|authentication|invalid token|status.?401' "$1"
}

temporary_failure() {
  grep -Eqi 'rate.?limit|too many requests|usage limit|quota|temporar.*unavailable|status.?429' "$1"
}

extract_result() {
  local response="$1" output="$2" metrics="$3" started="$4" lane="$5"
  local sandbox="$6" timeout_seconds="$7"
  jq -e --arg usage_model "$USAGE_MODEL" '
    (.text | type == "string" and length > 0) and
    (.stopReason == "EndTurn" or .stopReason == "end_turn") and
    (.modelUsage[$usage_model] | type == "object")
  ' "$response" >/dev/null 2>&1 || return 1
  jq -r '.text' "$response" >"$output" || return 1
  jq -e --arg model "$MODEL" --arg runtime_model "$RUNTIME_MODEL" \
    --arg usage_model "$USAGE_MODEL" --arg lane "$lane" --argjson started "$started" '
    . as $r | ($r.modelUsage[$usage_model] // {}) as $u |
    {model:$model,runtime_model:$runtime_model,usage_model:$usage_model,
     backend:"grok-build",effort:"high",lane:$lane,
     runtime_cli_version:$cli_version,runtime_cli_compatibility:$cli_compatibility,
     runtime_cli_source:$cli_source,
     sandbox:$sandbox,permission_mode:"dontAsk",
     isolated_home:true,plugins:false,mcp:false,
     terminal:false,
     max_turns:$max_turns,timeout_seconds:$timeout_seconds,
     started_at_epoch:$started,finished_at_epoch:now,
     duration_seconds:(now-$started),stop_reason:($r.stopReason // null),
     turns:($r.num_turns // null),
     tokens:{input:($r.usage.input_tokens // $u.inputTokens // 0),
       output:($r.usage.output_tokens // $u.outputTokens // 0),
       reasoning:($r.usage.reasoning_tokens // 0),
       cache_read:($r.usage.cache_read_input_tokens // $u.cacheReadInputTokens // 0),
       total:($r.usage.total_tokens // 0)},
     provider_cost_usd:($r.total_cost_usd // $u.costUSD // null)}
  ' --arg cli_version "$GROK_CLI_VERSION" --arg cli_compatibility "$CLI_COMPATIBILITY" \
    --arg cli_source "$GROK_BIN_SOURCE" \
    --arg sandbox "$sandbox" \
    --argjson max_turns "$MAX_TURNS" --argjson timeout_seconds "$timeout_seconds" \
    "$response" >"$metrics"
}

write_diagnostic() {
  local path="$1" phase="$2" reason="$3" rc="$4" started="$5"
  local response="$6" stderr_file="$7" debug_path="$8" finished
  finished="$(date +%s)"
  jq -n --arg model "$MODEL" --arg runtime_model "$RUNTIME_MODEL" \
    --arg cli_version "$GROK_CLI_VERSION" --arg lane "$lane" \
    --arg cli_compatibility "$CLI_COMPATIBILITY" \
    --arg phase "$phase" --arg reason "$reason" --argjson rc "$rc" \
    --argjson started "$started" --argjson finished "$finished" \
    --argjson stdout_bytes "$(wc -c <"$response" | tr -d ' ')" \
    --argjson stderr_bytes "$(wc -c <"$stderr_file" | tr -d ' ')" \
    --arg debug_path "$debug_path" '
    {model:$model,runtime_model:$runtime_model,runtime_cli_version:$cli_version,
     runtime_cli_compatibility:$cli_compatibility,
     backend:"grok-build",effort:"high",lane:$lane,phase:$phase,reason:$reason,
     cli_exit_code:$rc,started_at_epoch:$started,finished_at_epoch:$finished,
     duration_seconds:($finished-$started),
     captured_bytes:{stdout:$stdout_bytes,stderr:$stderr_bytes},
     debug_path:(if $debug_path == "" then null else $debug_path end)}
  ' >"$path"
}

preserve_debug() {
  local debug_dir="$1" response="$2" stderr_file="$3"
  [ -n "$debug_dir" ] || return 0
  DEBUG_PATH="$(mktemp -d "$debug_dir/delegation-grok.XXXXXX")"
  cp "$response" "$DEBUG_PATH/response.json"
  cp "$stderr_file" "$DEBUG_PATH/stderr.txt"
  chmod 700 "$DEBUG_PATH"
  chmod 600 "$DEBUG_PATH/response.json" "$DEBUG_PATH/stderr.txt"
}

run_command() {
  local lane="" effort="auto" backend="auto" prompt_file="" output="" workdir="" metrics="" debug_dir="" evaluation_manifest_path=""
  local allow_provisional=0 evaluation=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --lane) lane="${2:-}"; shift 2 ;;
      --effort) effort="${2:-}"; shift 2 ;;
      --backend) backend="${2:-}"; shift 2 ;;
      --prompt-file) prompt_file="${2:-}"; shift 2 ;;
      --output) output="${2:-}"; shift 2 ;;
      --workdir) workdir="${2:-}"; shift 2 ;;
      --metrics) metrics="${2:-}"; shift 2 ;;
      --debug-dir) debug_dir="${2:-}"; shift 2 ;;
      --allow-provisional) allow_provisional=1; shift ;;
      --evaluation) evaluation=1; shift ;;
      --evaluation-manifest) evaluation_manifest_path="${2:-}"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die 64 "unknown run argument: $1" ;;
    esac
  done
  case "$lane" in builder|frontend-builder|policy-annotation) ;; *) die 64 "invalid lane: $lane" ;; esac
  case "$effort" in auto|high) ;; *) die 64 "invalid effort: $effort" ;; esac
  case "$backend" in auto|grok-build) ;; *) die 64 "invalid backend: $backend" ;; esac
  [ -f "$prompt_file" ] || die 64 "prompt file missing: $prompt_file"
  [ -s "$prompt_file" ] || die 64 "prompt file must not be empty"
  if [ "$evaluation" = 1 ]; then [ -n "$evaluation_manifest_path" ] || die 64 "--evaluation requires --evaluation-manifest"; else [ -z "$evaluation_manifest_path" ] || die 64 "--evaluation-manifest requires --evaluation"; fi
  [ -d "$workdir" ] || die 64 "workdir missing: $workdir"
  [ -z "$debug_dir" ] || [ -d "$debug_dir" ] || die 64 "debug directory missing: $debug_dir"
  [ -n "$output" ] || die 64 "--output is required"
  have jq || die 69 "jq is required"
  [ -r "$ROUTING_FILE" ] || die 69 "routing file missing: $ROUTING_FILE"
  jq -e . "$ROUTING_FILE" >/dev/null 2>&1 || die 69 "routing file is invalid JSON"
  validate_gate_graph || die 78 "central and executable routing gates are missing, invalid, or inconsistent"
  if [ "$evaluation" = 0 ]; then is_allowed "$lane" "$allow_provisional" || {
    status="$(gate_status "$lane")"
    if [ "$status" != provisional ]; then
      die 78 "lane '$lane' has non-dispatchable status '$status'"
    else
      die 78 "lane '$lane' is provisional; pass --allow-provisional after an explicit routing decision"
    fi
  }; else
    [ "$lane" = policy-annotation ] || die 78 "--evaluation permits policy-annotation candidate only"
    [ "$(gate_status "$lane")" = candidate ] || die 78 "policy-annotation is not a candidate in the central gate"
  fi
  [ "$effort" != auto ] || effort="$(default_effort)"
  [ "$effort" = high ] || die 78 "lane '$lane' is qualified only at effort 'high'"
  [ "$evaluation" = 0 ] || evaluation_manifest "$evaluation_manifest_path" "$prompt_file"
  runtime_status || die 69 "$GROK_REASON"

  workdir="$(cd "$workdir" && pwd -P)"
  metrics="${metrics:-$output.metrics.json}"
  local output_parent metrics_parent output_name metrics_name diagnostic
  output_parent="$(dirname "$output")"; metrics_parent="$(dirname "$metrics")"
  output_name="$(basename "$output")"; metrics_name="$(basename "$metrics")"
  [ -d "$output_parent" ] || die 64 "output parent directory must already exist: $output_parent"
  [ -d "$metrics_parent" ] || die 64 "metrics parent directory must already exist: $metrics_parent"
  output="$(cd "$output_parent" && pwd -P)/$output_name"
  metrics="$(cd "$metrics_parent" && pwd -P)/$metrics_name"
  [ -z "$debug_dir" ] || debug_dir="$(cd "$debug_dir" && pwd -P)"
  diagnostic="$output.error.json"
  [ "$output" != "$metrics" ] || die 64 "output and metrics paths resolve to the same file"
  [ ! -e "$output" ] && [ ! -L "$output" ] || die 64 "output already exists or is a symlink"
  [ ! -e "$metrics" ] && [ ! -L "$metrics" ] || die 64 "metrics already exists or is a symlink"
  [ ! -e "$diagnostic" ] && [ ! -L "$diagnostic" ] || die 64 "diagnostic already exists or is a symlink"
  if [ "$lane" = policy-annotation ]; then
    case "$output" in "$workdir"/*) die 64 "policy-annotation output must be outside workdir" ;; esac
    case "$metrics" in "$workdir"/*) die 64 "policy-annotation metrics must be outside workdir" ;; esac
    case "$diagnostic" in "$workdir"/*) die 64 "policy-annotation diagnostic must be outside workdir" ;; esac
    if [ -n "$debug_dir" ]; then case "$debug_dir" in "$workdir"|"$workdir"/*) die 64 "policy-annotation debug directory must be outside workdir" ;; esac; fi
  fi

  local response result_tmp metrics_tmp stderr_file rc=0 started timer reason phase
  local DEBUG_PATH=""
  RUN_TMP="$(mktemp -d "${TMPDIR:-/tmp}/delegation-grok.XXXXXX")"
  response="$RUN_TMP/response.json"; result_tmp="$RUN_TMP/result.txt"
  metrics_tmp="$RUN_TMP/metrics.json"; stderr_file="$RUN_TMP/stderr.txt"
  cp "$prompt_file" "$RUN_TMP/prompt.txt"
  prepare_isolated_home "$RUN_TMP/home" || die 69 "$GROK_REASON"
  inspect_isolation "$RUN_TMP/home" "$RUN_TMP/inspect.json" "$workdir" || die 69 "$GROK_REASON"
  timer="$(timeout_bin)" || die 69 "timeout or gtimeout is required"
  started="$(date +%s)"
  local execution_timeout="$TIMEOUT_SECONDS"
  [ "$evaluation" = 0 ] || execution_timeout="$EVALUATION_TIMEOUT_SECONDS"
  local execution_tools='grep,read_file,search_replace,list_dir,todo_write'
  [ "$lane" != policy-annotation ] || execution_tools='grep,read_file,list_dir'
  local execution_sandbox="$SANDBOX_PROFILE"
  [ "$lane" != policy-annotation ] || execution_sandbox="delegation-kit-read-only"
  local -a grok_command=("$GROK_BIN" --prompt-file "$RUN_TMP/prompt.txt" \
    --model "$RUNTIME_MODEL" --reasoning-effort high \
    --permission-mode dontAsk --sandbox "$execution_sandbox" \
    --output-format json --no-memory --no-subagents --disable-web-search --no-auto-update \
    --tools "$execution_tools")
  [ "$lane" = policy-annotation ] || grok_command+=(--allow 'Edit(**)')
  grok_command+=(
    --max-turns "$MAX_TURNS" \
    --deny 'Edit(**/.grok/config.toml)' \
    --deny 'Edit(**/.grok/sandbox.toml)' \
    --deny 'Edit(**/.grok/auth.json)')
  (cd "$workdir" && HOME="$RUN_TMP/home" "$timer" -k 10 "$execution_timeout" "${grok_command[@]}") \
    >"$response" 2>"$stderr_file" || rc=$?
  if [ "$rc" -ne 0 ]; then
    phase="dispatch"; reason="dispatch_failed"
    [ "$rc" -ne 124 ] && [ "$rc" -ne 137 ] || reason="timeout"
    auth_failure "$stderr_file" && reason="authentication_failed"
    temporary_failure "$stderr_file" && reason="temporarily_unavailable"
    preserve_debug "$debug_dir" "$response" "$stderr_file"
    write_diagnostic "$diagnostic" "$phase" "$reason" "$rc" "$started" \
      "$response" "$stderr_file" "$DEBUG_PATH"
    case "$reason" in
      authentication_failed) die 69 "Grok Build authentication failed; sanitized diagnostic: $diagnostic" ;;
      temporarily_unavailable|timeout) die 75 "Grok Build $reason; sanitized diagnostic: $diagnostic" ;;
      *) die 70 "Grok Build dispatch failed (exit $rc); sanitized diagnostic: $diagnostic" ;;
    esac
  fi
  jq -e --arg profile "$execution_sandbox" '
    select(.event_type == "ProfileApplied" and .profile == $profile and .enforced == true)
  ' "$RUN_TMP/home/.grok/sandbox-events.jsonl" >/dev/null 2>&1 || {
    preserve_debug "$debug_dir" "$response" "$stderr_file"
    write_diagnostic "$diagnostic" "sandbox" "sandbox_not_enforced" 0 "$started" \
      "$response" "$stderr_file" "$DEBUG_PATH"
    die 70 "Grok Build sandbox enforcement was not attested; sanitized diagnostic: $diagnostic"
  }
  if [ "$evaluation" = 1 ]; then
    # Grok Build 0.2.114 does not emit a top-level `.model`; its structured
    # response identifies the selected provider route through modelUsage.
    jq -e --arg usage_model "$USAGE_MODEL" '
      .modelUsage[$usage_model] | type == "object"
    ' "$response" >/dev/null 2>&1 || {
      preserve_debug "$debug_dir" "$response" "$stderr_file"
      write_diagnostic "$diagnostic" "identity" "provider_identity_not_attested" 0 "$started" "$response" "$stderr_file" "$DEBUG_PATH"
      die 70 "Grok Build did not attest exact provider model identity; sanitized diagnostic: $diagnostic"
    }
  fi
  if jq -e '.stopReason == "MaxTurns" or .stopReason == "max_turns"' "$response" >/dev/null 2>&1; then
    preserve_debug "$debug_dir" "$response" "$stderr_file"
    write_diagnostic "$diagnostic" "extract" "max_turns" 0 "$started" \
      "$response" "$stderr_file" "$DEBUG_PATH"
    die 70 "Grok Build reached the maximum turn limit; sanitized diagnostic: $diagnostic"
  fi
  if jq -e '.stopReason == "Cancelled" or .stopReason == "cancelled"' "$response" >/dev/null 2>&1; then
    preserve_debug "$debug_dir" "$response" "$stderr_file"
    write_diagnostic "$diagnostic" "extract" "cancelled" 0 "$started" \
      "$response" "$stderr_file" "$DEBUG_PATH"
    die 70 "Grok Build cancelled before completing the task; sanitized diagnostic: $diagnostic"
  fi
  extract_result "$response" "$result_tmp" "$metrics_tmp" "$started" "$lane" \
    "$execution_sandbox" "$execution_timeout" \
    || {
      preserve_debug "$debug_dir" "$response" "$stderr_file"
      write_diagnostic "$diagnostic" "extract" "malformed_or_mismatched_output" 0 "$started" \
        "$response" "$stderr_file" "$DEBUG_PATH"
      die 70 "Grok Build returned malformed, empty, or mismatched output; sanitized diagnostic: $diagnostic"
    }
  if [ "$evaluation" = 1 ] && [ "$(wc -m <"$result_tmp" | tr -d ' ')" -gt "$EVALUATION_MAX_OUTPUT_CHARS" ]; then
    preserve_debug "$debug_dir" "$response" "$stderr_file"
    write_diagnostic "$diagnostic" "extract" "max_output_chars" 0 "$started" "$response" "$stderr_file" "$DEBUG_PATH"
    die 70 "Grok Build exceeded the manifest output limit; sanitized diagnostic: $diagnostic"
  fi
  mv "$metrics_tmp" "$metrics" || die 70 "could not finalize metrics"
  if ! mv "$result_tmp" "$output"; then
    rm -f -- "$metrics"
    die 70 "could not finalize output"
  fi
}

# Archive a capability-compatible build into a private store. A vendor auto-update
# replaces the ambient CLI and prunes its own download cache; the store is the
# copy that survives, so an update never becomes a routing-gate edit.
pin_command() {
  local from="" force=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --from) from="${2:-}"; shift 2 ;;
      --force) force=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die 64 "unknown pin argument: $1" ;;
    esac
  done
  have shasum || have sha256sum || die 69 "shasum or sha256sum is required"
  local candidates=() candidate found="" target digest_file digest existing probe found_version
  if [ -n "$from" ]; then
    [ -f "$from" ] && [ -x "$from" ] || die 64 "--from is not an executable file: $from"
    candidates=("$from")
  else
    [ -z "${DELEGATION_GROK_BIN:-}" ] || candidates+=("$DELEGATION_GROK_BIN")
    ! have grok || candidates+=("$(command -v grok)")
    for candidate in "$SOURCE_GROK_HOME"/downloads/*; do
      [ -f "$candidate" ] && [ -x "$candidate" ] && candidates+=("$candidate")
    done
    for candidate in "$GROK_BIN_STORE"/*/grok; do
      [ "$candidate" = "$(pinned_bin_path)" ] || {
        verify_archived_bin "$candidate" && candidates+=("$candidate")
      }
    done
  fi
  RUN_TMP="$(mktemp -d "${TMPDIR:-/tmp}/delegation-grok-pin.XXXXXX")"
  probe="$RUN_TMP/probe"
  mkdir -p "$probe"
  for candidate in ${candidates[@]+"${candidates[@]}"}; do
    if supports_required_interface "$candidate" "$probe"; then found="$candidate"; break; fi
  done
  [ -n "$found" ] || die 69 "no capability-compatible Grok Build CLI found in --from, DELEGATION_GROK_BIN, PATH, or $SOURCE_GROK_HOME/downloads"
  found_version="$(observed_cli_version "$found" "$probe")"

  target="$(pinned_bin_path)"
  digest_file="$(pinned_digest_path)"
  digest="$(file_digest "$found")" || die 70 "could not hash $found"
  if [ -e "$target" ] || [ -L "$target" ]; then
    existing="$(file_digest "$target" 2>/dev/null || true)"
    if [ "$existing" = "$digest" ] && [ -r "$digest_file" ]; then
      printf 'delegation-grok: compatible CLI already archived (%s) at %s\n' "$found_version" "$target"
      return 0
    fi
    [ "$force" = 1 ] || die 64 "a different build is already pinned at $target; pass --force to replace it"
  fi
  mkdir -p "$(dirname "$target")"
  cp -p "$found" "$target.incoming" || die 70 "could not copy $found into the pin store"
  chmod 500 "$target.incoming"
  mv -f "$target.incoming" "$target" || { rm -f "$target.incoming"; die 70 "could not finalize $target"; }
  digest="$(file_digest "$target")" || { rm -f "$target"; die 70 "could not hash the archived copy"; }
  printf '%s  grok\n' "$digest" >"$digest_file"
  chmod 400 "$digest_file"
  supports_required_interface "$target" "$probe" || {
    rm -f "$target" "$digest_file"
    die 70 "the archived copy does not expose the required interface"
  }
  printf 'delegation-grok: archived compatible Grok Build CLI %s\n  from: %s\n  to:   %s\n  sha256: %s\n' \
    "$found_version" "$found" "$target" "$digest"
}

case "${1:-}" in
  check)
    shift
    case "${1:-}" in
      "") print_check 0 ;;
      --json) shift; [ "$#" -eq 0 ] || die 64 "unknown check argument: $1"; print_check 1 ;;
      *) die 64 "unknown check argument: $1" ;;
    esac
    ;;
  pin) shift; pin_command "$@" ;;
  run) shift; run_command "$@" ;;
  -h|--help|"") usage ;;
  *) die 64 "unknown command: $1" ;;
esac
