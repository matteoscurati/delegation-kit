#!/usr/bin/env bash
# Run Grok 4.6 through Grok Build CLI. Fails closed: only the roles the adapter
# supports, the requested model, target usage participant, effort, backend, and
# scoped workspace sandbox can dispatch. A provider-surfaced content model that
# differs from the requested one is a silent substitution and fails every run.
set -euo pipefail
umask 077

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
# RUNNER_NAME is consumed by the sourced shared library.
# shellcheck disable=SC2034
RUNNER_NAME="delegation-grok"
# shellcheck source=bin/lib/delegation-runner-common.sh
. "$ROOT/bin/lib/delegation-runner-common.sh"
MODEL="${DELEGATION_REQUESTED_MODEL:-grok-4.6}"
ADAPTER="grok-build"
ROLES="builder frontend-builder policy-annotation"
RUNTIME_MODEL="$MODEL"
USAGE_MODEL=""
[ "$MODEL" != grok-4.6 ] || USAGE_MODEL="grok-4.6-build"
BACKEND="grok-build"
EFFORTS='["high"]'
CLI_COMPATIBILITY="capability-probed"
SANDBOX_PROFILE="delegation-kit"
MAX_TURNS=40
TIMEOUT_SECONDS="${DELEGATION_GROK_TIMEOUT_SECONDS:-900}"
SOURCE_GROK_HOME="${DELEGATION_GROK_HOME:-${HOME:?HOME is required}/.grok}"
DATA_HOME="${DELEGATION_DATA_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/delegation-kit}"
GROK_BIN_STORE="${DELEGATION_GROK_BIN_STORE:-$DATA_HOME/grok-cli}"
OAUTH_WAIT_SECONDS="${DELEGATION_GROK_OAUTH_WAIT_SECONDS:-5}"
case "$OAUTH_WAIT_SECONDS" in ""|*[!0-9]*) OAUTH_WAIT_SECONDS=5 ;; esac
GROK_SHLOCK_BIN="${DELEGATION_GROK_SHLOCK_BIN:-/usr/bin/shlock}"
GROK_BIN=""
GROK_BIN_SOURCE="none"
GROK_CLI_VERSION="unknown"
RUN_TMP=""
ACTIVE_GROK_HOME=""
OAUTH_LOCK_PATH=""
OAUTH_LOCK_HELD=0
OAUTH_LOCK_KIND=""
OAUTH_BASELINE_HASH=""
OAUTH_MODE="serialized"
OAUTH_SYNC_STATUS="not_attempted"
SHARED_OAUTH_DIR=""
SHARED_OAUTH_GEN=""
SHARED_POLICY_VERSION="delegation-grok-oauth-v1"
RUN_SANDBOX_PROFILE=""

release_oauth_lock() {
  local owner_pid=""
  [ "$OAUTH_LOCK_HELD" -eq 1 ] || return 0
  if [ "$OAUTH_LOCK_KIND" = mkdir ]; then
    if [ -d "$OAUTH_LOCK_PATH" ] && [ ! -L "$OAUTH_LOCK_PATH" ] &&
        [ -f "$OAUTH_LOCK_PATH/owner" ]; then
      owner_pid="$(<"$OAUTH_LOCK_PATH/owner")"
      if [ "$owner_pid" = "$$" ]; then
        rm -f -- "$OAUTH_LOCK_PATH/owner"
        rmdir "$OAUTH_LOCK_PATH" >/dev/null 2>&1 || true
      fi
    fi
  elif [ -f "$OAUTH_LOCK_PATH" ] && [ ! -L "$OAUTH_LOCK_PATH" ]; then
    owner_pid="$(<"$OAUTH_LOCK_PATH")"
    [ "$owner_pid" != "$$" ] || rm -f -- "$OAUTH_LOCK_PATH"
  fi
  OAUTH_LOCK_HELD=0
  OAUTH_LOCK_KIND=""
}

cleanup() {
  release_oauth_lock
  [ -z "$RUN_TMP" ] || rm -rf -- "$RUN_TMP"
}
trap cleanup EXIT

usage() {
  cat <<'EOF'
Usage:
  delegation-grok check [--json]
  delegation-grok pin [--from <path>] [--force]
  delegation-grok run --lane <builder|frontend-builder|policy-annotation> \
    [--effort <auto|high>] [--backend <auto|grok-build>] \
    --prompt-file <path> --output <path> --workdir <path> \
    [--metrics <path>] [--debug-dir <existing-private-directory>] \
    [--oauth <serialized|shared>]

`pin` archives a capability-compatible CLI build into a private store so a
vendor auto-update of the ambient CLI never disturbs the selected lane. The
runner resolves its binary in this order: DELEGATION_GROK_BIN, the private
archive, then `grok` on PATH. CLI version is recorded as provenance only.
--allow-provisional is accepted as a deprecated no-op for one release.

`--oauth shared` (or DELEGATION_GROK_OAUTH_MODE=shared) allows concurrent
operational dispatches. OAuth state lives in a runner-owned persistent
generation under $DELEGATION_DATA_HOME/grok-shared-oauth. Concurrent Grok
processes share that generation so the vendor auth lock can coordinate refresh,
while a short kit lock protects generation adoption and atomic publication back
to the ambient login. The default serialized mode holds the kit lock for the
whole dispatch.

Exit codes: 64 invalid input, 69 unavailable/authentication failure,
70 dispatch/extract failure, 75 temporary/rate-limit failure,
78 unsupported role or effort for this adapter.
EOF
}


pinned_bin_path() { printf '%s/current/grok' "$GROK_BIN_STORE"; }
pinned_digest_path() { printf '%s/current/grok.sha256' "$GROK_BIN_STORE"; }

file_digest() {
  if have shasum; then shasum -a 256 "$1" 2>/dev/null | awk '{print $1}'
  elif have sha256sum; then sha256sum "$1" 2>/dev/null | awk '{print $1}'
  else return 1
  fi
}

credential_tokens_valid() {
  local credential="$1"
  [ -f "$credential" ] && [ ! -L "$credential" ] || return 1
  jq -e '
    type == "object" and
    ([.[]? | objects |
      select(((.key // "") | type == "string" and length > 0) and
             ((.refresh_token // "") | type == "string" and length > 0))] |
     length > 0)
  ' "$credential" >/dev/null 2>&1
}

acquire_oauth_lock() {
  local owner_pid="" lock_mtime=0 now=0 quarantine="" stale=0
  [ -d "$SOURCE_GROK_HOME" ] && [ ! -L "$SOURCE_GROK_HOME" ] || return 1
  if [ -x "$GROK_SHLOCK_BIN" ]; then
    OAUTH_LOCK_PATH="$SOURCE_GROK_HOME/.delegation-kit-oauth.lock"
    [ ! -L "$OAUTH_LOCK_PATH" ] || return 1
    "$GROK_SHLOCK_BIN" -p "$$" -f "$OAUTH_LOCK_PATH" >/dev/null 2>&1 || return 2
    OAUTH_LOCK_KIND="shlock"
  else
    OAUTH_LOCK_PATH="$SOURCE_GROK_HOME/.delegation-kit-oauth.lock.d"
    [ ! -L "$OAUTH_LOCK_PATH" ] || return 1
    if ! mkdir "$OAUTH_LOCK_PATH" 2>/dev/null; then
      if [ -f "$OAUTH_LOCK_PATH/owner" ] && [ ! -L "$OAUTH_LOCK_PATH/owner" ]; then
        owner_pid="$(<"$OAUTH_LOCK_PATH/owner")"
      fi
      if [[ "$owner_pid" =~ ^[1-9][0-9]*$ ]] && ! kill -0 "$owner_pid" 2>/dev/null; then
        stale=1
      elif [ -z "$owner_pid" ]; then
        if lock_mtime="$(stat -f '%m' "$OAUTH_LOCK_PATH" 2>/dev/null)"; then :
        elif lock_mtime="$(stat -c '%Y' "$OAUTH_LOCK_PATH" 2>/dev/null)"; then :
        else lock_mtime=0
        fi
        now="$(date +%s)"
        [ "$lock_mtime" -gt 0 ] && [ $((now - lock_mtime)) -ge 30 ] && stale=1
      fi
      [ "$stale" -eq 1 ] || return 2
      quarantine="$OAUTH_LOCK_PATH.stale.$$"
      mv "$OAUTH_LOCK_PATH" "$quarantine" 2>/dev/null || return 2
      if [ -n "$owner_pid" ]; then
        if [ ! -f "$quarantine/owner" ] ||
            [ "$(<"$quarantine/owner")" != "$owner_pid" ]; then
          mv "$quarantine" "$OAUTH_LOCK_PATH" 2>/dev/null || true
          return 2
        fi
      fi
      rm -f -- "$quarantine/owner"
      rmdir "$quarantine" >/dev/null 2>&1 || return 1
      mkdir "$OAUTH_LOCK_PATH" 2>/dev/null || return 2
    fi
    printf '%s\n' "$$" >"$OAUTH_LOCK_PATH/owner" || {
      rmdir "$OAUTH_LOCK_PATH" >/dev/null 2>&1 || true
      return 1
    }
    chmod 700 "$OAUTH_LOCK_PATH"
    chmod 600 "$OAUTH_LOCK_PATH/owner"
    OAUTH_LOCK_KIND="mkdir"
  fi
  OAUTH_LOCK_HELD=1
}

shared_oauth_root() { printf '%s/grok-shared-oauth' "$DATA_HOME"; }

read_shared_marker() {
  local marker
  marker="$(shared_oauth_root)/sync-marker.json"
  [ -f "$marker" ] && [ ! -L "$marker" ] || return 1
  jq -re '
    select(.schema == "delegation_grok_shared_oauth_marker_v2") |
    select((.generation | type == "string" and test("^gen-[0-9]+-[0-9]+$")) and
           (.synced_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
           (.policy_version | type == "string" and test("^[a-z0-9-]+$"))) |
    "\(.generation) \(.synced_sha256) \(.policy_version)"
  ' "$marker" 2>/dev/null
}

write_shared_marker() {
  local generation="$1" synced_sha256="$2" root candidate
  root="$(shared_oauth_root)"
  candidate="$(mktemp "$root/.sync-marker.json.XXXXXX")" || return 1
  if ! jq -n --arg generation "$generation" --arg synced_sha256 "$synced_sha256" \
      --arg policy_version "$SHARED_POLICY_VERSION" \
      '{schema:"delegation_grok_shared_oauth_marker_v2",
        generation:$generation,synced_sha256:$synced_sha256,
        policy_version:$policy_version}' >"$candidate" ||
      ! chmod 600 "$candidate" || ! mv -f "$candidate" "$root/sync-marker.json"; then
    rm -f -- "$candidate"
    return 1
  fi
}

write_grok_configuration() {
  local grok_home="$1" config_path sandbox_path config_candidate sandbox_candidate
  config_path="$grok_home/config.toml"
  sandbox_path="$grok_home/sandbox.toml"
  config_candidate="$(mktemp "$grok_home/.config.toml.delegation-grok.XXXXXX")" || return 1
  sandbox_candidate="$(mktemp "$grok_home/.sandbox.toml.delegation-grok.XXXXXX")" || {
    rm -f -- "$config_candidate"
    return 1
  }
  cat >"$config_candidate" <<'EOF'
[compat.claude]
skills = false
rules = false
agents = false
mcps = false
hooks = false
sessions = false

[compat.cursor]
skills = false
rules = false
agents = false
mcps = false
hooks = false
sessions = false

[compat.codex]
sessions = false

[workflows]
enabled = false
EOF
  cat >"$sandbox_candidate" <<'EOF'
[profiles.delegation-kit]
extends = "strict"
restrict_network = true

[profiles.delegation-kit-read-only]
extends = "read-only"
restrict_network = true
EOF
  if ! chmod 600 "$config_candidate" "$sandbox_candidate" ||
      ! mv -f "$config_candidate" "$config_path" ||
      ! mv -f "$sandbox_candidate" "$sandbox_path"; then
    rm -f -- "$config_candidate" "$sandbox_candidate"
    return 1
  fi
}

prepare_run_sandbox_profile() {
  local base_profile="$1" sandbox_path candidate lock_rc=0
  [ -n "$ACTIVE_GROK_HOME" ] || return 1
  sandbox_path="$ACTIVE_GROK_HOME/sandbox.toml"
  [ -f "$sandbox_path" ] && [ ! -L "$sandbox_path" ] || return 1
  acquire_oauth_lock_wait || lock_rc=$?
  [ "$lock_rc" -eq 0 ] || return "$lock_rc"
  RUN_SANDBOX_PROFILE="delegation-kit-run-$$-$(date +%s)"
  candidate="$(mktemp "$ACTIVE_GROK_HOME/.sandbox.toml.run.XXXXXX")" || {
    release_oauth_lock
    return 1
  }
  if ! cp "$sandbox_path" "$candidate" ||
      ! printf '\n[profiles.%s]\nextends = "%s"\nrestrict_network = true\n' \
        "$RUN_SANDBOX_PROFILE" "$base_profile" >>"$candidate" ||
      ! chmod 600 "$candidate" || ! mv -f "$candidate" "$sandbox_path"; then
    rm -f -- "$candidate"
    release_oauth_lock
    return 1
  fi
  release_oauth_lock
}

# Adopt one persistent Grok state generation. The kit lock is held only while
# selecting or creating the generation; concurrent children then use the same
# GROK_HOME, including the vendor's auth.json.lock, so only token refresh is
# serialized. An external `grok login` changes the ambient hash and therefore
# forces a new generation instead of being overwritten by an older run.
seed_shared_oauth() {
  local root marker marker_generation="" marker_sha="" marker_policy=""
  local ambient_hash generation gen_dir stale lock_rc=0
  root="$(shared_oauth_root)"
  if [ -L "$root" ]; then
    GROK_REASON="shared Grok OAuth root must not be a symlink"
    return 69
  fi
  if ! mkdir -p "$root" || ! chmod 700 "$root"; then
    GROK_REASON="could not create the shared Grok OAuth root"
    return 69
  fi
  acquire_oauth_lock_wait || lock_rc=$?
  if [ "$lock_rc" -eq 2 ]; then
    GROK_REASON="another Grok invocation is updating OAuth state; retry after it finishes"
    return 75
  elif [ "$lock_rc" -ne 0 ]; then
    GROK_REASON="could not secure the Grok OAuth credential"
    return 69
  fi
  if ! ambient_hash="$(file_digest "$SOURCE_GROK_HOME/auth.json")"; then
    GROK_REASON="could not fingerprint the ambient Grok OAuth credential"
    release_oauth_lock
    return 69
  fi
  if marker="$(read_shared_marker)"; then
    marker_generation="${marker%% *}"
    marker="${marker#* }"
    marker_sha="${marker%% *}"
    marker_policy="${marker##* }"
  fi
  if [ -n "$marker_generation" ] && [ "$marker_sha" = "$ambient_hash" ] &&
      [ "$marker_policy" = "$SHARED_POLICY_VERSION" ] &&
      [ ! -L "$root/$marker_generation" ] &&
      credential_tokens_valid "$root/$marker_generation/auth.json" &&
      [ -f "$root/$marker_generation/config.toml" ] &&
      [ -f "$root/$marker_generation/sandbox.toml" ]; then
    SHARED_OAUTH_GEN="$marker_generation"
  else
    generation="gen-$(date +%s)-$$"
    gen_dir="$root/$generation"
    if [ -e "$gen_dir" ] || [ -L "$gen_dir" ]; then
      GROK_REASON="shared Grok OAuth generation path already exists"
      release_oauth_lock
      return 69
    fi
    if ! mkdir -p "$gen_dir" || ! chmod 700 "$gen_dir"; then
      GROK_REASON="could not create a shared Grok OAuth generation"
      release_oauth_lock
      return 69
    fi
    if ! cp "$SOURCE_GROK_HOME/auth.json" "$gen_dir/auth.json" ||
        ! chmod 600 "$gen_dir/auth.json" ||
        ! write_grok_configuration "$gen_dir"; then
      GROK_REASON="could not seed the shared Grok OAuth generation"
      release_oauth_lock
      return 69
    fi
    if ! write_shared_marker "$generation" "$ambient_hash"; then
      GROK_REASON="could not record the shared Grok OAuth generation"
      release_oauth_lock
      return 69
    fi
    SHARED_OAUTH_GEN="$generation"
  fi
  # Keep the active generation plus the one it immediately superseded. A peer
  # may still be finishing on that predecessor; older generations are dead
  # credential copies and must not accumulate at rest.
  for stale in "$root"/gen-*; do
    [ -d "$stale" ] && [ ! -L "$stale" ] || continue
    case "$(basename "$stale")" in
      "$SHARED_OAUTH_GEN"|"$marker_generation") ;;
      *) rm -rf -- "$stale" ;;
    esac
  done
  release_oauth_lock
  if ! SHARED_OAUTH_DIR="$(cd "$root/$SHARED_OAUTH_GEN" && pwd -P)"; then
    GROK_REASON="could not resolve the shared Grok OAuth generation"
    return 69
  fi
  return 0
}

# Publish a rotated shared credential back to the ambient login using optimistic
# concurrency. Return 2 when an external login superseded this generation and 3
# when publication is deferred because another short bookkeeping lock is busy.
publish_shared_oauth() {
  local marker marker_generation marker_sha marker_policy shared_credential shared_hash
  local ambient_hash target_dir candidate lock_rc=0 rc=0
  shared_credential="$SHARED_OAUTH_DIR/auth.json"
  acquire_oauth_lock_wait || lock_rc=$?
  [ "$lock_rc" -ne 2 ] || return 3
  [ "$lock_rc" -eq 0 ] || return 1
  if ! marker="$(read_shared_marker)"; then
    rc=1
  else
    marker_generation="${marker%% *}"
    marker="${marker#* }"
    marker_sha="${marker%% *}"
    marker_policy="${marker##* }"
    if [ "$marker_generation" != "$SHARED_OAUTH_GEN" ]; then
      rc=2
    elif [ "$marker_policy" != "$SHARED_POLICY_VERSION" ]; then
      rc=2
    elif ! shared_hash="$(file_digest "$shared_credential")"; then
      rc=1
    elif [ "$shared_hash" = "$marker_sha" ]; then
      rc=0
    elif ! credential_tokens_valid "$shared_credential"; then
      rc=1
    elif [ ! -f "$SOURCE_GROK_HOME/auth.json" ] || [ -L "$SOURCE_GROK_HOME/auth.json" ]; then
      rc=2
    elif ! ambient_hash="$(file_digest "$SOURCE_GROK_HOME/auth.json")"; then
      rc=1
    elif [ "$ambient_hash" != "$marker_sha" ]; then
      rc=2
    else
      target_dir="$SOURCE_GROK_HOME"
      candidate="$(mktemp "$target_dir/.auth.json.delegation-grok.XXXXXX")" || rc=1
      if [ "$rc" -eq 0 ]; then
        if cp "$shared_credential" "$candidate" && chmod 600 "$candidate" &&
            mv -f "$candidate" "$SOURCE_GROK_HOME/auth.json"; then
          write_shared_marker "$SHARED_OAUTH_GEN" "$shared_hash" || rc=1
        else
          rm -f -- "$candidate"
          rc=1
        fi
      fi
    fi
  fi
  release_oauth_lock
  return "$rc"
}

sync_serialized_oauth() {
  local scratch_credential="$ACTIVE_GROK_HOME/auth.json"
  local scratch_hash current_hash candidate
  [ -f "$scratch_credential" ] && [ ! -L "$scratch_credential" ] || return 1
  scratch_hash="$(file_digest "$scratch_credential")" || return 1
  [ "$scratch_hash" != "$OAUTH_BASELINE_HASH" ] || return 0
  credential_tokens_valid "$scratch_credential" || return 1
  [ -f "$SOURCE_GROK_HOME/auth.json" ] && [ ! -L "$SOURCE_GROK_HOME/auth.json" ] || return 2
  current_hash="$(file_digest "$SOURCE_GROK_HOME/auth.json")" || return 1
  [ "$current_hash" = "$OAUTH_BASELINE_HASH" ] || return 2
  candidate="$(mktemp "$SOURCE_GROK_HOME/.auth.json.delegation-grok.XXXXXX")" || return 1
  if ! cp "$scratch_credential" "$candidate" || ! chmod 600 "$candidate" ||
      ! mv -f "$candidate" "$SOURCE_GROK_HOME/auth.json"; then
    rm -f -- "$candidate"
    return 1
  fi
}

observed_cli_version() {
  local bin="$1" probe_home="$2" version
  version="$(HOME="$probe_home" GROK_HOME="$probe_home/.grok" \
    "$bin" --version 2>/dev/null | head -1 || true)"
  if [[ "$version" =~ ^grok[[:space:]]+([^[:space:]]+) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  elif [ -n "$version" ]; then
    printf '%s\n' "$version"
  else
    printf 'unknown\n'
  fi
}

supports_required_interface() {
  local bin="$1" probe_home="$2" help inspect_help command_name
  help="$(HOME="$probe_home" GROK_HOME="$probe_home/.grok" "$bin" --help 2>&1 || true)"
  # Parse the complete dispatch surface under `--help`. This catches removed or
  # renamed flags without starting a session, including hidden compatibility
  # flags that may not be printed in the top-level help.
  HOME="$probe_home" GROK_HOME="$probe_home/.grok" "$bin" \
    --prompt-file /dev/null \
    --model "$RUNTIME_MODEL" --reasoning-effort high \
    --permission-mode dontAsk --sandbox "$SANDBOX_PROFILE" \
    --output-format json --no-memory --no-subagents \
    --disable-web-search --no-auto-update \
    --tools 'grep,read_file,search_replace,list_dir,todo_write' \
    --allow 'Edit(**)' --max-turns "$MAX_TURNS" \
    --deny 'Edit(**/.grok/config.toml)' \
    --deny 'Edit(**/.grok/sandbox.toml)' \
    --deny 'Edit(**/.grok/auth.json)' \
    --help >/dev/null 2>&1 || return 1
  for command_name in models inspect; do
    grep -Eq "^[[:space:]]+$command_name([[:space:]]|$)" <<<"$help" || return 1
    HOME="$probe_home" GROK_HOME="$probe_home/.grok" \
      "$bin" "$command_name" --help >/dev/null 2>&1 || return 1
  done
  inspect_help="$(HOME="$probe_home" GROK_HOME="$probe_home/.grok" \
    "$bin" inspect --help 2>&1 || true)"
  grep -q -- '--json' <<<"$inspect_help"
}

verify_archived_bin() {
  local candidate="$1" digest_file expected actual
  [ -x "$candidate" ] && [ ! -L "$candidate" ] || return 1
  digest_file="$candidate.sha256"
  [ -r "$digest_file" ] || return 1
  expected="$(cut -d' ' -f1 <"$digest_file")"
  actual="$(file_digest "$candidate")" || return 1
  [ -n "$expected" ] && [ "$actual" = "$expected" ]
}

# Resolution order: explicit override, private archive, ambient PATH. The archive
# store is what makes a vendor auto-update a non-event: it is a private copy
# the updater cannot see, prune, or replace.
resolve_grok_bin() {
  local probe_home="$1" candidate="" pinned legacy
  GROK_BIN=""
  GROK_BIN_SOURCE="none"
  mkdir -p "$probe_home"
  if [ -n "${DELEGATION_GROK_BIN:-}" ]; then
    [ -x "${DELEGATION_GROK_BIN}" ] \
      || { GROK_REASON="DELEGATION_GROK_BIN is not an executable file: $DELEGATION_GROK_BIN"; return 1; }
    candidate="$DELEGATION_GROK_BIN"
    GROK_BIN_SOURCE="override"
  else
    pinned="$(pinned_bin_path)"
    if [ -x "$pinned" ] && [ ! -L "$pinned" ]; then
      [ -r "$(pinned_digest_path)" ] \
        || { GROK_REASON="pinned Grok Build CLI has no recorded digest; re-run: delegation-grok pin --force"; return 1; }
      file_digest "$pinned" >/dev/null \
        || { GROK_REASON="shasum or sha256sum is required to verify the pinned Grok Build CLI"; return 1; }
      verify_archived_bin "$pinned" \
        || { GROK_REASON="pinned Grok Build CLI digest mismatch; re-run: delegation-grok pin --force"; return 1; }
      candidate="$pinned"
      GROK_BIN_SOURCE="pinned"
    else
      # Pre-capability-gate releases stored archives under a version-named
      # directory. Resolve any digest-valid, interface-compatible legacy copy
      # when `current/` and PATH are absent; install.sh will then migrate it.
      for legacy in "$GROK_BIN_STORE"/*/grok; do
        [ "$legacy" != "$pinned" ] || continue
        if verify_archived_bin "$legacy" &&
          supports_required_interface "$legacy" "$probe_home"; then
          candidate="$legacy"
          GROK_BIN_SOURCE="legacy"
          break
        fi
      done
      if [ -z "$candidate" ] && have grok; then
        candidate="$(command -v grok)"
        GROK_BIN_SOURCE="path"
      fi
      if [ -z "$candidate" ]; then
        GROK_REASON="no compatible archived Grok Build CLI and grok is not on PATH; run: delegation-grok pin"
        return 1
      fi
    fi
  fi
  supports_required_interface "$candidate" "$probe_home" || {
    GROK_REASON="Grok Build CLI lacks the required interface (resolved from $GROK_BIN_SOURCE: $candidate)"
    GROK_BIN_SOURCE="none"
    return 1
  }
  GROK_BIN="$candidate"
  GROK_CLI_VERSION="$(observed_cli_version "$candidate" "$probe_home")"
}

timeout_bin() {
  if have timeout; then
    command -v timeout
  elif have gtimeout; then
    command -v gtimeout
  else
    return 1
  fi
}

prepare_isolated_home() {
  local isolated_home="$1" oauth_mode="${2:-serialized}"
  [ -r "$SOURCE_GROK_HOME/auth.json" ] || {
    GROK_REASON="Grok Build credentials missing; run: grok login"
    return 1
  }
  mkdir -p "$isolated_home" && chmod 700 "$isolated_home"
  if [ "$oauth_mode" = shared ]; then
    if [ -z "$SHARED_OAUTH_DIR" ] ||
        ! credential_tokens_valid "$SHARED_OAUTH_DIR/auth.json"; then
      GROK_REASON="shared Grok OAuth generation is unavailable"
      return 1
    fi
    ACTIVE_GROK_HOME="$SHARED_OAUTH_DIR"
  else
    ACTIVE_GROK_HOME="$isolated_home/.grok"
    mkdir -p "$ACTIVE_GROK_HOME"
    cp "$SOURCE_GROK_HOME/auth.json" "$ACTIVE_GROK_HOME/auth.json"
    chmod 600 "$ACTIVE_GROK_HOME/auth.json"
    write_grok_configuration "$ACTIVE_GROK_HOME"
  fi
}

inspect_isolation() {
  local isolated_home="$1" inspect_file="$2" inspect_workdir="${3:-$PWD}"
  (cd "$inspect_workdir" && HOME="$isolated_home" GROK_HOME="$ACTIVE_GROK_HOME" \
    "$GROK_BIN" inspect --json) \
    >"$inspect_file" 2>/dev/null || {
    GROK_REASON="Grok Build isolation inspection failed"
    return 1
  }
  jq -e '
    (.mcpServers | length) == 0 and
    (.plugins | length) == 0 and
    (.permissions.sources | length) == 0 and
    (.hooks | length) == 0
  ' "$inspect_file" >/dev/null 2>&1 || {
    GROK_REASON="Grok Build isolation is contaminated by plugins, MCP, permissions, or hooks"
    return 1
  }
}

sandbox_attested_for_run() {
  local events_file="$1" profile="$2" workspace="$3" event
  [ -f "$events_file" ] || return 1
  while IFS= read -r event || [ -n "$event" ]; do
    jq -e --arg profile "$profile" --arg workspace "$workspace" '
      .event_type == "ProfileApplied" and .profile == $profile and
      .enforced == true and .workspace == $workspace
    ' <<<"$event" >/dev/null 2>&1 && return 0
  done <"$events_file"
  return 1
}


# Grok Build's sandbox denies these container runtime sockets in every profile,
# built-in or custom, and resolves each endpoint before applying Seatbelt. Since
# 1.0.13 a symlinked endpoint (Docker Desktop's optional /var/run/docker.sock
# link is the common case) makes that resolution fail; a built-in profile then
# continues without a sandbox, but a custom profile such as delegation-kit is
# refused outright: "could not apply the 'delegation-kit' sandbox profile ...
# Refusing to start with its protections missing." The kit never runs Grok
# without its attested sandbox, so the lane is unavailable on such a machine.
# The list mirrors the CLI's own deny table; tests override it.
RUNTIME_SOCKET_ENDPOINTS="${DELEGATION_GROK_RUNTIME_SOCKET_ENDPOINTS-/var/run/docker.sock:/run/docker.sock:/run/podman/podman.sock:/var/run/podman/podman.sock:/run/containerd/containerd.sock:/var/run/containerd/containerd.sock:$HOME/.docker/run/docker.sock:$HOME/.docker/desktop/docker.sock}"
symlinked_runtime_socket() {
  local endpoint
  local IFS=:
  for endpoint in $RUNTIME_SOCKET_ENDPOINTS; do
    [ -n "$endpoint" ] || continue
    if [ -L "$endpoint" ]; then printf '%s' "$endpoint"; return 0; fi
  done
  return 1
}
sandbox_profile_refused() {
  grep -Eqi 'sandbox could not be applied|could not apply the .* sandbox profile|runtime-socket deny resolution failed' "$1"
}

runtime_status() {
  local oauth_mode="${1:-serialized}"
  GROK_REASON=""
  have jq || { GROK_REASON="jq is required"; return 1; }
  timeout_bin >/dev/null || { GROK_REASON="timeout or gtimeout is required"; return 1; }
  [[ "$TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] \
    || { GROK_REASON="DELEGATION_GROK_TIMEOUT_SECONDS must be a positive integer"; return 1; }
  local models status_tmp lock_rc=0 sync_rc=0 seed_rc=0 symlinked_socket
  status_tmp="$(mktemp -d "${TMPDIR:-/tmp}/delegation-grok-status.XXXXXX")"
  resolve_grok_bin "$status_tmp/probe" || { rm -rf -- "$status_tmp"; return 1; }
  if symlinked_socket="$(symlinked_runtime_socket)"; then
    rm -rf -- "$status_tmp"
    GROK_REASON="Grok Build refuses the custom delegation-kit sandbox while runtime-socket deny endpoint $symlinked_socket is a symlink; point it at the real socket or remove the link (Docker Desktop: disable the default socket), then re-run check"
    return 1
  fi
  if [ "$oauth_mode" = shared ]; then
    seed_shared_oauth || seed_rc=$?
    if [ "$seed_rc" -ne 0 ]; then
      rm -rf -- "$status_tmp"
      return 1
    fi
    prepare_isolated_home "$status_tmp/home" shared \
      || { rm -rf -- "$status_tmp"; return 1; }
  else
    acquire_oauth_lock_wait || lock_rc=$?
    if [ "$lock_rc" -eq 2 ]; then
      rm -rf -- "$status_tmp"
      GROK_REASON="another Grok invocation is using the OAuth refresh session"
      return 1
    elif [ "$lock_rc" -ne 0 ]; then
      rm -rf -- "$status_tmp"
      GROK_REASON="could not secure the Grok OAuth credential"
      return 1
    fi
    prepare_isolated_home "$status_tmp/home" serialized \
      || { rm -rf -- "$status_tmp"; release_oauth_lock; return 1; }
    OAUTH_BASELINE_HASH="$(file_digest "$ACTIVE_GROK_HOME/auth.json")" \
      || { rm -rf -- "$status_tmp"; release_oauth_lock; GROK_REASON="could not fingerprint Grok OAuth state"; return 1; }
  fi
  models="$(HOME="$status_tmp/home" GROK_HOME="$ACTIVE_GROK_HOME" "$GROK_BIN" models 2>&1)" || {
    if [ "$oauth_mode" = shared ]; then publish_shared_oauth >/dev/null 2>&1 || true
    else sync_serialized_oauth >/dev/null 2>&1 || true
    fi
    release_oauth_lock
    rm -rf -- "$status_tmp"
    GROK_REASON="Grok Build model inventory unavailable; run: grok login"
    return 1
  }
  if [ "$oauth_mode" = shared ]; then publish_shared_oauth || sync_rc=$?
  else sync_serialized_oauth || sync_rc=$?
  fi
  release_oauth_lock
  if [ "$sync_rc" -eq 2 ]; then
    rm -rf -- "$status_tmp"
    GROK_REASON="Grok OAuth changed during status inspection; retry"
    return 1
  elif [ "$sync_rc" -ne 0 ] && [ "$sync_rc" -ne 3 ]; then
    rm -rf -- "$status_tmp"
    GROK_REASON="Grok OAuth refresh could not be persisted"
    return 1
  fi
  grep -Fq "You are logged in with grok.com." <<<"$models" \
    || { rm -rf -- "$status_tmp"; GROK_REASON="Grok Build is logged out; run: grok login"; return 1; }
  awk -v model="$RUNTIME_MODEL" '{for(i=1;i<=NF;i++) if($i==model) found=1} END {exit !found}' <<<"$models" \
    || { rm -rf -- "$status_tmp"; GROK_REASON="Grok Build does not expose required model $RUNTIME_MODEL"; return 1; }
  inspect_isolation "$status_tmp/home" "$status_tmp/inspect.json" \
    || { rm -rf -- "$status_tmp"; return 1; }
  rm -rf -- "$status_tmp"
  GROK_REASON="ready"
}


is_allowed() {
  local role="$1" candidate
  for candidate in $ROLES; do [ "$candidate" != "$role" ] || return 0; done
  return 1
}

default_effort() {
  printf '%s\n' "${DELEGATION_PROFILE_EFFORT:-high}"
}

print_check() {
  local as_json="${1:-0}" available=false selected="none" roles
  local oauth_mode="${DELEGATION_GROK_OAUTH_MODE:-serialized}"
  case "$oauth_mode" in serialized|shared) ;; *) die 64 "invalid OAuth mode: $oauth_mode" ;; esac
  have jq || die 69 "jq is required"
  OAUTH_MODE="$oauth_mode"
  runtime_status "$oauth_mode" && available=true || true
  roles="$(printf '%s\n' $ROLES | jq -R . | jq -sc .)"
  [ "$available" = true ] && selected="$BACKEND"
  if [ "$as_json" = 1 ]; then
    jq -n --arg model "$MODEL" --arg runtime_model "$RUNTIME_MODEL" \
      --arg usage_model "$USAGE_MODEL" --arg selected "$selected" \
      --argjson available "$available" --arg reason "$GROK_REASON" \
      --argjson efforts "$EFFORTS" --argjson roles "$roles" \
      --arg adapter "$ADAPTER" --arg cli_version "$GROK_CLI_VERSION" \
      --arg cli_compatibility "$CLI_COMPATIBILITY" \
      --arg cli_source "$GROK_BIN_SOURCE" --arg cli_path "$GROK_BIN" \
      --arg sandbox "$SANDBOX_PROFILE" --argjson max_turns "$MAX_TURNS" \
      --argjson timeout_seconds "$TIMEOUT_SECONDS" --arg oauth_mode "$oauth_mode" \
      '{model:$model,adapter:$adapter,runtime_model:$runtime_model,usage_model:$usage_model,
        runtime_cli_version:$cli_version,runtime_cli_compatibility:$cli_compatibility,
        runtime_cli_source:$cli_source,
        runtime_cli_path:(if $cli_path == "" then null else $cli_path end),
        roles:$roles,efforts:$efforts,selected_backend:$selected,
        backends:{"grok-build":{
          available:$available,reason:$reason,efforts:["high"],
          sandbox:$sandbox,permission_mode:"dontAsk",
          oauth_modes:["serialized","shared"],oauth_mode:$oauth_mode,
          runtime_home_isolated:true,
          grok_home_mode:(if $oauth_mode == "shared" then "shared-generation" else "isolated-copy" end),
          credential_state_shared:($oauth_mode == "shared"),
          max_turns:$max_turns,timeout_seconds:$timeout_seconds,
          isolated_home:true,plugins:false,mcp:false,terminal:false}}}'
  else
    printf 'Grok 4.6: selected=%s roles=%s efforts=high\n' "$selected" "$(printf '%s' "$ROLES" | tr ' ' ',')"
    printf '  grok-build: %s (%s; model=%s; cli=%s from %s; effort=high; oauth=%s; sandbox=%s; max-turns=%s; timeout=%ss)\n' \
      "$available" "$GROK_REASON" "$RUNTIME_MODEL" "$GROK_CLI_VERSION" \
      "$GROK_BIN_SOURCE" "$oauth_mode" "$SANDBOX_PROFILE" "$MAX_TURNS" "$TIMEOUT_SECONDS"
  fi
}

auth_failure() {
  grep -Eqi 'not logged in|logged out|login required|unauthorized|authentication|invalid token|status.?401' "$1"
}

temporary_failure() {
  grep -Eqi 'rate.?limit|too many requests|usage limit|quota|temporar.*unavailable|status.?429' "$1"
}

extract_result() {
  local response="$1" output="$2" metrics="$3" started="$4" lane="$5"
  local sandbox="$6" timeout_seconds="$7"
  jq -e --arg usage_model "$USAGE_MODEL" '
    (.text | type == "string" and length > 0) and
    (.stopReason == "EndTurn" or .stopReason == "end_turn") and
    (.modelUsage[$usage_model] | type == "object")
  ' "$response" >/dev/null 2>&1 || return 1
  jq -r '.text' "$response" >"$output" || return 1
  jq -e --arg model "$MODEL" --arg runtime_model "$RUNTIME_MODEL" \
    --arg usage_model "$USAGE_MODEL" --arg lane "$lane" --argjson started "$started" '
    . as $r |
    ($r.modelUsage // {}) as $usage |
    ($usage | to_entries | map({
      model:.key,
      input_tokens:(.value.inputTokens // 0),
      output_tokens:(.value.outputTokens // 0),
      cache_read_tokens:(.value.cacheReadInputTokens // 0),
      model_calls:(.value.modelCalls // 0),
      cost_usd:(.value.costUSD // 0)
    })) as $participants |
    ($participants | map(.input_tokens) | add // 0) as $input |
    ($participants | map(.output_tokens) | add // 0) as $output |
    ($participants | map(.cache_read_tokens) | add // 0) as $cache_read |
    ($participants | map(.cost_usd) | add // 0) as $cost |
    ($r.usage.reasoning_tokens // 0) as $reasoning |
    {model:$model,requested_model:$model,runtime_model:$runtime_model,
     effective_content_model:(if (($r.model | type) == "string" and ($r.model | length) > 0) then $r.model else null end),
     schema_version:3,provider_reported_model:($r.model // null),model_identity_source:(if ($r.model // "") == "" then "requested-only" else "provider-reported" end),
     exact_model_identity_attested:(($r.model // null) == $runtime_model),
     usage_model:$usage_model,
     target_usage_participant_present:(($usage[$usage_model] | type) == "object"),
     usage_participants:$participants,
     backend:"grok-build",effort:"high",lane:$lane,
     runtime_cli_version:$cli_version,runtime_cli_compatibility:$cli_compatibility,
     runtime_cli_source:$cli_source,
     sandbox:$sandbox,permission_mode:"dontAsk",
     oauth_mode:$oauth_mode,oauth_sync:$oauth_sync,
     isolated_home:true,runtime_home_isolated:true,
     grok_home_mode:(if $oauth_mode == "shared" then "shared-generation" else "isolated-copy" end),
     credential_state_shared:($oauth_mode == "shared"),
     plugins:false,mcp:false,
     terminal:false,
     max_turns:$max_turns,timeout_seconds:$timeout_seconds,
     started_at_epoch:$started,finished_at_epoch:now,
     duration_seconds:(now-$started),stop_reason:($r.stopReason // null),
     turns:($r.num_turns // null),
     tokens:{input:$input,output:$output,reasoning:$reasoning,
       cache_read:$cache_read,total:($input+$output+$reasoning+$cache_read)},
     provider_cost_usd:$cost}
  ' --arg cli_version "$GROK_CLI_VERSION" --arg cli_compatibility "$CLI_COMPATIBILITY" \
    --arg cli_source "$GROK_BIN_SOURCE" \
    --arg sandbox "$sandbox" --arg oauth_mode "$OAUTH_MODE" \
    --arg oauth_sync "$OAUTH_SYNC_STATUS" \
    --argjson max_turns "$MAX_TURNS" --argjson timeout_seconds "$timeout_seconds" \
    "$response" >"$metrics"
}

write_diagnostic() {
  local path="$1" phase="$2" reason="$3" rc="$4" started="$5"
  local response="$6" stderr_file="$7" debug_path="$8" finished
  finished="$(date +%s)"
  jq -n --arg model "$MODEL" --arg runtime_model "$RUNTIME_MODEL" \
    --arg cli_version "$GROK_CLI_VERSION" --arg lane "$lane" \
    --arg cli_compatibility "$CLI_COMPATIBILITY" \
    --arg oauth_mode "$OAUTH_MODE" --arg oauth_sync "$OAUTH_SYNC_STATUS" \
    --arg phase "$phase" --arg reason "$reason" --argjson rc "$rc" \
    --argjson started "$started" --argjson finished "$finished" \
    --argjson stdout_bytes "$(wc -c <"$response" | tr -d ' ')" \
    --argjson stderr_bytes "$(wc -c <"$stderr_file" | tr -d ' ')" \
    --arg debug_path "$debug_path" '
    {model:$model,runtime_model:$runtime_model,runtime_cli_version:$cli_version,
     runtime_cli_compatibility:$cli_compatibility,
     backend:"grok-build",effort:"high",lane:$lane,phase:$phase,reason:$reason,
     oauth_mode:$oauth_mode,oauth_sync:$oauth_sync,
     grok_home_mode:(if $oauth_mode == "shared" then "shared-generation" else "isolated-copy" end),
     cli_exit_code:$rc,started_at_epoch:$started,finished_at_epoch:$finished,
     duration_seconds:($finished-$started),
     captured_bytes:{stdout:$stdout_bytes,stderr:$stderr_bytes},
     debug_path:(if $debug_path == "" then null else $debug_path end)}
  ' >"$path"
}

preserve_debug() {
  local debug_dir="$1" response="$2" stderr_file="$3"
  [ -n "$debug_dir" ] || return 0
  DEBUG_PATH="$(mktemp -d "$debug_dir/delegation-grok.XXXXXX")"
  cp "$response" "$DEBUG_PATH/response.json"
  cp "$stderr_file" "$DEBUG_PATH/stderr.txt"
  chmod 700 "$DEBUG_PATH"
  chmod 600 "$DEBUG_PATH/response.json" "$DEBUG_PATH/stderr.txt"
}

run_command() {
  local lane="" effort="auto" backend="auto" prompt_file="" output="" workdir="" metrics="" debug_dir=""
  local oauth_mode="${DELEGATION_GROK_OAUTH_MODE:-serialized}"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --lane) lane="${2:-}"; shift 2 ;;
      --effort) effort="${2:-}"; shift 2 ;;
      --backend) backend="${2:-}"; shift 2 ;;
      --prompt-file) prompt_file="${2:-}"; shift 2 ;;
      --output) output="${2:-}"; shift 2 ;;
      --workdir) workdir="${2:-}"; shift 2 ;;
      --metrics) metrics="${2:-}"; shift 2 ;;
      --debug-dir) debug_dir="${2:-}"; shift 2 ;;
      --oauth) oauth_mode="${2:-}"; shift 2 ;;
      --allow-provisional) printf "%s\n" "--allow-provisional is deprecated and has no effect" >&2; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die 64 "unknown run argument: $1" ;;
    esac
  done
  [ -n "$lane" ] || die 64 "--lane is required"
  case "$effort" in auto|high) ;; *) die 64 "invalid effort: $effort" ;; esac
  case "$backend" in auto|grok-build) ;; *) die 64 "invalid backend: $backend" ;; esac
  case "$oauth_mode" in serialized|shared) ;; *) die 64 "invalid OAuth mode: $oauth_mode" ;; esac
  OAUTH_MODE="$oauth_mode"
  [ -f "$prompt_file" ] || die 64 "prompt file missing: $prompt_file"
  [ -s "$prompt_file" ] || die 64 "prompt file must not be empty"
  [ -d "$workdir" ] || die 64 "workdir missing: $workdir"
  [ -z "$debug_dir" ] || [ -d "$debug_dir" ] || die 64 "debug directory missing: $debug_dir"
  [ -n "$output" ] || die 64 "--output is required"
  have jq || die 69 "jq is required"
  is_allowed "$lane" || die 78 "unsupported role for $ADAPTER: $lane"
  [ "$effort" != auto ] || effort="$(default_effort)"
  [ "$effort" = high ] || die 78 "lane '$lane' supports only effort 'high'"
  RUN_TMP="$(mktemp -d "${TMPDIR:-/tmp}/delegation-grok.XXXXXX")"
  cp -- "$prompt_file" "$RUN_TMP/prompt.txt" \
    || die 70 "could not snapshot prompt into runner-owned storage"
  runtime_status "$oauth_mode" || die 69 "$GROK_REASON"

  workdir="$(cd "$workdir" && pwd -P)"
  metrics="${metrics:-$output.metrics.json}"
  local output_parent metrics_parent output_name metrics_name diagnostic
  output_parent="$(dirname "$output")"; metrics_parent="$(dirname "$metrics")"
  output_name="$(basename "$output")"; metrics_name="$(basename "$metrics")"
  [ -d "$output_parent" ] || die 64 "output parent directory must already exist: $output_parent"
  [ -d "$metrics_parent" ] || die 64 "metrics parent directory must already exist: $metrics_parent"
  output="$(cd "$output_parent" && pwd -P)/$output_name"
  metrics="$(cd "$metrics_parent" && pwd -P)/$metrics_name"
  [ -z "$debug_dir" ] || debug_dir="$(cd "$debug_dir" && pwd -P)"
  diagnostic="$output.error.json"
  [ "$output" != "$metrics" ] || die 64 "output and metrics paths resolve to the same file"
  [ ! -e "$output" ] && [ ! -L "$output" ] || die 64 "output already exists or is a symlink"
  [ ! -e "$metrics" ] && [ ! -L "$metrics" ] || die 64 "metrics already exists or is a symlink"
  [ ! -e "$diagnostic" ] && [ ! -L "$diagnostic" ] || die 64 "diagnostic already exists or is a symlink"
  if [ "$lane" = policy-annotation ]; then
    case "$output" in "$workdir"/*) die 64 "policy-annotation output must be outside workdir" ;; esac
    case "$metrics" in "$workdir"/*) die 64 "policy-annotation metrics must be outside workdir" ;; esac
    case "$diagnostic" in "$workdir"/*) die 64 "policy-annotation diagnostic must be outside workdir" ;; esac
    if [ -n "$debug_dir" ]; then case "$debug_dir" in "$workdir"|"$workdir"/*) die 64 "policy-annotation debug directory must be outside workdir" ;; esac; fi
  fi

  # Isolation attestation is workdir-bound: project configuration under the
  # workdir can enable surfaces the isolated home alone forbids. Prepare and
  # inspect it here; the dispatch below reuses this prepared state.
  local lock_rc=0 sync_rc=0 seed_rc=0
  if [ "$oauth_mode" = shared ]; then
    seed_shared_oauth || seed_rc=$?
    [ "$seed_rc" -eq 0 ] || die "$seed_rc" "$GROK_REASON"
    prepare_isolated_home "$RUN_TMP/home" shared || die 69 "$GROK_REASON"
  else
    acquire_oauth_lock_wait || lock_rc=$?
    if [ "$lock_rc" -eq 2 ]; then
      die 75 "another Grok invocation is using the OAuth refresh session; retry after it finishes"
    elif [ "$lock_rc" -ne 0 ]; then
      die 69 "could not secure the Grok OAuth credential"
    fi
    prepare_isolated_home "$RUN_TMP/home" serialized || die 69 "$GROK_REASON"
    OAUTH_BASELINE_HASH="$(file_digest "$ACTIVE_GROK_HOME/auth.json")" \
      || die 69 "could not fingerprint isolated Grok OAuth state"
  fi
  inspect_isolation "$RUN_TMP/home" "$RUN_TMP/inspect.json" "$workdir" || die 69 "$GROK_REASON"

  local response result_tmp metrics_tmp stderr_file rc=0 started timer reason phase
  local sandbox_events sandbox_event_start=0 sandbox_events_run
  local DEBUG_PATH=""
  response="$RUN_TMP/response.json"; result_tmp="$RUN_TMP/result.txt"
  metrics_tmp="$RUN_TMP/metrics.json"; stderr_file="$RUN_TMP/stderr.txt"
  timer="$(timeout_bin)" || die 69 "timeout or gtimeout is required"
  started="$(date +%s)"
  local execution_timeout="$TIMEOUT_SECONDS"
  local execution_tools='grep,read_file,search_replace,list_dir,todo_write'
  [ "$lane" != policy-annotation ] || execution_tools='grep,read_file,list_dir'
  local execution_sandbox="$SANDBOX_PROFILE"
  [ "$lane" != policy-annotation ] || execution_sandbox="delegation-kit-read-only"
  if [ "$oauth_mode" = shared ]; then
    local profile_rc=0 profile_base="strict"
    [ "$lane" != policy-annotation ] || profile_base="read-only"
    prepare_run_sandbox_profile "$profile_base" || profile_rc=$?
    if [ "$profile_rc" -eq 2 ]; then
      die 75 "could not secure the shared Grok sandbox profile; retry"
    elif [ "$profile_rc" -ne 0 ]; then
      die 69 "could not prepare a run-owned Grok sandbox profile"
    fi
    execution_sandbox="$RUN_SANDBOX_PROFILE"
  fi
  sandbox_events="$ACTIVE_GROK_HOME/sandbox-events.jsonl"
  [ ! -f "$sandbox_events" ] || sandbox_event_start="$(wc -l <"$sandbox_events" | tr -d ' ')"
  sandbox_events_run="$RUN_TMP/sandbox-events.run.jsonl"
  local -a grok_command=("$GROK_BIN" --prompt-file "$RUN_TMP/prompt.txt" \
    --model "$RUNTIME_MODEL" --reasoning-effort high \
    --permission-mode dontAsk --sandbox "$execution_sandbox" \
    --output-format json --no-memory --no-subagents --disable-web-search --no-auto-update \
    --tools "$execution_tools")
  [ "$lane" = policy-annotation ] || grok_command+=(--allow 'Edit(**)')
  grok_command+=(
    --max-turns "$MAX_TURNS" \
    --deny 'Edit(**/.grok/config.toml)' \
    --deny 'Edit(**/.grok/sandbox.toml)' \
    --deny 'Edit(**/.grok/auth.json)' \
    --deny 'Edit(**/sandbox-events.jsonl)' \
    --deny "Edit($ACTIVE_GROK_HOME/config.toml)" \
    --deny "Edit($ACTIVE_GROK_HOME/sandbox.toml)" \
    --deny "Edit($ACTIVE_GROK_HOME/auth.json)" \
    --deny "Edit($ACTIVE_GROK_HOME/sandbox-events.jsonl)")
  (cd "$workdir" && HOME="$RUN_TMP/home" GROK_HOME="$ACTIVE_GROK_HOME" \
    "$timer" -k 10 "$execution_timeout" "${grok_command[@]}") \
    >"$response" 2>"$stderr_file" || rc=$?
  if [ "$oauth_mode" = shared ]; then publish_shared_oauth || sync_rc=$?
  else sync_serialized_oauth || sync_rc=$?
  fi
  case "$sync_rc" in
    0) OAUTH_SYNC_STATUS="ok" ;;
    2) OAUTH_SYNC_STATUS="conflict" ;;
    3) OAUTH_SYNC_STATUS="deferred" ;;
    *) OAUTH_SYNC_STATUS="failed" ;;
  esac
  release_oauth_lock
  if [ "$sync_rc" -eq 2 ]; then
    preserve_debug "$debug_dir" "$response" "$stderr_file"
    write_diagnostic "$diagnostic" "oauth-sync" "oauth_conflict" "$rc" "$started" \
      "$response" "$stderr_file" "$DEBUG_PATH"
    die 75 "Grok OAuth changed during dispatch; sanitized diagnostic: $diagnostic"
  elif [ "$sync_rc" -ne 0 ] && [ "$sync_rc" -ne 3 ]; then
    preserve_debug "$debug_dir" "$response" "$stderr_file"
    write_diagnostic "$diagnostic" "oauth-sync" "oauth_sync_failed" "$rc" "$started" \
      "$response" "$stderr_file" "$DEBUG_PATH"
    die 70 "Grok OAuth refresh could not be persisted; sanitized diagnostic: $diagnostic"
  elif [ "$sync_rc" -eq 3 ]; then
    preserve_debug "$debug_dir" "$response" "$stderr_file"
    write_diagnostic "$diagnostic" "oauth-sync" "oauth_publish_deferred" "$rc" "$started" \
      "$response" "$stderr_file" "$DEBUG_PATH"
    die 75 "Grok OAuth publication was deferred; retry after the competing invocation finishes; sanitized diagnostic: $diagnostic"
  fi
  if [ "$rc" -ne 0 ]; then
    phase="dispatch"; reason="dispatch_failed"
    [ "$rc" -ne 124 ] && [ "$rc" -ne 137 ] || reason="timeout"
    auth_failure "$stderr_file" && reason="authentication_failed"
    temporary_failure "$stderr_file" && reason="temporarily_unavailable"
    sandbox_profile_refused "$stderr_file" && reason="sandbox_profile_refused"
    preserve_debug "$debug_dir" "$response" "$stderr_file"
    write_diagnostic "$diagnostic" "$phase" "$reason" "$rc" "$started" \
      "$response" "$stderr_file" "$DEBUG_PATH"
    case "$reason" in
      authentication_failed) die 69 "Grok Build authentication failed; sanitized diagnostic: $diagnostic" ;;
      sandbox_profile_refused) die 69 "Grok Build refused to apply the delegation-kit sandbox profile (a symlinked runtime-socket deny endpoint is the known cause; see check); sanitized diagnostic: $diagnostic" ;;
      temporarily_unavailable|timeout) die 75 "Grok Build $reason; sanitized diagnostic: $diagnostic" ;;
      *) die 70 "Grok Build dispatch failed (exit $rc); sanitized diagnostic: $diagnostic" ;;
    esac
  fi
  if [ -f "$sandbox_events" ]; then
    tail -n "+$((sandbox_event_start + 1))" "$sandbox_events" >"$sandbox_events_run"
  else
    : >"$sandbox_events_run"
  fi
  sandbox_attested_for_run "$sandbox_events_run" "$execution_sandbox" "$workdir" || {
    preserve_debug "$debug_dir" "$response" "$stderr_file"
    write_diagnostic "$diagnostic" "sandbox" "sandbox_not_enforced" 0 "$started" \
      "$response" "$stderr_file" "$DEBUG_PATH"
    die 70 "Grok Build sandbox enforcement was not attested; sanitized diagnostic: $diagnostic"
  }
  # A missing content-model field is tolerated, but a separately surfaced
  # mismatch is a known silent substitution and fails every run closed.
  if jq -e '.model | type == "string" and length > 0' "$response" >/dev/null 2>&1 &&
     ! jq -e --arg runtime_model "$RUNTIME_MODEL" --argjson aliases "${DELEGATION_MODEL_ALIASES:-[]}" '.model as $m | $m == $runtime_model or ($aliases | index($m) != null)' "$response" >/dev/null 2>&1; then
    preserve_debug "$debug_dir" "$response" "$stderr_file"
    write_diagnostic "$diagnostic" "identity" "provider_identity_mismatch" 0 "$started" "$response" "$stderr_file" "$DEBUG_PATH"
    die 70 "Grok Build surfaced a different effective content model; sanitized diagnostic: $diagnostic"
  fi
  if jq -e '.stopReason == "MaxTurns" or .stopReason == "max_turns"' "$response" >/dev/null 2>&1; then
    preserve_debug "$debug_dir" "$response" "$stderr_file"
    write_diagnostic "$diagnostic" "extract" "max_turns" 0 "$started" \
      "$response" "$stderr_file" "$DEBUG_PATH"
    die 70 "Grok Build reached the maximum turn limit; sanitized diagnostic: $diagnostic"
  fi
  if jq -e '.stopReason == "Cancelled" or .stopReason == "cancelled"' "$response" >/dev/null 2>&1; then
    preserve_debug "$debug_dir" "$response" "$stderr_file"
    write_diagnostic "$diagnostic" "extract" "cancelled" 0 "$started" \
      "$response" "$stderr_file" "$DEBUG_PATH"
    die 70 "Grok Build cancelled before completing the task; sanitized diagnostic: $diagnostic"
  fi
  extract_result "$response" "$result_tmp" "$metrics_tmp" "$started" "$lane" \
    "$execution_sandbox" "$execution_timeout" \
    || {
      preserve_debug "$debug_dir" "$response" "$stderr_file"
      write_diagnostic "$diagnostic" "extract" "malformed_or_mismatched_output" 0 "$started" \
        "$response" "$stderr_file" "$DEBUG_PATH"
      die 70 "Grok Build returned malformed, empty, or mismatched output; sanitized diagnostic: $diagnostic"
    }
  if ! mv "$result_tmp" "$output"; then
    rm -f -- "$output"
    die 70 "could not finalize output"
  fi
  if ! mv "$metrics_tmp" "$metrics"; then
    rm -f -- "$output" "$metrics"
    die 70 "could not finalize metrics"
  fi
}

# Archive a capability-compatible build into a private store. A vendor auto-update
# replaces the ambient CLI and prunes its own download cache; the store is the
# copy that survives, so an update never changes which build the kit runs.
pin_command() {
  local from="" force=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --from) from="${2:-}"; shift 2 ;;
      --force) force=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die 64 "unknown pin argument: $1" ;;
    esac
  done
  have shasum || have sha256sum || die 69 "shasum or sha256sum is required"
  local candidates=() candidate found="" target digest_file digest existing probe found_version
  if [ -n "$from" ]; then
    [ -f "$from" ] && [ -x "$from" ] || die 64 "--from is not an executable file: $from"
    candidates=("$from")
  else
    [ -z "${DELEGATION_GROK_BIN:-}" ] || candidates+=("$DELEGATION_GROK_BIN")
    ! have grok || candidates+=("$(command -v grok)")
    for candidate in "$SOURCE_GROK_HOME"/downloads/*; do
      [ -f "$candidate" ] && [ -x "$candidate" ] && candidates+=("$candidate")
    done
    for candidate in "$GROK_BIN_STORE"/*/grok; do
      [ "$candidate" = "$(pinned_bin_path)" ] || {
        verify_archived_bin "$candidate" && candidates+=("$candidate")
      }
    done
  fi
  RUN_TMP="$(mktemp -d "${TMPDIR:-/tmp}/delegation-grok-pin.XXXXXX")"
  probe="$RUN_TMP/probe"
  mkdir -p "$probe"
  for candidate in ${candidates[@]+"${candidates[@]}"}; do
    if supports_required_interface "$candidate" "$probe"; then found="$candidate"; break; fi
  done
  [ -n "$found" ] || die 69 "no capability-compatible Grok Build CLI found in --from, DELEGATION_GROK_BIN, PATH, or $SOURCE_GROK_HOME/downloads"
  found_version="$(observed_cli_version "$found" "$probe")"

  target="$(pinned_bin_path)"
  digest_file="$(pinned_digest_path)"
  digest="$(file_digest "$found")" || die 70 "could not hash $found"
  if [ -e "$target" ] || [ -L "$target" ]; then
    existing="$(file_digest "$target" 2>/dev/null || true)"
    if [ "$existing" = "$digest" ] && [ -r "$digest_file" ]; then
      printf 'delegation-grok: compatible CLI already archived (%s) at %s\n' "$found_version" "$target"
      return 0
    fi
    [ "$force" = 1 ] || die 64 "a different build is already pinned at $target; pass --force to replace it"
  fi
  mkdir -p "$(dirname "$target")"
  cp -p "$found" "$target.incoming" || die 70 "could not copy $found into the pin store"
  chmod 500 "$target.incoming"
  mv -f "$target.incoming" "$target" || { rm -f "$target.incoming"; die 70 "could not finalize $target"; }
  digest="$(file_digest "$target")" || { rm -f "$target"; die 70 "could not hash the archived copy"; }
  printf '%s  grok\n' "$digest" >"$digest_file"
  chmod 400 "$digest_file"
  supports_required_interface "$target" "$probe" || {
    rm -f "$target" "$digest_file"
    die 70 "the archived copy does not expose the required interface"
  }
  printf 'delegation-grok: archived compatible Grok Build CLI %s\n  from: %s\n  to:   %s\n  sha256: %s\n' \
    "$found_version" "$found" "$target" "$digest"
}

case "${1:-}" in
  check)
    shift
    case "${1:-}" in
      "") print_check 0 ;;
      --json) shift; [ "$#" -eq 0 ] || die 64 "unknown check argument: $1"; print_check 1 ;;
      *) die 64 "unknown check argument: $1" ;;
    esac
    ;;
  pin) shift; pin_command "$@" ;;
  run) shift; run_command "$@" ;;
  -h|--help|"") usage ;;
  *) die 64 "unknown command: $1" ;;
esac
