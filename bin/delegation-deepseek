#!/usr/bin/env bash
# Run DeepSeek V4.1 Flash (deepseek-flash) through the DeepSeek OpenAI-compatible API.
# Operational model choices require technical compatibility, not qualification.
set -euo pipefail
umask 077

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
RUNNER_NAME="delegation-deepseek"
PROVIDER_LABEL="DeepSeek V4.1 Flash"
ROUTING_FILE="${DELEGATION_DEEPSEEK_ROUTING_FILE:-$ROOT/config/deepseek-flash-routing.json}"
CENTRAL_GATES="${DELEGATION_ROUTING_GATES_FILE:-$ROOT/config/routing-gates.json}"
KEY_FILE="${DELEGATION_DEEPSEEK_KEY_FILE:-$ROOT/config/deepseek.env}"
API_KEY_VAR="DEEPSEEK_API_KEY"
MODEL="${DELEGATION_REQUESTED_MODEL:-deepseek-flash}"
PROFILE="deepseek-flash"
BACKEND="deepseek-api"
API_URL="https://api.deepseek.com/v1/chat/completions"
PINNED_EFFORT="max"
BILLING="api"

# shellcheck source=bin/lib/delegation-runner-common.sh
. "$ROOT/bin/lib/delegation-runner-common.sh"
# shellcheck source=bin/lib/delegation-chat-completions.sh
. "$ROOT/bin/lib/delegation-chat-completions.sh"

usage() {
  cat <<'EOF'
Usage:
  delegation-deepseek check [--json]
  delegation-deepseek run --lane <builder|clerk|scout|reviewer|senior|judgement|policy-annotation> \
    [--effort <auto|none|minimal|low|medium|high|xhigh|max>] \
    [--backend <auto|deepseek-api>] --prompt-file <path> \
    --output <path> --workdir <path> [--metrics <path>] \
    [--debug-dir <path>] [--allow-provisional] \
    [--evaluation --evaluation-manifest <path>] [--preflight-only]

Operational lanes require an explicit user request and technical compatibility.
This text-only adapter returns a patch for the lead to apply and verify; it
cannot edit a worktree. --allow-provisional is deprecated and has no effect.

--evaluation is reserved for allowlisted controlled qualification runs of
candidate lanes, never promotes or mutates a gate, and adds no operational
route. --allow-provisional has no effect. Policy-annotation
does not qualify broad architecture/trade-off judgement. --preflight-only is
valid only with --evaluation and --evaluation-manifest: it traverses the same
pre-provider validation path as the real evaluation run, prints a
delegation_policy_annotation_preflight_receipt_v1 receipt on stdout, and exits
zero before provider dispatch and before any caller-visible artifact exists.

Exit codes: 64 invalid input, 69 unavailable/authentication failure,
70 dispatch/extract failure, 75 temporary/rate-limit failure, 78 routing gate
refusal. Failures write sanitized metadata to <output>.error.json. Raw provider
responses and stderr are preserved only when --debug-dir is supplied.
EOF
}

# DeepSeek requires the explicit thinking switch alongside reasoning_effort.
provider_request_body() {
  local prompt_file="$1" effort="$2" max_tokens="$3"
  jq -n --arg model "$MODEL" --rawfile prompt "$prompt_file" --arg effort "$effort" \
    --argjson max_tokens "$max_tokens" \
    '{model:$model,messages:[{role:"user",content:$prompt}],max_tokens:$max_tokens,
      reasoning_effort:$effort,thinking:{type:"enabled"}}'
}

# DeepSeek reports reasoning tokens and prompt-cache hits in its usage block.
provider_usage_extra() {
  jq -c '{reasoning:(.usage.completion_tokens_details.reasoning_tokens // 0),
          cache_read:(.usage.prompt_cache_hit_tokens // 0)}' "$1"
}

chat_completions_main "$@"
