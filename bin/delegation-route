#!/usr/bin/env bash
# Inspect and resolve delegation-kit's versioned routing decisions. This command
# is read-only: it never dispatches a model or mutates a gate.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
GATES="${DELEGATION_ROUTING_GATES_FILE:-$ROOT/config/routing-gates.json}"
EVIDENCE="${DELEGATION_EVIDENCE_FILE:-$ROOT/config/model-evidence.json}"
if [ -n "${DELEGATION_GLM_ROUTING_FILE:-}" ]; then
  GLM_GATES=("$DELEGATION_GLM_ROUTING_FILE")
else
  GLM_GATES=(
    "$ROOT/config/glm-5.3-flash-max-routing.json"
  )
fi
KIMI_GATE="${DELEGATION_KIMI_ROUTING_FILE:-$ROOT/config/kimi-k3-routing.json}"
QWEN_GATE="${DELEGATION_QWEN_ROUTING_FILE:-$ROOT/config/qwen3.8-max-routing.json}"
DEEPSEEK_GATE="${DELEGATION_DEEPSEEK_ROUTING_FILE:-$ROOT/config/deepseek-v4-pro-routing.json}"
GEMINI_GATE="${DELEGATION_GEMINI_ROUTING_FILE:-$ROOT/config/gemini-3.7-flash-routing.json}"
GROK_GATE="${DELEGATION_GROK_ROUTING_FILE:-$ROOT/config/grok-4.6-routing.json}"

usage() {
  cat <<'EOF'
usage: delegation-route <check|lane NAME|profile NAME|resolve --lane NAME|table> [--json]

  check             validate gates, enums, references, and compound lanes
  lane NAME         list every profile configured for a lane
  profile NAME      show one exact profile and all its lane decisions
  resolve --lane N [--selected-profile NAME]
                    list the user-selectable profiles for a lane, or validate
                    one exact user-selected profile; never dispatches and
                    never grants permission. review lanes additionally
                    require --producer-profile NAME or
                    --producer-family FAMILY and exclude that whole family
  table             print the internal routing table (Markdown, or JSON)
EOF
}

die() { local code="$1"; shift; printf 'delegation-route: %s\n' "$*" >&2; exit "$code"; }
command -v jq >/dev/null 2>&1 || die 69 "jq is required"
[ -r "$GATES" ] || die 66 "cannot read $GATES"
[ -r "$EVIDENCE" ] || die 66 "cannot read $EVIDENCE"

# Compare one provider's executable gate with the central gates: same lane
# set, and per lane the same status, selection, effort, and evaluation
# manifest allowlist; the gate's qualified/provisional summaries and its
# per-backend `qualified` flags must agree with the statuses. Arguments:
#   <gate-file> <model> <harness> <backend-key> <label> [--runtime-cli <profile>]
# --runtime-cli additionally requires the named central profile's
# runtime_cli_compatibility block to equal the gate's.
check_executable_gate() {
  local gate="$1" model="$2" harness="$3" backend="$4" label="$5" runtime_cli_profile=""
  shift 5
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --runtime-cli) runtime_cli_profile="${2:-}"; shift 2 ;;
      *) die 70 "check_executable_gate: unknown option $1" ;;
    esac
  done
  jq -e -n --slurpfile central "$GATES" --slurpfile bridge "$gate" \
    --arg model "$model" --arg harness "$harness" --arg backend "$backend" \
    --arg runtime_cli_profile "$runtime_cli_profile" '
    [$central[0].profiles | to_entries[] | select(.value.model == $model and .value.harness == $harness) as $p |
     $p.value.lanes | to_entries[] |
     {key:.key,value:{status:.value.status,selection:.value.selection,effort:$p.value.effort,
                      evaluation_manifest_sha256:(.value.evaluation_manifest_sha256 // [])}}] | from_entries as $expected |
    [$bridge[0].lanes | to_entries[] |
     {key:.key,value:{status:.value.backends[$backend].status,selection:.value.backends[$backend].selection,
                      effort:(.value.backends[$backend].effort // .value.default_effort),
                      evaluation_manifest_sha256:(.value.backends[$backend].evaluation_manifest_sha256 // [])}}] | from_entries as $actual |
    ($bridge[0].model == $model) and (($expected | keys) == ($actual | keys)) and
    all($expected | keys[]; $expected[.] == $actual[.]) and
    (($expected | to_entries | map(select(.value.status == "qualified") | .key) | sort) == (($bridge[0].qualified_lanes // []) | sort)) and
    (($expected | to_entries | map(select(.value.status == "provisional") | .key) | sort) == (($bridge[0].provisional_lanes // []) | sort)) and
    all($bridge[0].lanes[]; (.backends[$backend].qualified == (.backends[$backend].status == "qualified"))) and
    ($runtime_cli_profile == "" or
     $central[0].profiles[$runtime_cli_profile].runtime_cli_compatibility == $bridge[0].runtime_cli_compatibility)
  ' >/dev/null || die 65 "central routing and $label executable gate disagree"
}

validate() {
  jq -e . "$GATES" >/dev/null || die 65 "invalid gate JSON"
  jq -e . "$EVIDENCE" >/dev/null || die 65 "invalid evidence JSON"
  jq -e --slurpfile evidence "$EVIDENCE" '
    def legal_pair:
      .status as $status | .selection as $selection |
      ($status == "disabled" and $selection == "blocked") or
      ($status == "candidate" and $selection == "blocked") or
      (($status == "provisional" or $status == "qualified" or $status == "manual-qualified")
       and $selection == "explicit-only");
    def evidence_by_id: ($evidence[0].evidence | map({key:.id,value:.}) | from_entries);
    def evidence_lane($lane):
      if $lane == "material-review" or $lane == "routine-review" or $lane == "security" then "reviewer"
      else $lane end;
    def has_metric($metrics; $path): try ($metrics | getpath($path | split(".")) != null) catch false;
    . as $root | evidence_by_id as $rows |
    (.profiles | keys) as $profiles |
    .schema_version == 1 and
    (.profiles | type == "object" and length > 0) and
    (.compound_lanes | type == "object") and
    (.model_families | type == "object" and length > 0) and
    (.model_families | all(.[]; type == "string" and length > 0)) and
    (([.profiles[].model] - (.model_families | keys)) | length == 0) and
    (.review_policy.require_cross_family == true) and
    (.review_policy.availability_must_be_verified == true) and
    (.review_policy.review_lanes | type == "array" and length > 0 and length == (unique | length)) and
    (.review_policy.eligible_reviewer_profiles | type == "array" and length > 0 and length == (unique | length)) and
    ((.review_policy.eligible_reviewer_profiles - $profiles) | length == 0) and
    ([.profiles | to_entries[] as $p | $p.value.lanes | to_entries[] |
      .key as $lane |
      select(($root.review_policy.review_lanes | index($lane)) != null) |
      select(.value.selection != "blocked" and .value.status != "candidate" and .value.status != "disabled") |
      $p.key] - $root.review_policy.eligible_reviewer_profiles | length == 0) and
    ([.profiles[] | .model, .harness, .effort] | all(type == "string" and length > 0)) and
    ([.profiles[] | select(.harness == "claude-zai") |
      select(.model != "glm-5.3-flash" or .effort != "max")] | length == 0) and
    ([.profiles[].lanes[] | .status] | all(. as $v | $statuses | index($v) != null)) and
    ([.profiles[].lanes[] | .selection] | all(. as $v | $selections | index($v) != null)) and
    ([.compound_lanes[] | .status] | all(. as $v | $statuses | index($v) != null)) and
    ([.compound_lanes[] | .selection] | all(. as $v | $selections | index($v) != null)) and
    ([.profiles[].lanes[], .compound_lanes[]] | all(legal_pair)) and
    ([.profiles[].lanes[] | select((.fallback // null) != null)] | length == 0) and
    (.activation_policy.mode == "user-directed" and
     .activation_policy.scope == "per-dispatch" and
     .activation_policy.assistant_may_list_choices == true and
     .activation_policy.automatic_dispatch == false and
     .activation_policy.authorization_carries_to_retries == false and
     .activation_policy.authorization_carries_to_review == false) and
    ([.profiles | to_entries[] as $p | $p.value.lanes[] |
      select((.exact_evidence_ids | type) != "array" or (.context_evidence_ids | type) != "array")] | length == 0) and
    ([.profiles | to_entries[] as $p | $p.value.lanes[] as $lane |
      $lane.exact_evidence_ids[]? as $id |
      select($rows[$id].model != $p.value.model or $rows[$id].harness != $p.value.harness or $rows[$id].effort != $p.value.effort)] | length == 0) and
    ([.profiles | to_entries[] as $p | $p.value.lanes | to_entries[] as $lane |
      $lane.value.exact_evidence_ids[]? as $id |
      ($evidence[0].lane_evidence[evidence_lane($lane.key)].required_metrics // [])[] as $metric |
      select(has_metric($rows[$id].metrics; $metric) | not)] | length == 0) and
    ([.profiles[].lanes[] | ((.exact_evidence_ids + .context_evidence_ids) | length) == ((.exact_evidence_ids + .context_evidence_ids) | unique | length)] | all) and
    ([.profiles | to_entries[] as $p | $p.value.lanes | to_entries[] as $lane |
      select($lane.value.evaluation_manifest_sha256? != null) |
      ($lane.key == "policy-annotation") or
      ($p.value.model == "glm-5.3-flash" and $p.value.harness == "claude-zai" and $p.value.effort == "max" and
       (["clerk","scout","builder"] | index($lane.key)) != null and
       (($lane.value.status == "provisional" and $lane.value.selection == "explicit-only") or
        ($lane.value.status == "candidate" and $lane.value.selection == "blocked")))] | all) and
    ([.profiles | to_entries[] as $p | $p.value.lanes | to_entries[] |
      select(.value.evaluation_manifest_sha256? != null) | .value |
      (.evaluation_manifest_sha256 // null) as $hashes |
      ($hashes | type) == "array" and
      ($hashes | length) == ($hashes | unique | length) and
      all($hashes[]; type == "string" and test("^[0-9a-f]{64}$"))] | all) and
    ([.profiles | to_entries[] as $p | $p.value.lanes | to_entries[] |
      select(.key == "policy-annotation") | .value |
      if .status == "candidate"
      then .selection == "blocked"
      else ((.evaluation_manifest_sha256 // []) | length) == 0
      end] | all) and
    ([.profiles[].lanes[] | select((.provider_fallback // null) != null) |
      .provider_fallback |
      .possible == true and
      (.target_model | type == "string" and length > 0) and
      (.trigger | type == "string" and length > 0) and
      .exact_variant_guaranteed == false and
      (.source_evidence_id | type == "string" and length > 0)] | all) and
    ([.compound_lanes[] | .members[] as $member |
      select(.status != "manual-qualified" or .selection != "explicit-only" or
             .automatic_dispatch != false or .automatic_merge != false or
             .final_authority != "lead" or
             $root.profiles[$member].lanes.judgement.status != "manual-qualified")] | length == 0)
  ' --argjson statuses "$(jq '.status_values' "$GATES")" \
    --argjson selections "$(jq '.selection_values' "$GATES")" "$GATES" >/dev/null \
    || die 65 "gate schema or enum validation failed"

  local evidence_ids gate_ids missing members
  evidence_ids="$(jq -c '[.evidence[].id]' "$EVIDENCE")"
  gate_ids="$(jq -c '[.profiles[].lanes[] |
    .exact_evidence_ids[]?, .context_evidence_ids[]?, .provider_fallback.source_evidence_id?] |
    map(select(. != null)) | unique' "$GATES")"
  missing="$(jq -n --argjson known "$evidence_ids" --argjson used "$gate_ids" '$used - $known')"
  [ "$missing" = "[]" ] || die 65 "unknown evidence ids: $missing"
  members="$(jq -c '[.profiles | keys[]]' "$GATES")"
  missing="$(jq -c --argjson known "$members" '[.compound_lanes[].members[]] | unique - $known' "$GATES")"
  [ "$missing" = "[]" ] || die 65 "unknown compound-lane members: $missing"

  local glm_gate
  for glm_gate in "${GLM_GATES[@]}"; do
    [ -r "$glm_gate" ] || die 66 "cannot read executable GLM gate $glm_gate"
  done
  [ -r "$KIMI_GATE" ] || die 66 "cannot read executable Kimi gate $KIMI_GATE"
  [ -r "$QWEN_GATE" ] || die 66 "cannot read executable Qwen gate $QWEN_GATE"
  [ -r "$DEEPSEEK_GATE" ] || die 66 "cannot read executable DeepSeek gate $DEEPSEEK_GATE"
  [ -r "$GEMINI_GATE" ] || die 66 "cannot read executable Gemini gate $GEMINI_GATE"
  [ -r "$GROK_GATE" ] || die 66 "cannot read executable Grok gate $GROK_GATE"
  for glm_gate in "${GLM_GATES[@]}"; do
    jq -e -n --slurpfile central "$GATES" --slurpfile bridge "$glm_gate" '
      $bridge[0] as $b | ($b.profile_prefix // "") as $prefix |
      [$central[0].profiles | to_entries[] |
       select(.key | startswith($prefix + "-")) as $p |
       $p.value.lanes | to_entries[] |
       {key:.key,value:{status:.value.status,selection:.value.selection,effort:$p.value.effort,evaluation_manifest_sha256:(.value.evaluation_manifest_sha256 // [])}}] | from_entries as $expected |
      [$b.lanes | to_entries[] |
       {key:.key,value:{status:.value.backends["claude-zai"].status,selection:.value.backends["claude-zai"].selection,effort:(.value.backends["claude-zai"].effort // .value.default_effort),evaluation_manifest_sha256:(.value.backends["claude-zai"].evaluation_manifest_sha256 // [])}}] | from_entries as $actual |
      ($b.model == "glm-5.3-flash") and
      ($prefix | type == "string" and length > 0) and
      ([ $central[0].profiles | to_entries[] | select(.key | startswith($prefix + "-")) |
         select(.value.model != $b.model or .value.harness != "claude-zai" or .value.effort != "max") ] | length == 0) and
      (($expected | keys) == ($actual | keys)) and
      all($expected | keys[]; $expected[.] == $actual[.]) and
      (($expected | to_entries | map(select(.value.status == "qualified") | .key) | sort) == (($b.qualified_lanes // []) | sort)) and
      (($expected | to_entries | map(select(.value.status == "provisional") | .key) | sort) == (($b.provisional_lanes // []) | sort)) and
      all($b.lanes[];
        (.backends["claude-zai"].qualified == (.backends["claude-zai"].status == "qualified")) and
        ((.backends["claude-zai"].effort // .default_effort) == "max"))
    ' >/dev/null || die 65 "central routing and GLM executable gate disagree: $glm_gate"
  done
  check_executable_gate "$KIMI_GATE" kimi-k3 kimi-code-cli native Kimi
  check_executable_gate "$QWEN_GATE" qwen3.8-max token-plan-openai token-plan-openai Qwen
  check_executable_gate "$DEEPSEEK_GATE" deepseek-v4-pro deepseek-api deepseek-api DeepSeek
  check_executable_gate "$GEMINI_GATE" gemini-3.7-flash agy agy Gemini
  check_executable_gate "$GROK_GATE" grok-4.6 grok-build-cli grok-build Grok --runtime-cli grok-build
}

profile_rows() {
  jq -c '
    . as $root | .profiles | to_entries[] as $p |
    $p.value.lanes | to_entries[] |
    {profile:$p.key,model:$p.value.model,family:$root.model_families[$p.value.model],harness:$p.value.harness,effort:$p.value.effort,
     lane:.key,status:.value.status,selection:.value.selection,
     exact_evidence_ids:(.value.exact_evidence_ids // []),context_evidence_ids:(.value.context_evidence_ids // []),
     local_evaluation:(.value.local_evaluation // null),
     provider_fallback:(.value.provider_fallback // null),
     evidence_gap:(.value.evidence_gap // null)}
  ' "$GATES"
}

as_json=0
for arg in "$@"; do [ "$arg" != --json ] || as_json=1; done
command="${1:-}"
validate

case "$command" in
  check)
    if [ "$as_json" = 0 ]; then
      printf 'routing gates valid: %s profiles, %s compound lanes\n' \
        "$(jq '.profiles | length' "$GATES")" "$(jq '.compound_lanes | length' "$GATES")"
    else
      jq -n --arg file "$GATES" --argjson profiles "$(jq '.profiles | length' "$GATES")" \
        --argjson compounds "$(jq '.compound_lanes | length' "$GATES")" \
        '{valid:true,file:$file,profiles:$profiles,compound_lanes:$compounds,read_only:true}'
    fi
    ;;
  lane)
    lane="${2:-}"; [ -n "$lane" ] || die 64 "lane name is required"
    if jq -e --arg lane "$lane" '.compound_lanes[$lane] != null' "$GATES" >/dev/null; then
      jq --arg lane "$lane" '.compound_lanes[$lane] + {lane:$lane}' "$GATES"
    else
      rows="$(profile_rows | jq -sc --arg lane "$lane" '[.[] | select(.lane == $lane)]')"
      [ "$rows" != "[]" ] || die 64 "unknown lane: $lane"
      if [ "$as_json" = 1 ]; then printf '%s\n' "$rows"
      else printf '%s\n' "$rows" | jq -r '.[] | "\(.profile)\t\(.status)\t\(.selection)\t\(.model)/\(.harness)/\(.effort)"'; fi
    fi
    ;;
  profile)
    profile="${2:-}"; [ -n "$profile" ] || die 64 "profile name is required"
    jq -e --arg profile "$profile" '.profiles[$profile] != null' "$GATES" >/dev/null || die 64 "unknown profile: $profile"
    jq --arg profile "$profile" '.profiles[$profile] + {profile:$profile}' "$GATES"
    ;;
  resolve)
    shift; lane=""; producer_profile=""; producer_family=""; selected_profile=""; eligible=""; choices=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --lane) lane="${2:-}"; shift 2 ;;
        --producer-profile) producer_profile="${2:-}"; shift 2 ;;
        --producer-family) producer_family="${2:-}"; shift 2 ;;
        --selected-profile) selected_profile="${2:-}"; shift 2 ;;
        --json) shift ;;
        *) die 64 "unknown resolve argument: $1" ;;
      esac
    done
    [ -n "$lane" ] || die 64 "--lane is required"
    if [ -n "$producer_profile" ] && [ -n "$producer_family" ]; then
      die 64 "use only one of --producer-profile or --producer-family"
    fi
    if jq -e --arg lane "$lane" '.compound_lanes[$lane] != null' "$GATES" >/dev/null; then
      [ -z "$producer_profile$producer_family" ] || die 64 "producer identity applies only to review lanes"
      [ -z "$selected_profile" ] || die 64 "--selected-profile does not apply to compound lanes"
      status="$(jq -r --arg lane "$lane" '.compound_lanes[$lane].status' "$GATES")"
      [ "$status" = manual-qualified ] || die 78 "compound lane '$lane' has non-dispatchable status '$status'"
      jq -n --arg lane "$lane" --argjson activation_policy "$(jq '.activation_policy' "$GATES")" \
        '.compound_lanes[$lane] + {lane:$lane,requires_explicit_choice:true,
         requires_user_direction:true,automatic_dispatch:false,
         selection_validated:false,selected:null,activation_policy:$activation_policy}' "$GATES"
    else
      rows="$(profile_rows | jq -sc --arg lane "$lane" '[.[] | select(.lane == $lane)]')"
      [ "$rows" != "[]" ] || die 64 "unknown lane: $lane"
      review_lane="$(jq -r --arg lane "$lane" '(.review_policy.review_lanes | index($lane)) != null' "$GATES")"
      if [ "$review_lane" = true ]; then
        [ -n "$producer_profile$producer_family" ] || die 64 "review lane '$lane' requires --producer-profile or --producer-family"
        if [ -n "$producer_profile" ]; then
          jq -e --arg profile "$producer_profile" '.profiles[$profile] != null' "$GATES" >/dev/null \
            || die 64 "unknown producer profile: $producer_profile"
          producer_family="$(jq -r --arg profile "$producer_profile" '.model_families[.profiles[$profile].model]' "$GATES")"
        else
          jq -e --arg family "$producer_family" '.model_families | any(.[]; . == $family)' "$GATES" >/dev/null \
            || die 64 "unknown producer family: $producer_family"
        fi
      elif [ -n "$producer_profile$producer_family" ]; then
        die 64 "producer identity applies only to review lanes"
      fi
      # Eligible rows exclude the producer's family on review lanes; choices are
      # the eligible rows the user may select. Computed once, reused below.
      eligible="$(jq -c --argjson review_lane "$review_lane" --arg producer_family "$producer_family" \
        '(if $review_lane then [.[] | select(.family != $producer_family)] else . end)' <<<"$rows")"
      choices="$(jq -c '[.[] | select(.selection == "explicit-only") |
        select(.status == "qualified" or .status == "provisional" or .status == "manual-qualified")]' <<<"$eligible")"
      selected_row="$(jq -c --arg selected_profile "$selected_profile" '
        (if $selected_profile == "" then "NO_SELECTION"
         else ([.[] | select(.profile == $selected_profile)] | first // "NOT_SELECTABLE") end)' <<<"$choices")"
      [ "$selected_row" != '"NOT_SELECTABLE"' ] \
        || die 78 "profile '$selected_profile' is not selectable for lane '$lane'"
      jq -n --arg lane "$lane" --arg producer_profile "$producer_profile" \
        --arg producer_family "$producer_family" --arg selected_profile "$selected_profile" \
        --argjson review_lane "$review_lane" --argjson rows "$rows" \
        --argjson eligible "$eligible" --argjson choices "$choices" \
        --argjson selected_row "$selected_row" \
        --argjson activation_policy "$(jq '.activation_policy' "$GATES")" '
        {lane:$lane,
         choices:$choices,
         selected:(if $selected_profile == "" then null else $selected_row end),
         selection_validated:($selected_profile != ""),
         blocked:[$eligible[] |
           select(.selection == "blocked" or .status == "candidate" or .status == "disabled")],
         excluded_same_family:(if $review_lane then [$rows[] | select(.family == $producer_family)] else [] end),
         review_policy:(if $review_lane then
           {require_cross_family:true,producer_profile:(if $producer_profile == "" then null else $producer_profile end),
            producer_family:$producer_family,availability_must_be_verified:true}
           else null end),
         activation_policy:$activation_policy,
         requires_user_direction:true,
         automatic_dispatch:false}'
    fi
    ;;
  table)
    rows="$(profile_rows | jq -s '.')"
    if [ "$as_json" = 1 ]; then
      jq -n --argjson profiles "$rows" \
        --argjson families "$(jq '.model_families' "$GATES")" \
        --argjson review_policy "$(jq '.review_policy' "$GATES")" \
        --argjson compounds "$(jq '.compound_lanes' "$GATES")" \
        '{profiles:$profiles,model_families:$families,review_policy:$review_policy,compound_lanes:$compounds}'
    else
      printf '| Profile | Family | Exact variant | Lane | Exact evidence | Context | Local n | Confidence | Status | Selection | Fallback | Gap |\n'
      printf '|---|---|---|---|---:|---:|---:|---|---|---|---|---|\n'
      printf '%s\n' "$rows" | jq -r '.[] | "| `\(.profile)` | \(.family) | \(.model) / \(.harness) / `\(.effort)` | \(.lane) | \(.exact_evidence_ids | length) | \(.context_evidence_ids | length) | \(.local_evaluation.task_count // "—") | \(.local_evaluation.confidence // "—") | \(.status) | \(.selection) | \(if .provider_fallback then "\(.provider_fallback.target_model) (\(.provider_fallback.trigger))" else "—" end) | \(.evidence_gap // "—") |"'
      printf '\nCross-family review required for: %s\n' "$(jq -r '.review_policy.review_lanes | join(", ")' "$GATES")"
      printf '\n| Compound lane | Members | Protocol | Status | Selection | Final authority |\n'
      printf '|---|---|---|---|---|---|\n'
      jq -r '.compound_lanes | to_entries[] | "| `\(.key)` | \(.value.members | join(" + ")) | \(.value.protocol) | \(.value.status) | \(.value.selection) | \(.value.final_authority) |"' "$GATES"
    fi
    ;;
  -h|--help|"") usage ;;
  *) die 64 "unknown command: $command" ;;
esac
