#!/usr/bin/env python3
"""Read-only discovery. Selection never authorizes dispatch."""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from delegation_config import load, row, REVIEW_ROLES, read, ROOT

p = argparse.ArgumentParser()
p.add_argument("command", choices=["check", "lane", "profile", "resolve", "table"])
p.add_argument("name", nargs="?")
p.add_argument("--lane")
p.add_argument("--selected-profile")
p.add_argument("--producer-profile")
p.add_argument("--producer-family")
p.add_argument("--json", action="store_true")
a = p.parse_args()
try:
    c = load()
    profiles = c["profiles"]
    try:
        compounds = read(ROOT / "config/routing-gates.json").get("compound_lanes", {})
    except (OSError, ValueError):
        compounds = {}
    rows = [row(k, v, r, c) for k, v in profiles.items() for r in v["roles"]]
    result = {
        "schema_version": 2,
        "read_only": True,
        "automatic_dispatch": False,
        "requires_user_direction": True,
        "authorization_granted": False,
        "review_policy": c["review_policy"],
    }
    if a.command == "check":
        result.update(valid=True, profiles=len(profiles))
    elif a.command == "profile":
        if a.name not in profiles:
            raise ValueError("unknown profile")
        result.update(
            profile=a.name,
            configuration=profiles[a.name],
            lanes=[r for r in rows if r["profile"] == a.name],
        )
    elif a.command in {"lane", "resolve"}:
        lane = a.lane if a.command == "resolve" else a.name
        if lane in compounds:
            if a.selected_profile or a.producer_profile or a.producer_family:
                raise ValueError("compound lanes require separate member selections")
            compound = compounds[lane]
            result.update(
                lane=lane,
                members=compound["members"],
                protocol=compound["protocol"],
                historical_evidence=compound,
                selection_validated=False,
                choices=[],
                requires_explicit_member_dispatches=True,
            )
            print(json.dumps(result, indent=2))
            sys.exit(0)
        candidates = [r for r in rows if r["lane"] == lane]
        if not candidates:
            raise ValueError("unknown lane")
        family = a.producer_family
        if a.producer_profile:
            if family or a.producer_profile not in profiles:
                raise ValueError("invalid producer")
            family = profiles[a.producer_profile].get("family")
        strict = lane in REVIEW_ROLES and c["review_policy"] == "cross-family"
        choices = [
            r
            for r in candidates
            if r["technical_compatibility"]
            and (not strict or (family and r["family"] and family != r["family"]))
        ]
        selected = next(
            (r for r in choices if r["profile"] == a.selected_profile), None
        )
        if a.selected_profile and not selected:
            raise ValueError(
                "profile is not technically selectable for this lane/review policy"
            )
        result.update(
            lane=lane,
            choices=choices,
            selected=selected,
            selection_validated=selected is not None,
            blocked=[r for r in candidates if r not in choices],
        )
    else:
        result["profiles"] = rows
        result["compound_lanes"] = compounds
    print(json.dumps(result, indent=2))
except (OSError, ValueError, KeyError, TypeError):
    print("delegation-route: invalid configuration or selection", file=sys.stderr)
    sys.exit(65)
