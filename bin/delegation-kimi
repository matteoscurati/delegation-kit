#!/usr/bin/env bash
# Run Kimi K3 through the native Kimi Code CLI. Fails closed: model, effort,
# backend, and qualification gates are always explicit and no backend fallback
# occurs after dispatch starts.
set -euo pipefail
umask 077

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
ROUTING_FILE="$ROOT/config/kimi-k3-routing.json"
CENTRAL_GATES="${DELEGATION_ROUTING_GATES_FILE:-$ROOT/config/routing-gates.json}"
ROUTER="$ROOT/bin/delegation-route"
KIMI_HOME="${KIMI_CODE_HOME:-$HOME/.kimi-code}"
CREDENTIAL_FILE="$KIMI_HOME/credentials/kimi-code.json"
NATIVE_MODEL="kimi-code/k3"
EFFORTS='["max"]'
RUN_TMP=""

usage() {
  cat <<'EOF'
Usage:
  delegation-kimi check [--json]
  delegation-kimi run --lane <clerk|scout|builder|frontend-builder|reviewer|senior|judgement> \
    [--effort <auto|max>] [--backend <auto|native>] \
    (--prompt-file <path> | --prompt <text>) --output <path> --workdir <path> \
    [--metrics <path>] [--allow-provisional]

Exit codes: 64 invalid input, 69 unavailable, 70 dispatch failure,
75 temporary/rate-limit failure, 78 lane not qualified.
EOF
}

die() { local code="$1"; shift; printf 'delegation-kimi: %s\n' "$*" >&2; exit "$code"; }
have() { command -v "$1" >/dev/null 2>&1; }

native_status() {
  NATIVE_REASON=""
  have kimi || { NATIVE_REASON="kimi not on PATH"; return 1; }
  local help providers providers_text
  help="$(kimi --help 2>&1 || true)"
  grep -q -- '--output-format' <<<"$help" \
    || { NATIVE_REASON="kimi lacks stream-json output"; return 1; }
  providers="$(kimi provider list --json 2>/dev/null || true)"
  jq -e --arg model "$NATIVE_MODEL" '.models[$model] != null' <<<"$providers" >/dev/null 2>&1 \
    || { NATIVE_REASON="$NATIVE_MODEL is not configured"; return 1; }
  # The field is camelCase and there is no default: a provider that does not
  # attest max effort must fail the gate, not inherit an assumed one.
  jq -e --arg model "$NATIVE_MODEL" '
    .models[$model].model == "k3" and
    ((.models[$model].supportEfforts // []) | index("max") != null)
  ' <<<"$providers" >/dev/null 2>&1 \
    || { NATIVE_REASON="$NATIVE_MODEL does not attest K3 max effort"; return 1; }
  providers_text="$(kimi provider list 2>/dev/null || true)"
  grep -Eq 'managed:kimi-code.*source=oauth' <<<"$providers_text" \
    || { NATIVE_REASON="$NATIVE_MODEL is not an OAuth-managed Kimi Code provider"; return 1; }
  # `source=oauth` above describes how the provider is configured; it prints
  # identically after a logout, so it can never see a missing credential. Read
  # the credential itself. Emptiness is the only sound local signal: both tokens
  # blank means logged out, full stop. Do not gate on expires_at — the access
  # token lives ~15 minutes and the refresh token silently renews it, so a live
  # session is expired most of the time.
  jq -e '((.access_token // "") | length > 0) or ((.refresh_token // "") | length > 0)' \
    "$CREDENTIAL_FILE" >/dev/null 2>&1 \
    || { NATIVE_REASON="Kimi Code is logged out — run: kimi login"; return 1; }
  NATIVE_REASON="ready"
  return 0
}

qualified_lanes() {
  if [ -f "$CENTRAL_GATES" ] && have jq; then
    jq -c '[.profiles["kimi-k3"].lanes | to_entries[] | select(.value.status == "qualified") | .key] | sort' "$CENTRAL_GATES" 2>/dev/null || printf '[]'
  else
    printf '[]'
  fi
}

provisional_lanes() {
  if [ -f "$CENTRAL_GATES" ] && have jq; then
    jq -c '[.profiles["kimi-k3"].lanes | to_entries[] | select(.value.status == "provisional") | .key] | sort' "$CENTRAL_GATES" 2>/dev/null || printf '[]'
  else
    printf '[]'
  fi
}

gate_status() {
  local lane="$1" backend="$2"
  [ "$backend" = native ] || { printf 'disabled\n'; return; }
  jq -r --arg lane "$lane" '.profiles["kimi-k3"].lanes[$lane].status // "disabled"' \
    "$CENTRAL_GATES" 2>/dev/null || printf 'disabled\n'
}

is_allowed() {
  local lane="$1" backend="$2" allow_provisional="$3" status
  status="$(gate_status "$lane" "$backend")"
  [ "$status" = qualified ] || { [ "$status" = provisional ] && [ "$allow_provisional" = 1 ]; }
}

preferred_backends() {
  local lane="$1"
  jq -r --arg lane "$lane" '
    (.lanes[$lane].preferred_backends // .preferred_backends // ["native"])[]
  ' "$ROUTING_FILE" 2>/dev/null || printf 'native\n'
}

default_effort() {
  jq -r '.profiles["kimi-k3"].effort // empty' "$CENTRAL_GATES" 2>/dev/null
}

qualified_effort() {
  local lane="$1" backend="$2"
  [ "$backend" = native ] || return 1
  [ "$(gate_status "$lane" "$backend")" != disabled ] || return 1
  default_effort
}

validate_gate_graph() {
  [ -x "$ROUTER" ] || return 1
  DELEGATION_ROUTING_GATES_FILE="$CENTRAL_GATES" "$ROUTER" check --json >/dev/null 2>&1
}

# A dead session is not a broken dispatch: it means the runtime is unavailable
# (69), so the caller keeps the incumbent instead of blaming the worker.
#
# Both classifiers slurp with `-s` and ask `any(...)`: `jq -e` over a JSONL
# stream takes its exit status from the LAST value it emits, so a matching event
# followed by any other error event would read as "no match".
# The stderr greps carry no bare status numbers — a crash whose stack trace
# happens to mention line 401 or 429 is a dispatch failure, not an auth or rate
# problem. Structured codes are matched on the JSON, where they are unambiguous.
auth_failure() {
  local events="$1" stderr="$2"
  grep -Eqi 'auth\.login_required|login_required|requires login|unauthorized|invalid[_ ]api[_ ]key' \
    "$stderr" 2>/dev/null && return 0
  jq -se 'any(.[];
    .type == "error" and (
      ((.error.data.statusCode // 0) == 401) or
      ((.error.data.message // .error.message // "") |
        test("login_required|requires login|unauthorized"; "i"))))
  ' "$events" >/dev/null 2>&1
}

temporary_failure() {
  local events="$1" stderr="$2"
  grep -Eqi 'rate.?limit|too many requests|usage limit|quota.*refresh|billing cycle|temporar.*unavailable|error[^0-9]*(1305|1312)' \
    "$stderr" 2>/dev/null && return 0
  jq -se 'any(.[];
    .type == "error" and (
      ((.error.data.statusCode // 0) == 429) or
      ((.error.data.message // .error.message // "") |
        test("rate.?limit|too many requests|usage limit|quota.*refresh|billing cycle|temporar.*unavailable"; "i"))))
  ' "$events" >/dev/null 2>&1
}

prepare_native_home() {
  local scratch="$1" item source target
  source="$KIMI_HOME"
  target="$scratch/home/.kimi-code"
  mkdir -p "$target" "$scratch/home-tmp"
  for item in config.toml credentials oauth device_id; do
    [ ! -e "$source/$item" ] || cp -R "$source/$item" "$target/"
  done
}

print_check() {
  local as_json="${1:-0}" native_ok=false selected="none" lanes provisional
  have jq || die 69 "jq is required"
  validate_gate_graph || die 78 "central and executable routing gates are missing, invalid, or inconsistent"
  native_status && native_ok=true || true
  lanes="$(qualified_lanes)"
  provisional="$(provisional_lanes)"
  [ "$native_ok" = true ] && selected=native
  if [ "$as_json" = 1 ]; then
    jq -n \
      --arg model "kimi-k3" --arg native_model "$NATIVE_MODEL" \
      --arg selected "$selected" --argjson efforts "$EFFORTS" --argjson lanes "$lanes" --argjson provisional "$provisional" \
      --argjson native "$native_ok" --arg native_reason "$NATIVE_REASON" \
      '{model:$model,models:{native:$native_model},efforts:$efforts,
        selected_backend:$selected,qualified_lanes:$lanes,provisional_lanes:$provisional,backends:{
          native:{available:$native,reason:$native_reason,efforts:["max"]}}}'
  else
    printf 'Kimi K3: selected=%s qualified=%s provisional=%s\n' "$selected" "$lanes" "$provisional"
    printf '  native: %s (%s; model=%s; effort=max)\n' "$native_ok" "$NATIVE_REASON" "$NATIVE_MODEL"
  fi
}

extract_native() {
  local events="$1" output="$2" metrics="$3" started="$4" effort="$5" lane="$6"
  jq -ers '
    [.[] | select(.role == "assistant") | .content |
      if type == "string" then .
      elif type == "array" then
        map(if type == "string" then . else (.text // .content // empty) end) | join("")
      else empty end |
      select(length > 0)] | last // empty
  ' "$events" >"$output" || return 1
  [ -s "$output" ] || return 1
  jq -n --arg model "$NATIVE_MODEL" --arg effort "$effort" --arg lane "$lane" \
    --argjson started "$started" '
    {model:$model,backend:"native",effort:$effort,lane:$lane,
     started_at_epoch:$started,finished_at_epoch:now,usage_reported:false,
     tokens:{input:0,output:0,reasoning:0,cache_read:0,cache_write:0},
     provider_cost_usd:null}
  ' >"$metrics"
}

backend_available() {
  case "$1" in
    native) native_status ;;
    *) return 1 ;;
  esac
}

run_command() {
  local lane="" effort="auto" backend="auto" prompt_file="" prompt="" output="" workdir="" metrics=""
  local prompt_source="" backend_checked=0 expected_effort="" allow_provisional=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --lane) lane="${2:-}"; shift 2 ;;
      --effort) effort="${2:-}"; shift 2 ;;
      --backend) backend="${2:-}"; shift 2 ;;
      --prompt-file) prompt_file="${2:-}"; shift 2 ;;
      --prompt) prompt="${2:-}"; prompt_source="literal"; shift 2 ;;
      --output) output="${2:-}"; shift 2 ;;
      --workdir) workdir="${2:-}"; shift 2 ;;
      --metrics) metrics="${2:-}"; shift 2 ;;
      --allow-provisional) allow_provisional=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die 64 "unknown run argument: $1" ;;
    esac
  done
  case "$lane" in clerk|scout|builder|frontend-builder|reviewer|senior|judgement) ;; *) die 64 "invalid lane: $lane" ;; esac
  case "$effort" in auto|max) ;; *) die 64 "invalid effort: $effort" ;; esac
  case "$backend" in auto|native) ;; *) die 64 "invalid backend: $backend" ;; esac
  [ -z "$prompt_file" ] || [ -z "$prompt_source" ] || die 64 "use only one of --prompt-file or --prompt"
  if [ -n "$prompt_file" ]; then
    [ -f "$prompt_file" ] || die 64 "prompt file missing: $prompt_file"
    prompt="$(<"$prompt_file")"
    prompt_source="file"
  fi
  [ -n "$prompt_source" ] || die 64 "--prompt-file or --prompt is required"
  [ -n "$prompt" ] || die 64 "prompt must not be empty"
  [ -d "$workdir" ] || die 64 "workdir missing: $workdir"
  workdir="$(cd "$workdir" && pwd -P)"
  [ -n "$output" ] || die 64 "--output is required"
  have jq || die 69 "jq is required"
  [ -f "$ROUTING_FILE" ] || die 69 "routing file missing: $ROUTING_FILE"
  jq -e . "$ROUTING_FILE" >/dev/null 2>&1 || die 69 "routing file is invalid JSON"
  validate_gate_graph || die 78 "central and executable routing gates are missing, invalid, or inconsistent"

  if [ "$backend" = auto ]; then
    local candidate qualified_seen=0
    backend=""
    while IFS= read -r candidate; do
      case "$candidate" in native) ;; *) continue ;; esac
      is_allowed "$lane" "$candidate" "$allow_provisional" || continue
      qualified_seen=1
      if backend_available "$candidate"; then
        backend="$candidate"; backend_checked=1; break
      fi
    done < <(preferred_backends "$lane")
    if [ -z "$backend" ]; then
      # A qualified lane whose runtime is merely down is 69 (unavailable), not 78
      # (never approved). The caller must read "keep the incumbent for now", not
      # "this lane failed evaluation" — they are different facts with different
      # lifetimes.
      [ "$qualified_seen" = 0 ] || die 69 "$NATIVE_REASON"
      status="$(gate_status "$lane" native)"
      if [ "$status" != provisional ]; then
        die 78 "lane '$lane' has non-dispatchable status '$status'"
      else
        die 78 "lane '$lane' is provisional; pass --allow-provisional after an explicit routing decision"
      fi
    fi
  else
    if ! is_allowed "$lane" "$backend" "$allow_provisional"; then
      status="$(gate_status "$lane" "$backend")"
      if [ "$status" != provisional ]; then
        die 78 "lane '$lane' backend '$backend' has non-dispatchable status '$status'"
      else
        die 78 "lane '$lane' backend '$backend' is provisional; pass --allow-provisional after an explicit routing decision"
      fi
    fi
  fi

  [ "$effort" != auto ] || effort="$(default_effort)"
  expected_effort="$(qualified_effort "$lane" "$backend")" \
    || die 69 "qualified lane '$lane' has no pinned effort for backend '$backend'"
  [ "$effort" = "$expected_effort" ] \
    || die 78 "lane '$lane' backend '$backend' is qualified only at effort '$expected_effort'"
  if [ "$backend" = native ] && [ "$effort" != max ]; then
    die 64 "native backend supports only max effort"
  fi
  if [ "$backend_checked" -eq 0 ]; then
    backend_available "$backend" || die 69 "$NATIVE_REASON"
  fi

  metrics="${metrics:-$output.metrics.json}"
  local output_parent metrics_parent output_name metrics_name
  output_parent="$(dirname "$output")"; output_name="$(basename "$output")"
  metrics_parent="$(dirname "$metrics")"; metrics_name="$(basename "$metrics")"
  case "$output_name" in .|..) die 64 "invalid output filename" ;; esac
  case "$metrics_name" in .|..) die 64 "invalid metrics filename" ;; esac
  [ -d "$output_parent" ] || die 64 "output parent directory must already exist: $output_parent"
  [ -d "$metrics_parent" ] || die 64 "metrics parent directory must already exist: $metrics_parent"
  output="$(cd "$output_parent" && pwd -P)/$output_name"
  metrics="$(cd "$metrics_parent" && pwd -P)/$metrics_name"
  [ "$output" != "$metrics" ] || die 64 "output and metrics paths resolve to the same file"
  [ ! -L "$output" ] || die 64 "output must not be a symlink"
  [ ! -L "$metrics" ] || die 64 "metrics must not be a symlink"
  if [ "$lane" != builder ] && [ "$lane" != frontend-builder ]; then
    case "$output" in "$workdir"/*) die 64 "read-only lane output must be outside workdir" ;; esac
    case "$metrics" in "$workdir"/*) die 64 "read-only lane metrics must be outside workdir" ;; esac
  fi

  local tmp events rc=0 started result_tmp metrics_tmp error_tmp
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/delegation-kimi.XXXXXX")"
  tmp="$(cd "$tmp" && pwd -P)"
  RUN_TMP="$tmp"
  trap 'rm -rf -- "$RUN_TMP"' EXIT
  events="$tmp/events.jsonl"
  result_tmp="$tmp/result.txt"
  metrics_tmp="$tmp/metrics.json"
  error_tmp="$tmp/error.txt"
  started="$(date +%s)"

  if [ "$lane" = builder ] || [ "$lane" = frontend-builder ]; then
    (cd "$workdir" && kimi --prompt "$prompt" --model "$NATIVE_MODEL" \
      --output-format stream-json </dev/null) >"$events" 2>"$tmp/stderr" || rc=$?
  else
    # Kimi Code 0.26 needs a writable HOME for session bookkeeping. Give it
    # an isolated copy of only the provider config/auth material, then deny
    # every write outside this runner-owned scratch directory. This protects
    # the worktree, routing gate, real HOME, sibling repos, and output paths.
    if [ "$(uname)" != Darwin ] || ! have sandbox-exec; then
      die 69 "native read-only lanes require macOS sandbox-exec"
    fi
    local sandbox_profile
    prepare_native_home "$tmp" || die 69 "could not prepare isolated Kimi home"
    sandbox_profile='(version 1) (allow default) (deny file-write* (require-not (subpath (param "SCRATCH"))))'
    # KIMI_CODE_HOME must be unset for the child: kimi honours it over HOME, so an
    # inherited one would send it back to the real store — outside SCRATCH, where
    # the sandbox denies the writes it needs — ignoring the isolated copy we just
    # prepared. Without HOME it falls back to $HOME/.kimi-code, which is the copy.
    (cd "$workdir" && env -u KIMI_CODE_HOME HOME="$tmp/home" TMPDIR="$tmp/home-tmp" \
      sandbox-exec -D "SCRATCH=$tmp" -p "$sandbox_profile" \
      kimi --prompt "$prompt" --model "$NATIVE_MODEL" \
      --output-format stream-json </dev/null) >"$events" 2>"$tmp/stderr" || rc=$?
  fi
  if [ "$rc" -eq 0 ]; then
    extract_native "$events" "$result_tmp" "$metrics_tmp" "$started" "$effort" "$lane" || rc=70
  fi

  if [ "$rc" -ne 0 ]; then
    cp "$tmp/stderr" "$error_tmp" 2>/dev/null || : >"$error_tmp"
    jq -c 'select(.type == "error") | .error' "$events" >>"$error_tmp" 2>/dev/null || true
    mv -f "$error_tmp" "$output.stderr" 2>/dev/null || true
    auth_failure "$events" "$tmp/stderr" && exit 69
    temporary_failure "$events" "$tmp/stderr" && exit 75
    exit 70
  fi
  mv -f "$result_tmp" "$output" || die 70 "could not finalize output"
  mv -f "$metrics_tmp" "$metrics" || die 70 "could not finalize metrics"
}

case "${1:-}" in
  check)
    shift
    case "${1:-}" in "") print_check 0 ;; --json) shift; [ "$#" -eq 0 ] || die 64 "unknown check argument: $1"; print_check 1 ;; *) die 64 "unknown check argument: $1" ;; esac
    ;;
  run) shift; run_command "$@" ;;
  -h|--help|"") usage ;;
  *) die 64 "unknown command: $1" ;;
esac
