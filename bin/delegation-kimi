#!/usr/bin/env bash
# Run Kimi K3 through the native Kimi Code CLI. Fails closed: model, effort,
# backend, and qualification gates are always explicit and no backend fallback
# occurs after dispatch starts.
set -euo pipefail
umask 077

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
ROUTING_FILE="${DELEGATION_KIMI_ROUTING_FILE:-$ROOT/config/kimi-k3-routing.json}"
CENTRAL_GATES="${DELEGATION_ROUTING_GATES_FILE:-$ROOT/config/routing-gates.json}"
ROUTER="$ROOT/bin/delegation-route"
KIMI_HOME="${KIMI_CODE_HOME:-$HOME/.kimi-code}"
CREDENTIAL_FILE="$KIMI_HOME/credentials/kimi-code.json"
DATA_HOME="${DELEGATION_DATA_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/delegation-kit}"
RG_STORE="${DELEGATION_KIMI_RG_STORE:-$DATA_HOME/kimi-rg}"
NATIVE_MODEL="kimi-code/k3"
NATIVE_EFFORT="max"
EFFORTS='["max"]'
OPERATIONAL_TIMEOUT_SECONDS=900
EVALUATION_TIMEOUT_MAX_SECONDS=1200
HEARTBEAT_SECONDS="${DELEGATION_KIMI_HEARTBEAT_SECONDS:-30}"
case "$HEARTBEAT_SECONDS" in ""|*[!0-9]*|0) HEARTBEAT_SECONDS=30 ;; esac
CANCEL_GRACE_SECONDS="${DELEGATION_KIMI_CANCEL_GRACE_SECONDS:-10}"
case "$CANCEL_GRACE_SECONDS" in ""|*[!0-9]*|0) CANCEL_GRACE_SECONDS=10 ;; esac
# Zero is legal: it means "fail immediately when the kit OAuth lock is busy".
OAUTH_WAIT_SECONDS="${DELEGATION_KIMI_OAUTH_WAIT_SECONDS:-5}"
case "$OAUTH_WAIT_SECONDS" in ""|*[!0-9]*) OAUTH_WAIT_SECONDS=5 ;; esac
NATIVE_BIN=""
NATIVE_VERSION=""
NATIVE_REASON=""
KIMI_PLATFORM=""
KIMI_SANDBOX_BIN=""
KIMI_SHLOCK_BIN=""
KIMI_TIMEOUT_BIN=""
RG_BIN=""
RG_VERSION=""
RG_SHA256=""
RG_DEPENDENCIES_SHA256=""
RG_DEPENDENCY_COUNT=0
RUN_TMP=""
RG_RUN_DIR=""
OAUTH_LOCK_PATH=""
OAUTH_LOCK_HELD=0
OAUTH_BASELINE_HASH=""
OAUTH_MODE="serialized"
SHARED_OAUTH_DIR=""
SHARED_OAUTH_GEN=""
CHILD_PID=""
HEARTBEAT_PID=""
CANCEL_REQUESTED=0
OAUTH_SYNC_STATUS="not_attempted"

usage() {
  cat <<'EOF'
Usage:
  delegation-kimi check [--json]
  delegation-kimi pin-rg [--from <path>] [--force]
  delegation-kimi run --lane <clerk|scout|builder|frontend-builder|reviewer|senior|judgement|policy-annotation> \
    [--effort <auto|low|high|max>] [--backend <auto|native>] \
    [--oauth <serialized|shared>] \
    (--prompt-file <path> | --prompt <text>) --output <path> --workdir <path> \
    [--metrics <path>] [--allow-provisional] [--evaluation --evaluation-manifest <path>] \
    [--preflight-only] [--debug-dir <private-existing-directory>]

`--evaluation` permits only allowlisted candidate lanes for a controlled
qualification run. It never promotes or mutates a gate, adds no operational
route, and does not imply `--allow-provisional`. Policy-annotation is not the
broad architecture/trade-off judgement lane. --preflight-only is valid only
with --evaluation and --evaluation-manifest: it traverses the same pre-provider
validation path as the real evaluation run, prints a
delegation_policy_annotation_preflight_receipt_v1 receipt on stdout, and exits
zero before provider dispatch and before any caller-visible artifact exists.

`--oauth shared` (or DELEGATION_KIMI_OAUTH_MODE=shared) allows concurrent
delegation-kimi dispatches: OAuth state lives in a runner-owned generation
under $DELEGATION_DATA_HOME/kimi-shared-oauth, concurrent children coordinate
refresh through the vendor CLI's own oauth lock, and the kit lock is held only
briefly to seed that generation and to publish it back to the ambient home.
The default, serialized, holds the kit lock for the whole dispatch, exactly as
before. --evaluation runs are always serialized.

Exit codes: 64 invalid input; 69 runtime, login, entitlement, or quota unavailable;
70 sandbox, output, or unclassified dispatch failure; 75 overload, 5xx, timeout,
or temporary OAuth conflict (including a busy or superseded shared OAuth
session); 78 lane not qualified; 130 caller cancellation.
EOF
}

die() { local code="$1"; shift; printf 'delegation-kimi: %s\n' "$*" >&2; exit "$code"; }
have() { command -v "$1" >/dev/null 2>&1; }

release_oauth_lock() {
  local owner_pid=""
  [ "$OAUTH_LOCK_HELD" -eq 1 ] || return 0
  if [ -f "$OAUTH_LOCK_PATH" ] && [ ! -L "$OAUTH_LOCK_PATH" ]; then
    owner_pid="$(<"$OAUTH_LOCK_PATH")"
    [ "$owner_pid" != "$$" ] || rm -f -- "$OAUTH_LOCK_PATH"
  fi
  OAUTH_LOCK_HELD=0
}

cleanup_run() {
  [ -z "$HEARTBEAT_PID" ] || kill "$HEARTBEAT_PID" >/dev/null 2>&1 || true
  [ -z "$CHILD_PID" ] || kill "$CHILD_PID" >/dev/null 2>&1 || true
  release_oauth_lock
  [ -z "$RG_RUN_DIR" ] || rm -rf -- "$RG_RUN_DIR"
  [ -z "$RUN_TMP" ] || rm -rf -- "$RUN_TMP"
}

handle_cancel() {
  CANCEL_REQUESTED=1
  [ -z "$CHILD_PID" ] || kill -TERM "$CHILD_PID" >/dev/null 2>&1 || true
}

acquire_oauth_lock() {
  OAUTH_LOCK_PATH="$KIMI_HOME/.delegation-kit-oauth.lock"
  [ ! -L "$OAUTH_LOCK_PATH" ] || return 1
  "$KIMI_SHLOCK_BIN" -p "$$" -f "$OAUTH_LOCK_PATH" >/dev/null 2>&1 || return 2
  OAUTH_LOCK_HELD=1
}

# Same return contract as acquire_oauth_lock, but a busy lock (rc 2) is retried
# once a second until OAUTH_WAIT_SECONDS expires. A symlinked lock path (rc 1)
# is never retried: that is tampering, not contention.
acquire_oauth_lock_wait() {
  local deadline rc
  deadline="$(( $(date +%s) + OAUTH_WAIT_SECONDS ))"
  while :; do
    rc=0
    acquire_oauth_lock || rc=$?
    [ "$rc" -eq 2 ] || return "$rc"
    [ "$(date +%s)" -lt "$deadline" ] || return 2
    sleep 1
  done
}

shared_oauth_root() { printf '%s/kimi-shared-oauth' "$DATA_HOME"; }

credential_tokens_valid() {
  local credential="$1"
  [ -f "$credential" ] && [ ! -L "$credential" ] || return 1
  jq -e '
    type == "object" and
    ((.access_token // "") | type == "string" and length > 0) and
    ((.refresh_token // "") | type == "string" and length > 0)
  ' "$credential" >/dev/null 2>&1
}

# The marker records which generation is current and the sha256 the ambient and
# shared credentials last agreed on. It lives at the shared root, outside every
# generation, so the sandboxed child can never read or write it.
read_shared_marker() {
  local marker
  marker="$(shared_oauth_root)/sync-marker.json"
  [ -f "$marker" ] && [ ! -L "$marker" ] || return 1
  jq -re '
    select(.schema == "delegation_kimi_shared_oauth_marker_v1") |
    select((.generation | type == "string" and test("^gen-[0-9]+-[0-9]+$")) and
           (.synced_sha256 | type == "string" and test("^[0-9a-f]{64}$"))) |
    "\(.generation) \(.synced_sha256)"
  ' "$marker" 2>/dev/null
}

write_shared_marker() {
  local generation="$1" synced_sha256="$2" root candidate
  root="$(shared_oauth_root)"
  candidate="$(mktemp "$root/.sync-marker.json.XXXXXX")" || return 1
  if ! jq -n --arg generation "$generation" --arg synced_sha256 "$synced_sha256" \
      '{schema:"delegation_kimi_shared_oauth_marker_v1",
        generation:$generation,synced_sha256:$synced_sha256}' >"$candidate" ||
      ! chmod 600 "$candidate" || ! mv -f "$candidate" "$root/sync-marker.json"; then
    rm -f -- "$candidate"
    return 1
  fi
}

# Seed (or adopt) the shared OAuth generation, holding the kit lock only for
# this bookkeeping. Children of concurrent runs then share one credentials/ and
# oauth/ tree, so the vendor CLI's own cross-process lock coordinates
# refresh-token rotation between them. An external `kimi login` always wins: a
# changed ambient credential forces a fresh generation, and old generations are
# never adopted again. Dies on failure; on success sets SHARED_OAUTH_DIR/_GEN.
seed_shared_oauth() {
  local root marker marker_generation="" marker_sha="" ambient_hash generation
  local gen_dir stale lock_rc=0
  root="$(shared_oauth_root)"
  mkdir -p "$root" && chmod 700 "$root" \
    || die 69 "could not create the shared Kimi OAuth root"
  acquire_oauth_lock_wait || lock_rc=$?
  if [ "$lock_rc" -eq 2 ]; then
    die 75 "another Kimi invocation is using the OAuth refresh session; retry after it finishes"
  elif [ "$lock_rc" -ne 0 ]; then
    die 69 "could not secure the Kimi OAuth credential for isolated dispatch"
  fi
  ambient_hash="$(sha256_file "$CREDENTIAL_FILE")" \
    || die 69 "could not fingerprint the ambient Kimi OAuth credential"
  if marker="$(read_shared_marker)"; then
    marker_generation="${marker%% *}"
    marker_sha="${marker##* }"
  fi
  if [ -n "$marker_generation" ] && [ "$marker_sha" = "$ambient_hash" ] &&
      credential_tokens_valid "$root/$marker_generation/credentials/kimi-code.json"; then
    SHARED_OAUTH_GEN="$marker_generation"
  else
    generation="gen-$(date +%s)-$$"
    gen_dir="$root/$generation"
    mkdir -p "$gen_dir/credentials" "$gen_dir/oauth" \
      || die 69 "could not create the shared Kimi OAuth generation"
    cp "$CREDENTIAL_FILE" "$gen_dir/credentials/kimi-code.json" &&
      chmod 600 "$gen_dir/credentials/kimi-code.json" \
      || die 69 "could not seed the shared Kimi OAuth generation"
    if [ -f "$KIMI_HOME/oauth/kimi-code" ] && [ ! -L "$KIMI_HOME/oauth/kimi-code" ]; then
      cp "$KIMI_HOME/oauth/kimi-code" "$gen_dir/oauth/kimi-code" &&
        chmod 600 "$gen_dir/oauth/kimi-code" \
        || die 69 "could not seed the shared Kimi OAuth generation"
    fi
    write_shared_marker "$generation" "$ambient_hash" \
      || die 69 "could not record the shared Kimi OAuth generation"
    # Bounded cleanup: keep the new generation plus the immediately superseded
    # one (a still-running child may hold it); anything older is dead state.
    for stale in "$root"/gen-*; do
      [ -d "$stale" ] || continue
      case "$(basename "$stale")" in
        "$generation"|"$marker_generation") ;;
        *) rm -rf -- "$stale" ;;
      esac
    done
    SHARED_OAUTH_GEN="$generation"
  fi
  release_oauth_lock
  SHARED_OAUTH_DIR="$(cd "$root/$SHARED_OAUTH_GEN" && pwd -P)" \
    || die 69 "could not resolve the shared Kimi OAuth generation"
}

# Publish the shared credential back to the ambient home, holding the kit lock
# only for the copy. Returns 0 published-or-nothing-to-publish, 1 failed,
# 2 external conflict (an external `kimi login` wins, exactly as in serialized
# mode), 3 deferred (the kit lock stayed busy; the shared state is durable and
# a concurrent delegation run will publish instead). Never dies; the lock is
# released on every path.
publish_shared_oauth() {
  local marker marker_generation marker_sha shared_credential shared_hash
  local ambient_hash target_dir candidate lock_rc=0 rc=0
  shared_credential="$(shared_oauth_root)/$SHARED_OAUTH_GEN/credentials/kimi-code.json"
  acquire_oauth_lock_wait || lock_rc=$?
  [ "$lock_rc" -ne 2 ] || return 3
  [ "$lock_rc" -eq 0 ] || return 1
  if ! marker="$(read_shared_marker)"; then
    rc=1
  else
    marker_generation="${marker%% *}"
    marker_sha="${marker##* }"
    if [ "$marker_generation" != "$SHARED_OAUTH_GEN" ]; then
      rc=2
    elif ! shared_hash="$(sha256_file "$shared_credential")"; then
      rc=1
    elif [ "$shared_hash" = "$marker_sha" ]; then
      rc=0
    elif ! credential_tokens_valid "$shared_credential"; then
      rc=1
    elif [ ! -f "$CREDENTIAL_FILE" ] || [ -L "$CREDENTIAL_FILE" ]; then
      rc=2
    elif ! ambient_hash="$(sha256_file "$CREDENTIAL_FILE")"; then
      rc=1
    elif [ "$ambient_hash" != "$marker_sha" ]; then
      rc=2
    else
      target_dir="$(dirname "$CREDENTIAL_FILE")"
      # Publish before advancing the marker: a crash in between leaves the
      # ambient credential newest and the marker stale, and the next seed
      # reseeds from ambient — the newest state. The reverse order could
      # strand the newest token.
      if candidate="$(mktemp "$target_dir/.kimi-code.json.delegation-kimi.XXXXXX")" &&
          cp "$shared_credential" "$candidate" && chmod 600 "$candidate" &&
          mv -f "$candidate" "$CREDENTIAL_FILE"; then
        write_shared_marker "$SHARED_OAUTH_GEN" "$shared_hash" || rc=1
      else
        rm -f -- "${candidate:-}"
        rc=1
      fi
    fi
  fi
  release_oauth_lock
  return "$rc"
}

sandbox_status() {
  KIMI_PLATFORM="${DELEGATION_KIMI_PLATFORM:-$(uname)}"
  KIMI_SANDBOX_BIN="${DELEGATION_KIMI_SANDBOX_BIN:-/usr/bin/sandbox-exec}"
  KIMI_SHLOCK_BIN="${DELEGATION_KIMI_SHLOCK_BIN:-/usr/bin/shlock}"
  [ "$KIMI_PLATFORM" = Darwin ] \
    || { NATIVE_REASON="native Kimi lanes require macOS sandbox-exec"; return 1; }
  [ -x "$KIMI_SANDBOX_BIN" ] \
    || { NATIVE_REASON="native Kimi lanes require executable sandbox-exec at $KIMI_SANDBOX_BIN"; return 1; }
  [ -x "$KIMI_SHLOCK_BIN" ] \
    || { NATIVE_REASON="native Kimi lanes require executable shlock at $KIMI_SHLOCK_BIN"; return 1; }
  if have gtimeout; then KIMI_TIMEOUT_BIN="$(command -v gtimeout)"
  elif have timeout; then KIMI_TIMEOUT_BIN="$(command -v timeout)"
  else
    NATIVE_REASON="native Kimi lanes require gtimeout or timeout"
    return 1
  fi
}

native_status() {
  NATIVE_REASON=""
  have kimi || { NATIVE_REASON="kimi not on PATH"; return 1; }
  sandbox_status || return 1
  verify_pinned_rg || return 1
  local help doctor_help providers providers_text status_tmp
  NATIVE_BIN="$(command -v kimi)"
  NATIVE_VERSION="$("$NATIVE_BIN" --version 2>/dev/null | head -1 || true)"
  NATIVE_VERSION="${NATIVE_VERSION:-unknown}"
  help="$("$NATIVE_BIN" --help 2>&1 || true)"
  grep -q -- '--output-format' <<<"$help" && grep -q -- 'stream-json' <<<"$help" \
    || { NATIVE_REASON="kimi lacks stream-json output"; return 1; }
  grep -q -- '--agent-file' <<<"$help" \
    || { NATIVE_REASON="kimi lacks --agent-file"; return 1; }
  grep -q -- '--skills-dir' <<<"$help" \
    || { NATIVE_REASON="kimi lacks --skills-dir"; return 1; }
  doctor_help="$("$NATIVE_BIN" doctor --help 2>&1 || true)"
  grep -q -- 'config' <<<"$doctor_help" \
    || { NATIVE_REASON="kimi lacks doctor config validation"; return 1; }
  # Probe the exact minimal HOME used for dispatch. The ambient Kimi default is
  # user preference and may legitimately differ from the evaluated max effort;
  # only the isolated config's effective default is relevant to this runner.
  status_tmp="$(mktemp -d "${TMPDIR:-/tmp}/delegation-kimi-status.XXXXXX")" \
    || { NATIVE_REASON="could not create isolated Kimi status directory"; return 1; }
  if ! prepare_native_home "$status_tmp" scout; then
    rm -rf -- "$status_tmp"
    NATIVE_REASON="could not prepare isolated Kimi status home"
    return 1
  fi
  if ! HOME="$status_tmp/home" KIMI_CODE_HOME="$status_tmp/home/.kimi-code" \
      KIMI_DISABLE_TELEMETRY=1 KIMI_CODE_NO_AUTO_UPDATE=1 KIMI_DISABLE_CRON=1 \
      "$NATIVE_BIN" doctor config "$status_tmp/home/.kimi-code/config.toml" \
      >/dev/null 2>&1; then
    rm -rf -- "$status_tmp"
    NATIVE_REASON="isolated Kimi configuration failed validation"
    return 1
  fi
  providers="$(HOME="$status_tmp/home" KIMI_CODE_HOME="$status_tmp/home/.kimi-code" \
    KIMI_DISABLE_TELEMETRY=1 KIMI_CODE_NO_AUTO_UPDATE=1 KIMI_DISABLE_CRON=1 \
    "$NATIVE_BIN" provider list --json 2>/dev/null || true)"
  providers_text="$(HOME="$status_tmp/home" KIMI_CODE_HOME="$status_tmp/home/.kimi-code" \
    KIMI_DISABLE_TELEMETRY=1 KIMI_CODE_NO_AUTO_UPDATE=1 KIMI_DISABLE_CRON=1 \
    "$NATIVE_BIN" provider list 2>/dev/null || true)"
  rm -rf -- "$status_tmp"
  jq -e --arg model "$NATIVE_MODEL" '.models[$model] != null' <<<"$providers" >/dev/null 2>&1 \
    || { NATIVE_REASON="$NATIVE_MODEL is not configured"; return 1; }
  # Kimi Code has no per-invocation effort flag. The provider must both support
  # and default to the exact evaluated effort; the isolated runtime config below
  # pins the same value so an ambient config change cannot weaken the run.
  jq -e --arg model "$NATIVE_MODEL" --arg effort "$NATIVE_EFFORT" '
    .models[$model].model == "k3" and
    ((.models[$model].supportEfforts // []) | index($effort) != null) and
    .models[$model].defaultEffort == $effort
  ' <<<"$providers" >/dev/null 2>&1 \
    || { NATIVE_REASON="$NATIVE_MODEL does not attest K3 default effort $NATIVE_EFFORT"; return 1; }
  grep -Eq 'managed:kimi-code.*source=oauth' <<<"$providers_text" \
    || { NATIVE_REASON="$NATIVE_MODEL is not an OAuth-managed Kimi Code provider"; return 1; }
  # `source=oauth` above describes how the provider is configured; it prints
  # identically after a logout, so it can never see a missing credential. Read
  # the credential itself. Emptiness is the only sound local signal: both tokens
  # blank means logged out, full stop. Do not gate on expires_at — the access
  # token lives ~15 minutes and the refresh token silently renews it, so a live
  # session is expired most of the time.
  jq -e '((.access_token // "") | length > 0) or ((.refresh_token // "") | length > 0)' \
    "$CREDENTIAL_FILE" >/dev/null 2>&1 \
    || { NATIVE_REASON="Kimi Code is logged out — run: kimi login"; return 1; }
  NATIVE_REASON="ready"
  return 0
}

qualified_lanes() {
  if [ -f "$CENTRAL_GATES" ] && have jq; then
    jq -c '[.profiles["kimi-k3"].lanes | to_entries[] | select(.value.status == "qualified") | .key] | sort' "$CENTRAL_GATES" 2>/dev/null || printf '[]'
  else
    printf '[]'
  fi
}

provisional_lanes() {
  if [ -f "$CENTRAL_GATES" ] && have jq; then
    jq -c '[.profiles["kimi-k3"].lanes | to_entries[] | select(.value.status == "provisional") | .key] | sort' "$CENTRAL_GATES" 2>/dev/null || printf '[]'
  else
    printf '[]'
  fi
}

gate_status() {
  local lane="$1" backend="$2"
  [ "$backend" = native ] || { printf 'disabled\n'; return; }
  jq -r --arg lane "$lane" '.profiles["kimi-k3"].lanes[$lane].status // "disabled"' \
    "$CENTRAL_GATES" 2>/dev/null || printf 'disabled\n'
}

is_allowed() {
  local lane="$1" backend="$2" allow_provisional="$3" evaluation="$4" status
  status="$(gate_status "$lane" "$backend")"
  [ "$status" = qualified ] ||
    { [ "$status" = provisional ] && [ "$allow_provisional" = 1 ]; } ||
    { [ "$status" = candidate ] && [ "$evaluation" = 1 ]; }
}

preferred_backends() {
  local lane="$1"
  jq -r --arg lane "$lane" '
    (.lanes[$lane].preferred_backends // .preferred_backends // ["native"])[]
  ' "$ROUTING_FILE" 2>/dev/null || printf 'native\n'
}

default_effort() {
  jq -r '.profiles["kimi-k3"].effort // empty' "$CENTRAL_GATES" 2>/dev/null
}

qualified_effort() {
  local lane="$1" backend="$2"
  [ "$backend" = native ] || return 1
  [ "$(gate_status "$lane" "$backend")" != disabled ] || return 1
  default_effort
}

validate_gate_graph() {
  [ -x "$ROUTER" ] || return 1
  DELEGATION_ROUTING_GATES_FILE="$CENTRAL_GATES" \
    DELEGATION_KIMI_ROUTING_FILE="$ROUTING_FILE" \
    "$ROUTER" check --json >/dev/null 2>&1
}

sha256_file() {
  if have shasum; then shasum -a 256 "$1" | awk '{print $1}';
  elif have sha256sum; then sha256sum "$1" | awk '{print $1}';
  else return 1; fi
}

pinned_rg_path() { printf '%s/current/rg' "$RG_STORE"; }
pinned_rg_digest_path() { printf '%s/current/rg.sha256' "$RG_STORE"; }
pinned_rg_version_path() { printf '%s/current/rg.version' "$RG_STORE"; }
pinned_rg_dependencies_path() { printf '%s/current/dependencies.json' "$RG_STORE"; }
pinned_rg_dependencies_digest_path() { printf '%s/current/dependencies.sha256' "$RG_STORE"; }

resolve_macho_dependency() {
  local binary="$1" dependency="$2" suffix="" rpath=""
  case "$dependency" in
    /usr/lib/*|/System/Library/*) return 2 ;;
    /*)
      [ -f "$dependency" ] || return 1
      printf '%s/%s\n' "$(cd "$(dirname "$dependency")" && pwd -P)" "$(basename "$dependency")"
      return 0
      ;;
    @loader_path/*)
      suffix="${dependency#@loader_path/}"
      printf '%s/%s\n' "$(cd "$(dirname "$binary")" && pwd -P)" "$suffix"
      return 0
      ;;
    @executable_path/*)
      suffix="${dependency#@executable_path/}"
      printf '%s/%s\n' "$(cd "$(dirname "$binary")" && pwd -P)" "$suffix"
      return 0
      ;;
    @rpath/*)
      suffix="${dependency#@rpath/}"
      while IFS= read -r rpath; do
        case "$rpath" in
          @loader_path/*) rpath="$(dirname "$binary")/${rpath#@loader_path/}" ;;
          @executable_path/*) rpath="$(dirname "$binary")/${rpath#@executable_path/}" ;;
        esac
        if [ -f "$rpath/$suffix" ]; then
          printf '%s\n' "$(cd "$(dirname "$rpath/$suffix")" && pwd -P)/$(basename "$rpath/$suffix")"
          return 0
        fi
      done < <(/usr/bin/otool -l "$binary" 2>/dev/null |
        awk '$1 == "cmd" && $2 == "LC_RPATH" {found=1; next} found && $1 == "path" {print $2; found=0}')
      return 1
      ;;
    *) return 1 ;;
  esac
}

write_dependency_manifest() {
  local binary="$1" output="$2" dependency resolved digest next resolve_rc
  [ "$KIMI_PLATFORM" = Darwin ] || KIMI_PLATFORM="${DELEGATION_KIMI_PLATFORM:-$(uname)}"
  printf '[]\n' >"$output"
  [ "$KIMI_PLATFORM" = Darwin ] || return 0
  [ -x /usr/bin/otool ] || return 1
  while IFS= read -r dependency; do
    [ -n "$dependency" ] || continue
    resolved=""
    resolve_rc=0
    resolved="$(resolve_macho_dependency "$binary" "$dependency")" || resolve_rc=$?
    if [ "$resolve_rc" -ne 0 ]; then
      [ "$resolve_rc" -eq 2 ] && continue
      return 1
    fi
    [ -f "$resolved" ] && [ ! -L "$resolved" ] || return 1
    digest="$(sha256_file "$resolved")" || return 1
    next="$output.next"
    jq --arg path "$resolved" --arg sha256 "$digest" \
      '. + [{path:$path,sha256:$sha256}] | unique_by(.path) | sort_by(.path)' \
      "$output" >"$next" || return 1
    mv -f "$next" "$output" || return 1
  done < <(/usr/bin/otool -L "$binary" 2>/dev/null | tail -n +2 | awk '{print $1}')
}

verify_pinned_rg() {
  local binary digest_file version_file dependencies dependencies_digest_file expected actual
  local generated generated_digest dependency_path real_home
  binary="$(pinned_rg_path)"
  digest_file="$(pinned_rg_digest_path)"
  version_file="$(pinned_rg_version_path)"
  dependencies="$(pinned_rg_dependencies_path)"
  dependencies_digest_file="$(pinned_rg_dependencies_digest_path)"
  [ -x "$binary" ] && [ ! -L "$binary" ] || {
    NATIVE_REASON="verified ripgrep is not pinned; run: delegation-kimi pin-rg"
    return 1
  }
  [ ! -L "$RG_STORE/current" ] &&
    [ -f "$digest_file" ] && [ ! -L "$digest_file" ] &&
    [ -f "$version_file" ] && [ ! -L "$version_file" ] &&
    [ -f "$dependencies" ] && [ ! -L "$dependencies" ] &&
    [ -f "$dependencies_digest_file" ] && [ ! -L "$dependencies_digest_file" ] || {
      NATIVE_REASON="pinned ripgrep attestation is incomplete; re-run: delegation-kimi pin-rg --force"
      return 1
    }
  expected="$(awk 'NR == 1 {print $1}' "$digest_file")"
  actual="$(sha256_file "$binary")" || {
    NATIVE_REASON="sha256 tool is required to verify pinned ripgrep"
    return 1
  }
  [ -n "$expected" ] && [ "$actual" = "$expected" ] || {
    NATIVE_REASON="pinned ripgrep digest mismatch; re-run: delegation-kimi pin-rg --force"
    return 1
  }
  RG_VERSION="$("$binary" --version 2>/dev/null | head -1 || true)"
  expected="$(head -1 "$version_file" 2>/dev/null || true)"
  [[ "$RG_VERSION" =~ ^ripgrep[[:space:]][0-9] ]] && [ "$RG_VERSION" = "$expected" ] || {
    NATIVE_REASON="pinned search runtime is not the attested ripgrep build"
    return 1
  }
  jq -e 'type == "array" and all(.[]; (.path | type == "string") and
    (.sha256 | type == "string" and test("^[0-9a-f]{64}$")))' \
    "$dependencies" >/dev/null 2>&1 || {
      NATIVE_REASON="pinned ripgrep dependency manifest is invalid"
      return 1
    }
  generated="$(mktemp "${TMPDIR:-/tmp}/delegation-kimi-rg-deps.XXXXXX")" || return 1
  if ! write_dependency_manifest "$binary" "$generated"; then
    rm -f -- "$generated"
    NATIVE_REASON="could not attest pinned ripgrep dependencies"
    return 1
  fi
  generated_digest="$(sha256_file "$generated")" || { rm -f -- "$generated"; return 1; }
  expected="$(awk 'NR == 1 {print $1}' "$dependencies_digest_file")"
  if [ "$generated_digest" != "$expected" ] || ! cmp -s "$generated" "$dependencies"; then
    rm -f -- "$generated"
    NATIVE_REASON="pinned ripgrep dependency digest mismatch; re-run: delegation-kimi pin-rg --force"
    return 1
  fi
  rm -f -- "$generated"
  real_home="$(cd "${HOME:?HOME is required}" && pwd -P)"
  while IFS= read -r dependency_path; do
    case "$dependency_path" in
      "$real_home"/*)
        NATIVE_REASON="pinned ripgrep depends on ambient HOME data: $dependency_path"
        return 1
        ;;
    esac
  done < <(jq -r '.[].path' "$dependencies")
  RG_BIN="$binary"
  RG_SHA256="$actual"
  RG_DEPENDENCIES_SHA256="$generated_digest"
  RG_DEPENDENCY_COUNT="$(jq 'length' "$dependencies")"
}

copy_verified_rg() {
  local destination="$1" copied_digest copied_version
  verify_pinned_rg || return 1
  mkdir -p "$(dirname "$destination")"
  cp "$RG_BIN" "$destination" && chmod 500 "$destination" || return 1
  copied_digest="$(sha256_file "$destination")" || return 1
  [ "$copied_digest" = "$RG_SHA256" ] || return 1
  copied_version="$("$destination" --version 2>/dev/null | head -1 || true)"
  [ "$copied_version" = "$RG_VERSION" ]
}

pin_rg_command() {
  local from="" force=0 source digest existing stage target previous source_dir source_link
  local source_version symlink_hops=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --from) from="${2:-}"; shift 2 ;;
      --force) force=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die 64 "unknown pin-rg argument: $1" ;;
    esac
  done
  have jq || die 69 "jq is required"
  have shasum || have sha256sum || die 69 "shasum or sha256sum is required"
  if [ -n "$from" ]; then source="$from"
  elif have rg; then source="$(command -v rg)"
  else die 69 "rg is not on PATH; pass --from <path>"; fi
  while [ -L "$source" ]; do
    symlink_hops=$((symlink_hops + 1))
    [ "$symlink_hops" -le 40 ] || die 64 "--from symlink chain is too deep or cyclic"
    source_dir="$(cd "$(dirname "$source")" && pwd -P)"
    source_link="$(readlink "$source")"
    case "$source_link" in
      /*) source="$source_link" ;;
      *) source="$source_dir/$source_link" ;;
    esac
  done
  [ -f "$source" ] && [ -x "$source" ] \
    || die 64 "--from is not a regular executable file: $source"
  source="$(cd "$(dirname "$source")" && pwd -P)/$(basename "$source")"
  source_version="$("$source" --version 2>/dev/null | head -1 || true)"
  [[ "$source_version" =~ ^ripgrep[[:space:]][0-9] ]] \
    || die 64 "--from does not identify itself as ripgrep: $source"
  digest="$(sha256_file "$source")" || die 70 "could not hash $source"
  target="$(pinned_rg_path)"
  if [ -e "$target" ] || [ -L "$target" ]; then
    existing="$(sha256_file "$target" 2>/dev/null || true)"
    if [ "$existing" = "$digest" ] && verify_pinned_rg; then
      printf 'delegation-kimi: compatible ripgrep already pinned at %s\n' "$target"
      return 0
    fi
    [ "$existing" = "$digest" ] || [ "$force" -eq 1 ] \
      || die 64 "different or invalid ripgrep bytes are already pinned at $target; pass --force to replace them"
  fi
  mkdir -p "$RG_STORE"
  stage="$(mktemp -d "$RG_STORE/.pin-rg.XXXXXX")" || die 70 "could not create ripgrep pin stage"
  if ! cp "$source" "$stage/rg" || ! chmod 500 "$stage/rg"; then
    rm -rf -- "$stage"
    die 70 "could not archive $source"
  fi
  digest="$(sha256_file "$stage/rg")" \
    || { rm -rf -- "$stage"; die 70 "could not hash archived ripgrep"; }
  printf '%s  rg\n' "$digest" >"$stage/rg.sha256"
  printf '%s\n' "$source_version" >"$stage/rg.version"
  if ! write_dependency_manifest "$stage/rg" "$stage/dependencies.json"; then
    rm -rf -- "$stage"
    die 70 "could not attest non-system ripgrep dependencies"
  fi
  printf '%s  dependencies.json\n' "$(sha256_file "$stage/dependencies.json")" \
    >"$stage/dependencies.sha256"
  chmod 400 "$stage/rg.sha256" "$stage/rg.version" \
    "$stage/dependencies.json" "$stage/dependencies.sha256"
  previous="$RG_STORE/.previous.$$"
  if [ -d "$RG_STORE/current" ]; then
    mv "$RG_STORE/current" "$previous" \
      || { rm -rf -- "$stage"; die 70 "could not stage existing ripgrep archive"; }
  fi
  if ! mv "$stage" "$RG_STORE/current"; then
    [ ! -d "$previous" ] || mv "$previous" "$RG_STORE/current" || true
    rm -rf -- "$stage"
    die 70 "could not finalize ripgrep archive"
  fi
  rm -rf -- "$previous"
  verify_pinned_rg || die 70 "$NATIVE_REASON"
  printf 'delegation-kimi: pinned ripgrep\n  from: %s\n  to:   %s\n  sha256: %s\n  dependencies_sha256: %s\n' \
    "$source" "$RG_BIN" "$RG_SHA256" "$RG_DEPENDENCIES_SHA256"
}

sync_native_credentials() {
  local scratch_credential="$1/home/.kimi-code/credentials/kimi-code.json"
  local scratch_hash current_hash target_dir candidate
  [ -f "$scratch_credential" ] && [ ! -L "$scratch_credential" ] || return 1
  scratch_hash="$(sha256_file "$scratch_credential")" || return 1
  [ "$scratch_hash" != "$OAUTH_BASELINE_HASH" ] || return 0
  credential_tokens_valid "$scratch_credential" || return 1

  # A normal `kimi login` or another non-delegation client may have replaced
  # the ambient credential while this run was active. Refuse to publish this
  # run instead of knowingly overwriting that newer external state. Callers
  # must not run login concurrently: no lock can coordinate a client that does
  # not participate in this runner's locking protocol. (Serialized mode only —
  # shared mode publishes through publish_shared_oauth, whose generation marker
  # provides the equivalent protection.)
  if [ ! -f "$CREDENTIAL_FILE" ] || [ -L "$CREDENTIAL_FILE" ]; then
    return 2
  fi
  current_hash="$(sha256_file "$CREDENTIAL_FILE")" || return 1
  [ "$current_hash" = "$OAUTH_BASELINE_HASH" ] || return 2

  target_dir="$(dirname "$CREDENTIAL_FILE")"
  candidate="$(mktemp "$target_dir/.kimi-code.json.delegation-kimi.XXXXXX")" || return 1
  if ! cp "$scratch_credential" "$candidate" || ! chmod 600 "$candidate" || ! mv -f "$candidate" "$CREDENTIAL_FILE"; then
    rm -f -- "$candidate"
    return 1
  fi
}

evaluation_manifest() {
  local manifest="$1" lane="$2" prompt_file="$3" expected_effort="$4"
  local hash expected_hash source_head runner_hash contract_path output_schema_path contract_hash output_schema_hash
  [ -f "$manifest" ] && [ ! -L "$manifest" ] || die 78 "evaluation manifest is missing or symlinked"
  hash="$(sha256_file "$manifest")" || die 69 "sha256 tool is required for evaluation"
  expected_hash="$(sha256_file "$prompt_file")" || die 69 "sha256 tool is required for evaluation"
  source_head="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null)" || die 78 "runner source checkout is unavailable"
  runner_hash="$(sha256_file "$SOURCE")" || die 69 "sha256 tool is required for evaluation"
  git -C "$ROOT" diff --quiet && git -C "$ROOT" diff --cached --quiet &&
    [ -z "$(git -C "$ROOT" ls-files --others --exclude-standard)" ] || die 78 "runner source checkout is dirty"
  jq -e --arg lane "$lane" --arg model "$NATIVE_MODEL" --arg effort "$expected_effort" \
    --arg prompt_sha256 "$expected_hash" --arg runner_sha256 "$runner_hash" \
    --argjson evaluation_timeout_max "$EVALUATION_TIMEOUT_MAX_SECONDS" '
      (keys | sort) == ["backend","contract_path","contract_sha256","effort","lane","max_output_chars","model","output_schema_path","output_schema_sha256","profile","prompt_sha256","runner_sha256","runner_source_commit","schema","timeout_seconds"] and
      .schema == "delegation_policy_annotation_evaluation_v1" and
      .profile == "kimi-k3" and .lane == $lane and .model == $model and
      .backend == "native" and .effort == $effort and .prompt_sha256 == $prompt_sha256 and
      .runner_sha256 == $runner_sha256 and
      ([.prompt_sha256,.output_schema_sha256,.contract_sha256,.runner_sha256] | all(test("^[0-9a-f]{64}$"))) and
      (.runner_source_commit | test("^[0-9a-f]{40}$")) and
      (.contract_path | type == "string" and test("^(?!/)(?!.*(^|/)\\.\\.(/|$)).+")) and
      (.output_schema_path | type == "string" and test("^(?!/)(?!.*(^|/)\\.\\.(/|$)).+")) and
      (.timeout_seconds | type == "number" and floor == . and . >= 1 and . <= $evaluation_timeout_max) and
      (.max_output_chars | type == "number" and floor == . and . >= 1 and . <= 65536)
    ' "$manifest" >/dev/null 2>&1 || die 78 "evaluation manifest is malformed or does not bind this exact run"
  git -C "$ROOT" merge-base --is-ancestor "$(jq -r '.runner_source_commit' "$manifest")" "$source_head" \
    || die 78 "evaluation manifest source commit is not an ancestor of this runner checkout"
  contract_path="$(jq -r '.contract_path' "$manifest")"
  output_schema_path="$(jq -r '.output_schema_path' "$manifest")"
  [ -f "$ROOT/$contract_path" ] && [ ! -L "$ROOT/$contract_path" ] \
    || die 78 "evaluation contract path is missing or symlinked"
  [ -f "$ROOT/$output_schema_path" ] && [ ! -L "$ROOT/$output_schema_path" ] \
    || die 78 "evaluation output schema path is missing or symlinked"
  contract_hash="$(sha256_file "$ROOT/$contract_path")" || die 69 "sha256 tool is required for evaluation"
  output_schema_hash="$(sha256_file "$ROOT/$output_schema_path")" || die 69 "sha256 tool is required for evaluation"
  [ "$contract_hash" = "$(jq -r '.contract_sha256' "$manifest")" ] \
    || die 78 "evaluation contract hash does not match its bound path"
  [ "$output_schema_hash" = "$(jq -r '.output_schema_sha256' "$manifest")" ] \
    || die 78 "evaluation output schema hash does not match its bound path"
  jq -e --arg lane "$lane" --arg hash "$hash" '
    .profiles["kimi-k3"].lanes[$lane].evaluation_manifest_sha256 | type == "array" and index($hash) != null
  ' "$CENTRAL_GATES" >/dev/null 2>&1 || die 78 "evaluation manifest is not allowlisted by the central gate"
  jq -e --arg lane "$lane" --arg hash "$hash" '
    .lanes[$lane].backends.native.evaluation_manifest_sha256 | type == "array" and index($hash) != null
  ' "$ROUTING_FILE" >/dev/null 2>&1 || die 78 "evaluation manifest is not allowlisted by the executable gate"
  EVALUATION_TIMEOUT_SECONDS="$(jq -r '.timeout_seconds' "$manifest")"
  EVALUATION_MAX_OUTPUT_CHARS="$(jq -r '.max_output_chars' "$manifest")"
  # Bound values the run receipt republishes; recomputed locally, never caller input.
  EVALUATION_MANIFEST_SHA256="$hash"
  EVALUATION_PROMPT_SHA256="$expected_hash"
  EVALUATION_RUNNER_SOURCE_COMMIT="$source_head"
  EVALUATION_RUNNER_SHA256="$runner_hash"
  EVALUATION_CONTRACT_SHA256="$contract_hash"
  EVALUATION_OUTPUT_SCHEMA_SHA256="$output_schema_hash"
}

# Success stdout for --preflight-only: exactly one JSON object, every value
# recomputed by the validation path above, never taken from caller input.
print_preflight_receipt() {
  local lane="$1" effort="$2"
  jq -n --arg profile "kimi-k3" --arg model "$NATIVE_MODEL" --arg backend "native" \
    --arg effort "$effort" --arg lane "$lane" \
    --arg manifest_sha256 "$EVALUATION_MANIFEST_SHA256" \
    --arg prompt_sha256 "$EVALUATION_PROMPT_SHA256" \
    --arg source_commit "$EVALUATION_RUNNER_SOURCE_COMMIT" \
    --arg runner_sha256 "$EVALUATION_RUNNER_SHA256" \
    --arg contract_sha256 "$EVALUATION_CONTRACT_SHA256" \
    --arg output_schema_sha256 "$EVALUATION_OUTPUT_SCHEMA_SHA256" \
    '{schema_version:"delegation_policy_annotation_preflight_receipt_v1",
      status:"READY_NO_PROVIDER_CALL",
      profile:$profile,model:$model,backend:$backend,effort:$effort,lane:$lane,
      evaluation_manifest_sha256:$manifest_sha256,prompt_sha256:$prompt_sha256,
      runner_source_commit:$source_commit,runner_sha256:$runner_sha256,
      contract_sha256:$contract_sha256,output_schema_sha256:$output_schema_sha256,
      provider_dispatch_started:false,provider_attempts:0,post_observation_retries:0}'
}

failure_contains() {
  local events="$1" stderr="$2" pattern="$3"
  grep -Eqi "$pattern" "$stderr" 2>/dev/null ||
    jq -se --arg pattern "$pattern" '
      any(.[];
        type == "object" and .type == "error" and
        (((.error // .message // "") | tostring) | test($pattern; "i")))
    ' "$events" >/dev/null 2>&1
}

classify_dispatch_failure() {
  local events="$1" stderr="$2" vendor_rc="$3" evaluation="$4"
  if [ "$CANCEL_REQUESTED" -eq 1 ]; then
    printf '%s\n' '130|caller_cancelled|dispatch'
  elif [ "$vendor_rc" -eq 124 ] || [ "$vendor_rc" -eq 137 ]; then
    [ "$evaluation" -eq 1 ] \
      && printf '%s\n' '75|evaluation_timeout|dispatch' \
      || printf '%s\n' '75|operational_timeout|dispatch'
  elif failure_contains "$events" "$stderr" \
      "usage limit for this billing cycle|usage limit for this period|monthly usage limit|quota (has been )?(fully )?(used|consumed|exhausted)|quota will be refreshed"; then
    printf '%s\n' '69|quota_unavailable|dispatch'
  elif failure_contains "$events" "$stderr" \
      "sandbox|operation not permitted|deny\\(|process-exec"; then
    printf '%s\n' '70|sandbox_failure|dispatch'
  elif failure_contains "$events" "$stderr" \
      "subscription does not have access|plan supports only|access terminated|model id does not exist|not found the model"; then
    printf '%s\n' '69|entitlement_unavailable|dispatch'
  elif failure_contains "$events" "$stderr" \
      "auth\\.login_required|login_required|requires login|invalid authentication|api key appears to be invalid|unauthorized"; then
    printf '%s\n' '69|authentication_unavailable|dispatch'
  elif failure_contains "$events" "$stderr" \
      "unable to verify (your )?membership benefits|statusCode[^0-9]*402"; then
    printf '%s\n' '75|membership_verification_temporary|dispatch'
  elif failure_contains "$events" "$stderr" \
      "engine is currently overloaded|receiving too many requests|too many concurrent requests"; then
    printf '%s\n' '75|provider_overloaded|dispatch'
  elif failure_contains "$events" "$stderr" \
      "503 service unavailable|504 gateway timeout|502 bad gateway|internal:.*(conn closed|bad connection|i/o timeout|unexpected eof)|statusCode[^0-9]*5[0-9][0-9]"; then
    printf '%s\n' '75|provider_temporary_failure|dispatch'
  elif failure_contains "$events" "$stderr" \
      "context cancel(l)?ed|context deadline exceeded"; then
    printf '%s\n' '75|provider_timeout|dispatch'
  else
    printf '%s\n' '70|dispatch_unclassified|dispatch'
  fi
}

lane_tools_json() {
  case "$1" in
    clerk|scout) printf '%s\n' '["Read","Glob","Grep","TodoList"]' ;;
    builder) printf '%s\n' '["Read","Glob","Grep","TodoList","Write","Edit"]' ;;
    frontend-builder) printf '%s\n' '["Read","Glob","Grep","TodoList","Write","Edit","ReadMediaFile"]' ;;
    policy-annotation) printf '%s\n' '[]' ;;
    *) printf '%s\n' '[]' ;;
  esac
}

event_summary_json() {
  local events="$1"
  jq -s '
    [ .[] | select(type == "object") ] as $events |
    ([ $events[] |
       (.tool_calls[]?.function.name //
        .content[]?.tool_calls[]?.function.name //
        .name? // empty) |
       select(type == "string" and length > 0) ]) as $tools |
    {total_events:($events | length),
     assistant_events:([$events[] | select(.role == "assistant")] | length),
     tool_events:([$events[] | select(.role == "tool")] | length),
     error_events:([$events[] | select(.type == "error")] | length),
     tool_calls:($tools | length),
     last_tool:($tools | last // null)}
  ' "$events" 2>/dev/null || printf '%s\n' \
    '{"total_events":0,"assistant_events":0,"tool_events":0,"error_events":0,"tool_calls":0,"last_tool":null}'
}

start_heartbeat() {
  local child_pid="$1" events="$2" started="$3"
  (
    while kill -0 "$child_pid" >/dev/null 2>&1; do
      sleep "$HEARTBEAT_SECONDS"
      kill -0 "$child_pid" >/dev/null 2>&1 || exit 0
      local_now="$(date +%s)"
      local_count="$(wc -l <"$events" 2>/dev/null | tr -d ' ' || printf 0)"
      local_last="$(event_summary_json "$events" | jq -r '.last_tool // "none"' 2>/dev/null || printf none)"
      printf 'delegation-kimi: heartbeat duration=%ss events=%s last_tool=%s\n' \
        "$((local_now - started))" "${local_count:-0}" "${local_last:-none}" >&2
    done
  ) &
  HEARTBEAT_PID=$!
}

validate_debug_dir() {
  local directory="$1" mode
  [ -d "$directory" ] && [ ! -L "$directory" ] && [ -w "$directory" ] && [ -x "$directory" ] || return 1
  mode="$(stat -f '%Lp' "$directory" 2>/dev/null || stat -c '%a' "$directory" 2>/dev/null)" || return 1
  case "$mode" in *[!0-7]*|"") return 1 ;; esac
  (( (8#$mode & 8#077) == 0 ))
}

redact_debug_file() {
  local source="$1" destination="$2"
  /usr/bin/perl -pe '
    s{(authorization\s*[:=]\s*(?:bearer\s+)?)[A-Za-z0-9._~+/=-]+}{${1}[REDACTED]}ig;
    s{((?:access_token|refresh_token)\s*["'\'']?\s*[:=]\s*["'\''])[^"'\'']+}{${1}[REDACTED]}ig;
  ' "$source" >"$destination" 2>/dev/null
}

preserve_debug_artifacts() {
  local debug_run_path="$1" events="$2" vendor_stderr="$3" scratch="$4" wire
  [ -n "$debug_run_path" ] || return 0
  redact_debug_file "$events" "$debug_run_path/events.jsonl" || true
  redact_debug_file "$vendor_stderr" "$debug_run_path/stderr" || true
  cp "$scratch/agent.md" "$debug_run_path/agent.md" 2>/dev/null || true
  cp "$scratch/home/.kimi-code/config.toml" "$debug_run_path/config.toml" 2>/dev/null || true
  cp "$scratch/home/.kimi-code/tui.toml" "$debug_run_path/tui.toml" 2>/dev/null || true
  for wire in "$scratch"/home/.kimi-code/sessions/*/*/agents/main/wire.jsonl; do
    [ -f "$wire" ] || continue
    redact_debug_file "$wire" "$debug_run_path/wire.jsonl" || true
    break
  done
  chmod 600 "$debug_run_path"/* 2>/dev/null || true
  return 0
}

publish_stderr_receipt() {
  local output="$1" reason="$2" receipt="$RUN_TMP/stderr.receipt"
  printf 'delegation-kimi: %s\n' "$reason" >"$receipt" || return 1
  chmod 600 "$receipt" || return 1
  mv -f "$receipt" "$output.stderr"
}

publish_failure_diagnostic() {
  local output="$1" phase="$2" reason="$3" runner_rc="$4" vendor_rc="$5"
  local started="$6" events="$7" vendor_stderr="$8" lane="$9" write_scope="${10}"
  local debug_run_path="${11}" finished duration events_bytes stderr_bytes summary tools tmp
  finished="$(date +%s)"
  duration="$((finished - started))"
  events_bytes="$(wc -c <"$events" 2>/dev/null | tr -d ' ' || printf 0)"
  stderr_bytes="$(wc -c <"$vendor_stderr" 2>/dev/null | tr -d ' ' || printf 0)"
  summary="$(event_summary_json "$events")"
  tools="$(lane_tools_json "$lane")"
  tmp="$RUN_TMP/error.json"
  jq -n \
    --arg schema "delegation_kimi_error_v1" \
    --arg phase "$phase" --arg reason "$reason" \
    --argjson exit_code "$runner_rc" --argjson vendor_exit_code "$vendor_rc" \
    --argjson duration_seconds "$duration" \
    --argjson events_bytes "${events_bytes:-0}" --argjson stderr_bytes "${stderr_bytes:-0}" \
    --argjson event_summary "$summary" --argjson allowed_tools "$tools" \
    --arg write_scope "$write_scope" --arg rg_sha256 "$RG_SHA256" \
    --arg rg_dependencies_sha256 "$RG_DEPENDENCIES_SHA256" \
    --arg debug_path "$debug_run_path" --arg oauth_sync "$OAUTH_SYNC_STATUS" \
    --arg oauth_mode "$OAUTH_MODE" '
      {schema:$schema,phase:$phase,reason:$reason,exit_code:$exit_code,
       vendor_exit_code:$vendor_exit_code,duration_seconds:$duration_seconds,
       oauth_sync:$oauth_sync,oauth_mode:$oauth_mode,
       captured_bytes:{events:$events_bytes,vendor_stderr:$stderr_bytes},
       event_summary:$event_summary,
       tool_policy:{allowed:$allowed_tools,terminal:false,web_tools:false,
         subagents:false,skills:false,write_scope:$write_scope,
         process_exec:{mode:"allowlist",allowed:["rg"],attested:true}},
       search_runtime:{identity:"ripgrep",sha256:$rg_sha256,
         dependencies_sha256:$rg_dependencies_sha256},
       debug_path:(if $debug_path == "" then null else $debug_path end)}
  ' >"$tmp" || return 1
  mv -f "$tmp" "$output.error.json" || return 1
  publish_stderr_receipt "$output" "$reason"
}

prepare_native_home() {
  local scratch="$1" lane="${2:-scout}" oauth_layout="${3:-copy}" item source target source_path target_path
  local max_steps allowed_toml disabled_toml agent_file oauth_items
  source="$KIMI_HOME"
  target="$scratch/home/.kimi-code"
  mkdir -p "$target" "$scratch/home-tmp" "$scratch/empty-skills"
  # Do not import the ambient config: it may contain hooks, plugins, services,
  # or a weaker thinking effort. Keep only the authentication material and a
  # minimal, capability-constrained provider/model definition.
  oauth_items="credentials/kimi-code.json oauth/kimi-code device_id"
  if [ "$oauth_layout" = shared ]; then
    # Concurrent dispatches share one OAuth generation, so the vendor CLI's own
    # cross-process lock (oauth/kimi-code.lock) coordinates refresh-token
    # rotation between them. device_id stays a per-run copy of the ambient
    # value: every instance presents the same device identity, exactly like
    # vendor-parallel instances sharing one home.
    [ -n "$SHARED_OAUTH_DIR" ] || return 1
    ln -s "$SHARED_OAUTH_DIR/credentials" "$target/credentials" || return 1
    ln -s "$SHARED_OAUTH_DIR/oauth" "$target/oauth" || return 1
    oauth_items="device_id"
  fi
  for item in $oauth_items; do
    source_path="$source/$item"
    target_path="$target/$item"
    [ ! -e "$source_path" ] || {
      [ -f "$source_path" ] && [ ! -L "$source_path" ] || return 1
      mkdir -p "$(dirname "$target_path")"
      cp "$source_path" "$target_path"
    }
  done
  case "$lane" in
    clerk) max_steps=30 ;;
    scout) max_steps=40 ;;
    builder|frontend-builder) max_steps=60 ;;
    policy-annotation) max_steps=30 ;;
    *) return 1 ;;
  esac
  case "$lane" in
    clerk|scout)
      allowed_toml='"Read", "Glob", "Grep", "TodoList"'
      ;;
    builder)
      allowed_toml='"Read", "Glob", "Grep", "TodoList", "Write", "Edit"'
      ;;
    frontend-builder)
      allowed_toml='"Read", "Glob", "Grep", "TodoList", "Write", "Edit", "ReadMediaFile"'
      ;;
    policy-annotation)
      # An empty global enabled list means "unconstrained", so policy annotation
      # enables the known file tools and then denies all of them. The explicit
      # agent file independently uses `tools: []`.
      allowed_toml='"Read", "Glob", "Grep", "TodoList", "Write", "Edit", "ReadMediaFile"'
      ;;
  esac
  disabled_toml='"Bash", "WebSearch", "FetchURL", "EnterPlanMode", "ExitPlanMode", "Agent", "AgentSwarm", "AskUserQuestion", "Skill", "TaskList", "TaskOutput", "TaskStop", "CronCreate", "CronList", "CronDelete", "mcp__*"'
  case "$lane" in
    clerk|scout)
      disabled_toml="$disabled_toml, \"Write\", \"Edit\", \"ReadMediaFile\""
      ;;
    builder)
      disabled_toml="$disabled_toml, \"ReadMediaFile\""
      ;;
    policy-annotation)
      disabled_toml="$disabled_toml, \"Read\", \"Glob\", \"Grep\", \"TodoList\", \"Write\", \"Edit\", \"ReadMediaFile\""
      ;;
  esac
  cat >"$target/config.toml" <<EOF
default_model = "kimi-code/k3"
default_permission_mode = "auto"
default_plan_mode = false
merge_all_available_skills = false
telemetry = false

[loop_control]
max_steps_per_turn = $max_steps
max_retries_per_step = 3
max_ralph_iterations = 0
reserved_context_size = 50000

[background]
max_running_tasks = 1
keep_alive_on_exit = false
bash_auto_background_on_timeout = false
bash_task_timeout_s = 1
print_background_mode = "exit"
print_wait_ceiling_s = 1
print_max_turns = 1

[subagent]
timeout_ms = 1

[tools]
enabled = [$allowed_toml]
disabled = [$disabled_toml]

[thinking]
enabled = true
effort = "max"

[providers."managed:kimi-code"]
type = "kimi"
api_key = ""
base_url = "https://api.kimi.com/coding/v1"

[providers."managed:kimi-code".oauth]
storage = "file"
key = "oauth/kimi-code"

[models."kimi-code/k3"]
provider = "managed:kimi-code"
model = "k3"
max_context_size = 1048576
capabilities = [ "thinking", "always_thinking", "image_in", "video_in", "tool_use" ]
display_name = "K3"
support_efforts = [ "low", "high", "max" ]
default_effort = "max"
EOF
  cat >"$target/tui.toml" <<'EOF'
[upgrade]
auto_install = false
EOF
  agent_file="$scratch/agent.md"
  {
    printf '%s\n' '---'
    printf 'name: delegation-kimi-%s\n' "$lane"
    printf 'description: Delegation Kit constrained %s lane\n' "$lane"
    case "$lane" in
      clerk|scout)
        printf '%s\n' 'tools:' '  - Read' '  - Glob' '  - Grep' '  - TodoList'
        ;;
      builder)
        printf '%s\n' 'tools:' '  - Read' '  - Glob' '  - Grep' '  - TodoList' '  - Write' '  - Edit'
        ;;
      frontend-builder)
        printf '%s\n' 'tools:' '  - Read' '  - Glob' '  - Grep' '  - TodoList' '  - Write' '  - Edit' '  - ReadMediaFile'
        ;;
      policy-annotation)
        printf '%s\n' 'tools: []'
        ;;
    esac
    # `${base_prompt}` below is a literal Kimi template token.
    # shellcheck disable=SC2016
    printf '%s\n' \
      'disallowedTools:' \
      '  - Bash' \
      '  - WebSearch' \
      '  - FetchURL' \
      '  - EnterPlanMode' \
      '  - ExitPlanMode' \
      '  - Agent' \
      '  - AgentSwarm' \
      '  - AskUserQuestion' \
      '  - Skill' \
      '  - TaskList' \
      '  - TaskOutput' \
      '  - TaskStop' \
      '  - CronCreate' \
      '  - CronList' \
      '  - CronDelete' \
      '  - mcp__*' \
      'subagents: []' \
      '---' \
      '' \
      '${base_prompt}'
  } >"$agent_file"
}

print_check() {
  local as_json="${1:-0}" native_ok=false selected="none" lanes provisional
  have jq || die 69 "jq is required"
  validate_gate_graph || die 78 "central and executable routing gates are missing, invalid, or inconsistent"
  native_status && native_ok=true || true
  lanes="$(qualified_lanes)"
  provisional="$(provisional_lanes)"
  [ "$native_ok" = true ] && selected=native
  if [ "$as_json" = 1 ]; then
    jq -n \
      --arg model "kimi-k3" --arg native_model "$NATIVE_MODEL" \
      --arg cli_version "$NATIVE_VERSION" \
      --arg rg_version "$RG_VERSION" --arg rg_sha256 "$RG_SHA256" \
      --arg rg_dependencies_sha256 "$RG_DEPENDENCIES_SHA256" \
      --argjson rg_dependency_count "$RG_DEPENDENCY_COUNT" \
      --arg selected "$selected" --argjson efforts "$EFFORTS" --argjson lanes "$lanes" --argjson provisional "$provisional" \
      --argjson native "$native_ok" --arg native_reason "$NATIVE_REASON" \
      '{model:$model,models:{native:$native_model},efforts:$efforts,
        runtime_cli_compatibility:"capability-probed",
        runtime_cli_version:(if $cli_version == "" then null else $cli_version end),
        process_exec:{mode:"allowlist",allowed:["rg"],attested:$native},
        search_runtime:{identity:"ripgrep",
          version:(if $rg_version == "" then null else $rg_version end),
          sha256:(if $rg_sha256 == "" then null else $rg_sha256 end),
          dependencies_sha256:(if $rg_dependencies_sha256 == "" then null else $rg_dependencies_sha256 end),
          non_system_dependency_count:$rg_dependency_count,
          copied_per_run:true},
        terminal:false,web_tools:false,subagents:false,skills:false,
        selected_backend:$selected,qualified_lanes:$lanes,provisional_lanes:$provisional,backends:{
          native:{available:$native,reason:$native_reason,efforts:["max"],
            sandbox:"macos-sandbox-exec",isolated_home:true,environment_mode:"allowlist",
            ambient_home_read:false,
            process_exec:{mode:"allowlist",allowed:["rg"],attested:$native},
            terminal:false,web_tools:false,subagents:false,skills:false,
            hooks:false,services:false,
            oauth_refresh_persistence:"serialized-atomic-sync",
            oauth_modes:["serialized","shared"],
            builder_write_scope:"workdir",read_only_write_scope:"scratch"}}}'
  else
    printf 'Kimi K3: selected=%s qualified=%s provisional=%s\n' "$selected" "$lanes" "$provisional"
    printf '  native: %s (%s; model=%s; effort=max; cli=%s)\n' \
      "$native_ok" "$NATIVE_REASON" "$NATIVE_MODEL" "${NATIVE_VERSION:-unknown}"
  fi
}

extract_native() {
  local events="$1" output="$2" metrics="$3" started="$4" effort="$5" lane="$6" write_scope="$7"
  jq -ers '
    [.[] | select(.role == "assistant") | .content |
      if type == "string" then .
      elif type == "array" then
        map(if type == "string" then . else (.text // .content // empty) end) | join("")
      else empty end |
      select(length > 0)] | last // empty
  ' "$events" >"$output" || return 1
  [ -s "$output" ] || return 1
  jq -n --arg model "$NATIVE_MODEL" --arg effort "$effort" --arg lane "$lane" \
    --arg cli_version "$NATIVE_VERSION" --arg write_scope "$write_scope" \
    --arg rg_version "$RG_VERSION" --arg rg_sha256 "$RG_SHA256" \
    --arg rg_dependencies_sha256 "$RG_DEPENDENCIES_SHA256" \
    --arg oauth_mode "$OAUTH_MODE" \
    --argjson started "$started" '
    {model:$model,backend:"native",effort:$effort,lane:$lane,runtime_cli_version:$cli_version,
     runtime_cli_compatibility:"capability-probed",
     sandbox:"macos-sandbox-exec",isolated_home:true,environment_mode:"allowlist",
     ambient_home_read:false,
     process_exec:{mode:"allowlist",allowed:["rg"],attested:true},
     search_runtime:{identity:"ripgrep",version:$rg_version,sha256:$rg_sha256,
       dependencies_sha256:$rg_dependencies_sha256,copied_per_run:true},
     terminal:false,web_tools:false,subagents:false,skills:false,hooks:false,services:false,
     oauth_refresh_persistence:(if $oauth_mode == "shared"
       then "shared-vendor-lock" else "serialized-atomic-sync" end),
     oauth_mode:$oauth_mode,
     write_scope:$write_scope,
     started_at_epoch:$started,finished_at_epoch:now,usage_reported:false,
     tokens:{input:0,output:0,reasoning:0,cache_read:0,cache_write:0},
     provider_cost_usd:null}
  ' >"$metrics"
}

backend_available() {
  case "$1" in
    native) native_status ;;
    *) return 1 ;;
  esac
}

run_command() {
  local lane="" effort="auto" backend="auto" prompt_file="" prompt="" output="" workdir="" metrics="" evaluation_manifest_path=""
  local debug_dir="" debug_run_path=""
  local prompt_source="" backend_checked=0 expected_effort="" allow_provisional=0 evaluation=0 preflight_only=0
  local oauth_mode="${DELEGATION_KIMI_OAUTH_MODE:-serialized}"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --lane) lane="${2:-}"; shift 2 ;;
      --effort) effort="${2:-}"; shift 2 ;;
      --backend) backend="${2:-}"; shift 2 ;;
      --oauth) oauth_mode="${2:-}"; shift 2 ;;
      --prompt-file) prompt_file="${2:-}"; shift 2 ;;
      --prompt) prompt="${2:-}"; prompt_source="literal"; shift 2 ;;
      --output) output="${2:-}"; shift 2 ;;
      --workdir) workdir="${2:-}"; shift 2 ;;
      --metrics) metrics="${2:-}"; shift 2 ;;
      --allow-provisional) allow_provisional=1; shift ;;
      --evaluation) evaluation=1; shift ;;
      --evaluation-manifest) evaluation_manifest_path="${2:-}"; shift 2 ;;
      --preflight-only) preflight_only=1; shift ;;
      --debug-dir) debug_dir="${2:-}"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die 64 "unknown run argument: $1" ;;
    esac
  done
  case "$lane" in clerk|scout|builder|frontend-builder|reviewer|senior|judgement|policy-annotation) ;; *) die 64 "invalid lane: $lane" ;; esac
  case "$effort" in auto|low|high|max) ;; *) die 64 "invalid effort: $effort" ;; esac
  case "$backend" in auto|native) ;; *) die 64 "invalid backend: $backend" ;; esac
  case "$oauth_mode" in serialized|shared) ;; *) die 64 "invalid oauth mode: $oauth_mode" ;; esac
  OAUTH_MODE="$oauth_mode"
  [ -z "$prompt_file" ] || [ -z "$prompt_source" ] || die 64 "use only one of --prompt-file or --prompt"
  if [ -n "$prompt_file" ]; then
    [ -f "$prompt_file" ] || die 64 "prompt file missing: $prompt_file"
    prompt="$(<"$prompt_file")"
    prompt_source="file"
  fi
  [ -n "$prompt_source" ] || die 64 "--prompt-file or --prompt is required"
  [ -n "$prompt" ] || die 64 "prompt must not be empty"
  if [ "$evaluation" = 1 ]; then
    [ -n "$evaluation_manifest_path" ] || die 64 "--evaluation requires --evaluation-manifest"
    [ -n "$prompt_file" ] || die 64 "--evaluation requires --prompt-file to bind its raw hash"
    [ "$allow_provisional" = 0 ] || die 64 "--evaluation and --allow-provisional are mutually exclusive"
    [ "$oauth_mode" = serialized ] || die 64 "--evaluation runs are always serialized"
  else
    [ -z "$evaluation_manifest_path" ] || die 64 "--evaluation-manifest requires --evaluation"
  fi
  [ "$preflight_only" = 0 ] || [ "$evaluation" = 1 ] \
    || die 64 "--preflight-only requires --evaluation and --evaluation-manifest"
  [ -d "$workdir" ] || die 64 "workdir missing: $workdir"
  workdir="$(cd "$workdir" && pwd -P)"
  [ "$workdir" != / ] || die 64 "workdir must not be the filesystem root"
  local ambient_home
  ambient_home="$(cd "${HOME:?HOME is required}" && pwd -P)"
  [ "$workdir" != "$ambient_home" ] || die 64 "workdir must not be the user home"
  [ -n "$output" ] || die 64 "--output is required"
  if [ -n "$debug_dir" ]; then
    validate_debug_dir "$debug_dir" \
      || die 64 "--debug-dir must be an existing, writable directory with no group or other permissions"
    debug_dir="$(cd "$debug_dir" && pwd -P)"
  fi
  have jq || die 69 "jq is required"
  [ -f "$ROUTING_FILE" ] || die 69 "routing file missing: $ROUTING_FILE"
  jq -e . "$ROUTING_FILE" >/dev/null 2>&1 || die 69 "routing file is invalid JSON"
  validate_gate_graph || die 78 "central and executable routing gates are missing, invalid, or inconsistent"

  if [ "$backend" = auto ]; then
    local candidate qualified_seen=0
    backend=""
    while IFS= read -r candidate; do
      case "$candidate" in native) ;; *) continue ;; esac
      is_allowed "$lane" "$candidate" "$allow_provisional" "$evaluation" || continue
      qualified_seen=1
      if [ "$evaluation" = 1 ] || backend_available "$candidate"; then
        backend="$candidate"; backend_checked=1; break
      fi
    done < <(preferred_backends "$lane")
    if [ -z "$backend" ]; then
      # A qualified lane whose runtime is merely down is 69 (unavailable), not 78
      # (never approved). The caller must read "keep the incumbent for now", not
      # "this lane failed evaluation" — they are different facts with different
      # lifetimes.
      [ "$qualified_seen" = 0 ] || die 69 "$NATIVE_REASON"
      status="$(gate_status "$lane" native)"
      if [ "$status" = provisional ]; then
        die 78 "lane '$lane' is provisional; pass --allow-provisional after an explicit routing decision"
      elif [ "$status" = candidate ]; then
        die 78 "lane '$lane' is candidate; pass --evaluation only for a controlled qualification run"
      else
        die 78 "lane '$lane' has non-dispatchable status '$status'"
      fi
    fi
  else
    if ! is_allowed "$lane" "$backend" "$allow_provisional" "$evaluation"; then
      status="$(gate_status "$lane" "$backend")"
      if [ "$status" = provisional ]; then
        die 78 "lane '$lane' backend '$backend' is provisional; pass --allow-provisional after an explicit routing decision"
      elif [ "$status" = candidate ]; then
        die 78 "lane '$lane' backend '$backend' is candidate; pass --evaluation only for a controlled qualification run"
      else
        die 78 "lane '$lane' backend '$backend' has non-dispatchable status '$status'"
      fi
    fi
  fi

  [ "$effort" != auto ] || effort="$(default_effort)"
  expected_effort="$(qualified_effort "$lane" "$backend")" \
    || die 69 "qualified lane '$lane' has no pinned effort for backend '$backend'"
  [ "$effort" = "$expected_effort" ] \
    || die 78 "lane '$lane' backend '$backend' is qualified only at effort '$expected_effort'"
  local tmp dispatch_prompt_file="$prompt_file"
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/delegation-kimi.XXXXXX")"
  tmp="$(cd "$tmp" && pwd -P)"
  RUN_TMP="$tmp"
  trap cleanup_run EXIT
  if [ "$evaluation" = 1 ]; then
    dispatch_prompt_file="$tmp/prompt.snapshot"
    cp -- "$prompt_file" "$dispatch_prompt_file" \
      || die 70 "could not snapshot evaluation prompt"
    prompt="$(cat "$dispatch_prompt_file"; printf x)"
    prompt="${prompt%x}"
    evaluation_manifest "$evaluation_manifest_path" "$lane" "$dispatch_prompt_file" "$expected_effort"
  fi
  if [ "$backend" = native ] && [ "$effort" != max ]; then
    die 64 "native backend supports only max effort"
  fi
  if [ "$backend_checked" -eq 0 ] || [ "$evaluation" = 1 ]; then
    backend_available "$backend" || die 69 "$NATIVE_REASON"
  fi

  metrics="${metrics:-$output.metrics.json}"
  local output_parent metrics_parent output_name metrics_name commit error_json stderr_receipt
  output_parent="$(dirname "$output")"; output_name="$(basename "$output")"
  metrics_parent="$(dirname "$metrics")"; metrics_name="$(basename "$metrics")"
  case "$output_name" in .|..) die 64 "invalid output filename" ;; esac
  case "$metrics_name" in .|..) die 64 "invalid metrics filename" ;; esac
  [ -d "$output_parent" ] || die 64 "output parent directory must already exist: $output_parent"
  [ -d "$metrics_parent" ] || die 64 "metrics parent directory must already exist: $metrics_parent"
  output="$(cd "$output_parent" && pwd -P)/$output_name"
  metrics="$(cd "$metrics_parent" && pwd -P)/$metrics_name"
  commit="$output.commit.json"
  error_json="$output.error.json"
  stderr_receipt="$output.stderr"
  [ "$output" != "$metrics" ] || die 64 "output and metrics paths resolve to the same file"
  [ "$metrics" != "$error_json" ] && [ "$metrics" != "$stderr_receipt" ] \
    || die 64 "metrics path collides with a diagnostic artifact"
  if [ "$evaluation" = 1 ]; then
    [ "$metrics" != "$commit" ] \
      || die 64 "metrics path collides with evaluation commit marker"
  fi
  [ ! -L "$output" ] || die 64 "output must not be a symlink"
  [ ! -L "$metrics" ] || die 64 "metrics must not be a symlink"
  [ ! -L "$error_json" ] || die 64 "error diagnostic must not be a symlink"
  [ ! -L "$stderr_receipt" ] || die 64 "stderr receipt must not be a symlink"
  [ ! -e "$output" ] || die 64 "output must not already exist"
  [ ! -e "$metrics" ] || die 64 "metrics must not already exist"
  [ ! -e "$error_json" ] || die 64 "error diagnostic must not already exist"
  [ ! -e "$stderr_receipt" ] || die 64 "stderr receipt must not already exist"
  if [ "$evaluation" = 1 ]; then
    [ ! -L "$commit" ] || die 64 "evaluation commit marker must not be a symlink"
    [ ! -e "$commit" ] || die 64 "evaluation commit marker must not already exist"
  fi
  if [ "$lane" != builder ] && [ "$lane" != frontend-builder ]; then
    case "$output" in "$workdir"/*) die 64 "read-only lane output must be outside workdir" ;; esac
    case "$metrics" in "$workdir"/*) die 64 "read-only lane metrics must be outside workdir" ;; esac
  fi
  case "$debug_dir" in "$workdir"|"$workdir"/*) die 64 "debug directory must be outside workdir" ;; esac

  local events rc=0 started result_tmp metrics_tmp cancel_killer_pid=""
  local final_rc=0 failure_reason="" failure_phase="" vendor_rc=0
  events="$tmp/events.jsonl"
  result_tmp="$tmp/result.txt"
  metrics_tmp="$tmp/metrics.json"
  started="$(date +%s)"

  # Every lane gets the same isolated configuration, scrubbed environment, and
  # process boundary. Builders may write only inside the canonical worktree;
  # read-only lanes may write only runner scratch. No imported hooks/services or
  # child process execution is exposed. Network remains available to the Kimi
  # provider process itself.
  local sandbox_bin timeout_seconds
  sandbox_status || die 69 "$NATIVE_REASON"
  sandbox_bin="$KIMI_SANDBOX_BIN"
  [ "$evaluation" -eq 1 ] \
    && timeout_seconds="$EVALUATION_TIMEOUT_SECONDS" \
    || timeout_seconds="$OPERATIONAL_TIMEOUT_SECONDS"
  # Preflight ends here: every pre-provider check the real evaluation run makes
  # has passed, and nothing caller-visible has been created. Exit before the
  # OAuth lock, isolated dispatch home, and sandboxed CLI invocation below.
  if [ "$preflight_only" = 1 ]; then
    print_preflight_receipt "$lane" "$effort" || die 70 "could not emit preflight receipt"
    exit 0
  fi
  local sandbox_profile write_scope scratch_rg
  local lock_rc=0 sync_rc=0 ambient_credential_hash=""
  if [ "$oauth_mode" = shared ]; then
    # The kit lock is held only inside seed_shared_oauth; concurrent dispatches
    # then proceed in parallel against the shared generation, and the vendor
    # CLI's own oauth lock coordinates their refreshes.
    seed_shared_oauth
    prepare_native_home "$tmp" "$lane" shared || die 69 "could not prepare isolated Kimi home"
  else
    acquire_oauth_lock || lock_rc=$?
    if [ "$lock_rc" -eq 2 ]; then
      die 75 "another Kimi invocation is using the OAuth refresh session; retry after it finishes"
    elif [ "$lock_rc" -ne 0 ]; then
      die 69 "could not secure the Kimi OAuth credential for isolated dispatch"
    fi
    prepare_native_home "$tmp" "$lane" || die 69 "could not prepare isolated Kimi home"
  fi
  RG_RUN_DIR="$(mktemp -d "${TMPDIR:-/tmp}/delegation-kimi-rg-run.XXXXXX")" \
    || die 70 "could not create protected ripgrep run directory"
  RG_RUN_DIR="$(cd "$RG_RUN_DIR" && pwd -P)"
  chmod 700 "$RG_RUN_DIR"
  scratch_rg="$RG_RUN_DIR/rg"
  copy_verified_rg "$scratch_rg" || die 69 "$NATIVE_REASON"
  if [ "$oauth_mode" != shared ]; then
    # Shared mode has no per-run baseline: the "copy" is the live shared file
    # that peers may legitimately rotate mid-run. Start-consistency and
    # external-login detection are done by seed_shared_oauth under the kit
    # lock and by publish_shared_oauth afterwards.
    OAUTH_BASELINE_HASH="$(sha256_file "$tmp/home/.kimi-code/credentials/kimi-code.json")" \
      || die 69 "could not fingerprint the isolated Kimi OAuth credential"
    ambient_credential_hash="$(sha256_file "$CREDENTIAL_FILE")" \
      || die 69 "could not fingerprint the ambient Kimi OAuth credential"
    [ "$OAUTH_BASELINE_HASH" = "$ambient_credential_hash" ] \
      || die 75 "Kimi OAuth credentials changed while isolated dispatch was being prepared; retry"
  fi
  if [ -n "$debug_dir" ]; then
    debug_run_path="$debug_dir/delegation-kimi-$(date -u +%Y%m%dT%H%M%SZ)-$$"
    mkdir -m 700 "$debug_run_path" || die 70 "could not create private debug run directory"
  fi
  # Shared mode carves the shared OAuth generation out of both denies: the
  # child's credential reads and refresh writes go through symlinks whose
  # resolved paths land inside SHARED_OAUTH, under REAL_HOME and outside
  # SCRATCH, where the serialized profile would deny them. The serialized
  # profile stays byte-identical to before.
  if [ "$oauth_mode" = shared ]; then
    sandbox_profile='(version 1)
    (allow default)
    (deny process-exec
      (require-all
        (require-not (literal (param "KIMI_BIN")))
        (require-not (literal "/usr/bin/true"))
        (require-not (literal (param "RG_BIN")))))
    (deny file-read-data
      (require-all
        (subpath (param "REAL_HOME"))
        (require-not (subpath (param "WORKDIR")))
        (require-not (subpath (param "SCRATCH")))
        (require-not (subpath (param "SHARED_OAUTH")))
        (require-not (literal (param "KIMI_BIN")))))'
  else
    sandbox_profile='(version 1)
    (allow default)
    (deny process-exec
      (require-all
        (require-not (literal (param "KIMI_BIN")))
        (require-not (literal "/usr/bin/true"))
        (require-not (literal (param "RG_BIN")))))
    (deny file-read-data
      (require-all
        (subpath (param "REAL_HOME"))
        (require-not (subpath (param "WORKDIR")))
        (require-not (subpath (param "SCRATCH")))
        (require-not (literal (param "KIMI_BIN")))))'
  fi
  if [ "$lane" = builder ] || [ "$lane" = frontend-builder ]; then
    write_scope="workdir"
    if [ "$oauth_mode" = shared ]; then
      sandbox_profile+=$'\n    (deny file-write* (require-all (require-not (subpath (param "SCRATCH"))) (require-not (subpath (param "WORKDIR"))) (require-not (subpath (param "SHARED_OAUTH")))))'
    else
      sandbox_profile+=$'\n    (deny file-write* (require-all (require-not (subpath (param "SCRATCH"))) (require-not (subpath (param "WORKDIR")))))'
    fi
  else
    write_scope="scratch"
    if [ "$oauth_mode" = shared ]; then
      sandbox_profile+=$'\n    (deny file-write* (require-all (require-not (subpath (param "SCRATCH"))) (require-not (subpath (param "SHARED_OAUTH")))))'
    else
      sandbox_profile+=$'\n    (deny file-write* (require-not (subpath (param "SCRATCH"))))'
    fi
  fi
  sandbox_profile+=$'\n    (deny file-write* (subpath (param "RG_DIR")))'
  sandbox_profile+=$'\n'
  local -a sandbox_defines=(-D "SCRATCH=$tmp" -D "WORKDIR=$workdir"
    -D "REAL_HOME=$ambient_home" -D "KIMI_BIN=$NATIVE_BIN" -D "RG_BIN=$scratch_rg"
    -D "RG_DIR=$RG_RUN_DIR")
  [ "$oauth_mode" != shared ] || sandbox_defines+=(-D "SHARED_OAUTH=$SHARED_OAUTH_DIR")
  : >"$events"
  : >"$tmp/stderr"
  CANCEL_REQUESTED=0
  trap handle_cancel INT TERM
  (
    cd "$workdir"
    exec env -i \
      PATH="$RG_RUN_DIR:/usr/bin:/bin" \
      HOME="$tmp/home" KIMI_CODE_HOME="$tmp/home/.kimi-code" \
      TMPDIR="$tmp/home-tmp" SHELL="/usr/bin/true" \
      LANG="${LANG:-C}" NO_COLOR=1 CI=1 \
      KIMI_DISABLE_TELEMETRY=1 KIMI_CODE_NO_AUTO_UPDATE=1 KIMI_DISABLE_CRON=1 \
      "$KIMI_TIMEOUT_BIN" -k 10 "$timeout_seconds" \
      "$sandbox_bin" "${sandbox_defines[@]}" \
        -p "$sandbox_profile" "$NATIVE_BIN" \
        --prompt "$prompt" --model "$NATIVE_MODEL" \
        --agent-file "$tmp/agent.md" --skills-dir "$tmp/empty-skills" \
        --output-format stream-json </dev/null
  ) >"$events" 2>"$tmp/stderr" &
  CHILD_PID=$!
  start_heartbeat "$CHILD_PID" "$events" "$started"
  wait "$CHILD_PID" || rc=$?
  if [ "$CANCEL_REQUESTED" -eq 1 ] && kill -0 "$CHILD_PID" >/dev/null 2>&1; then
    (
      sleep "$CANCEL_GRACE_SECONDS"
      kill -KILL "$CHILD_PID" >/dev/null 2>&1 || true
    ) &
    cancel_killer_pid=$!
    wait "$CHILD_PID" || rc=$?
    kill "$cancel_killer_pid" >/dev/null 2>&1 || true
    wait "$cancel_killer_pid" 2>/dev/null || true
  fi
  vendor_rc="$rc"
  CHILD_PID=""
  if [ -n "$HEARTBEAT_PID" ]; then
    kill "$HEARTBEAT_PID" >/dev/null 2>&1 || true
    wait "$HEARTBEAT_PID" 2>/dev/null || true
    HEARTBEAT_PID=""
  fi
  if [ "$oauth_mode" = shared ]; then
    publish_shared_oauth || sync_rc=$?
  else
    sync_native_credentials "$tmp" || sync_rc=$?
  fi
  case "$sync_rc" in
    0) OAUTH_SYNC_STATUS="ok" ;;
    2) OAUTH_SYNC_STATUS="conflict" ;;
    3) OAUTH_SYNC_STATUS="deferred" ;;
    *) OAUTH_SYNC_STATUS="failed" ;;
  esac
  release_oauth_lock
  trap - INT TERM
  if [ "$CANCEL_REQUESTED" -eq 1 ]; then
    final_rc=130
    failure_reason="caller_cancelled"
    failure_phase="dispatch"
  elif [ "$rc" -ne 0 ]; then
    IFS='|' read -r final_rc failure_reason failure_phase \
      <<<"$(classify_dispatch_failure "$events" "$tmp/stderr" "$rc" "$evaluation")"
  elif [ "$sync_rc" -eq 2 ]; then
    final_rc=75
    failure_reason="oauth_conflict"
    failure_phase="oauth-sync"
  elif [ "$sync_rc" -ne 0 ] && [ "$sync_rc" -ne 3 ]; then
    # 3 (deferred) is a success: the shared state is durable and the busy kit
    # lock means a concurrent delegation run will publish it instead.
    final_rc=70
    failure_reason="oauth_sync_failed"
    failure_phase="oauth-sync"
  fi
  if [ "$final_rc" -eq 0 ]; then
    if ! extract_native "$events" "$result_tmp" "$metrics_tmp" "$started" "$effort" "$lane" "$write_scope"; then
      final_rc=70
      failure_reason="output_invalid"
      failure_phase="output"
    fi
  fi
  if [ "$final_rc" -eq 0 ] && [ "$evaluation" = 1 ] &&
      [ "$(wc -m <"$result_tmp" | tr -d ' ')" -gt "$EVALUATION_MAX_OUTPUT_CHARS" ]; then
    final_rc=70
    failure_reason="output_too_large"
    failure_phase="output"
  fi
  preserve_debug_artifacts "$debug_run_path" "$events" "$tmp/stderr" "$tmp"
  # A successful evaluation publishes its attempt receipt or publishes nothing.
  # Every field is recomputed here from local state the manifest already bound;
  # nothing is accepted from the caller.
  if [ "$final_rc" -eq 0 ] && [ "$evaluation" = 1 ]; then
    local raw_output_sha256=""
    raw_output_sha256="$(sha256_file "$result_tmp")" || raw_output_sha256=""
    if [ -z "$raw_output_sha256" ] || [ -z "${EVALUATION_MANIFEST_SHA256:-}" ] ||
       [ -z "${EVALUATION_PROMPT_SHA256:-}" ] || [ -z "${EVALUATION_RUNNER_SOURCE_COMMIT:-}" ] ||
       [ -z "${EVALUATION_RUNNER_SHA256:-}" ]; then
      final_rc=70
      failure_reason="evaluation_receipt_invalid"
      failure_phase="output"
    elif ! jq --arg manifest_sha256 "$EVALUATION_MANIFEST_SHA256" \
        --arg prompt_sha256 "$EVALUATION_PROMPT_SHA256" \
        --arg source_commit "$EVALUATION_RUNNER_SOURCE_COMMIT" \
        --arg runner_sha256 "$EVALUATION_RUNNER_SHA256" \
        --arg raw_output_sha256 "$raw_output_sha256" \
        '.evaluation_receipt = {
          schema_version:"delegation_policy_annotation_attempt_receipt_v1",
          evaluation_manifest_sha256:$manifest_sha256,
          prompt_sha256:$prompt_sha256,
          runner_source_commit:$source_commit,
          runner_sha256:$runner_sha256,
          raw_output_sha256:$raw_output_sha256,
          provider_attempts:1,
          post_observation_retries:0}' "$metrics_tmp" >"$tmp/metrics.receipt.json" ||
       ! mv -f "$tmp/metrics.receipt.json" "$metrics_tmp"; then
      rm -f -- "$tmp/metrics.receipt.json"
      final_rc=70
      failure_reason="evaluation_receipt_invalid"
      failure_phase="output"
    fi
  fi

  if [ "$final_rc" -ne 0 ]; then
    publish_failure_diagnostic "$output" "$failure_phase" "$failure_reason" \
      "$final_rc" "$vendor_rc" "$started" "$events" "$tmp/stderr" \
      "$lane" "$write_scope" "$debug_run_path" || {
        publish_stderr_receipt "$output" "$failure_reason" || true
      }
    exit "$final_rc"
  fi
  local commit_tmp="$tmp/publication.commit.json" metrics_sha256=""
  if [ "$evaluation" = 1 ]; then
    raw_output_sha256="$(sha256_file "$result_tmp")" || raw_output_sha256=""
    metrics_sha256="$(sha256_file "$metrics_tmp")" || metrics_sha256=""
    if [ -z "$raw_output_sha256" ] || [ -z "$metrics_sha256" ] ||
       ! jq -n --arg raw_output_sha256 "$raw_output_sha256" \
         --arg metrics_sha256 "$metrics_sha256" \
         --arg manifest_sha256 "$EVALUATION_MANIFEST_SHA256" \
         '{schema_version:"delegation_policy_annotation_publication_commit_v1",
           raw_output_sha256:$raw_output_sha256,metrics_sha256:$metrics_sha256,
           evaluation_manifest_sha256:$manifest_sha256}' >"$commit_tmp"; then
      publish_failure_diagnostic "$output" publish publication_stage_failed \
        70 "$vendor_rc" "$started" "$events" "$tmp/stderr" \
        "$lane" "$write_scope" "$debug_run_path" || true
      exit 70
    fi
  fi
  if ! mv -f "$result_tmp" "$output"; then
    rm -f -- "$output"
    publish_failure_diagnostic "$output" publish output_finalize_failed \
      70 "$vendor_rc" "$started" "$events" "$tmp/stderr" \
      "$lane" "$write_scope" "$debug_run_path" || true
    exit 70
  fi
  if ! mv -f "$metrics_tmp" "$metrics"; then
    rm -f -- "$output" "$metrics"
    publish_failure_diagnostic "$output" publish metrics_finalize_failed \
      70 "$vendor_rc" "$started" "$events" "$tmp/stderr" \
      "$lane" "$write_scope" "$debug_run_path" || true
    exit 70
  fi
  if [ "$evaluation" = 1 ] && ! mv -f "$commit_tmp" "$commit"; then
    rm -f -- "$output" "$metrics" "$commit"
    publish_failure_diagnostic "$output" publish evaluation_commit_finalize_failed \
      70 "$vendor_rc" "$started" "$events" "$tmp/stderr" \
      "$lane" "$write_scope" "$debug_run_path" || true
    exit 70
  fi
}

case "${1:-}" in
  check)
    shift
    case "${1:-}" in "") print_check 0 ;; --json) shift; [ "$#" -eq 0 ] || die 64 "unknown check argument: $1"; print_check 1 ;; *) die 64 "unknown check argument: $1" ;; esac
    ;;
  pin-rg) shift; pin_rg_command "$@" ;;
  run) shift; run_command "$@" ;;
  -h|--help|"") usage ;;
  *) die 64 "unknown command: $1" ;;
esac
