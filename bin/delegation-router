#!/usr/bin/env python3
"""Local model router over the personal configuration.

The user declares a pool of profiles, a default and a decider. `check` and
`decide` are read-only discovery: `decide` recommends one profile and never
dispatches it. `serve` is the user's explicit choice to let the router pick a
profile inside that pool for every request sent to it. `eval` measures a
decider offline against recorded outcomes; it calls the decider, never a
pool profile."""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from delegation_config import LISTEN_PATTERN, ROUTER_DECIDERS, load  # noqa: E402
from delegation_router_pipeline import (  # noqa: E402
    check,
    decider_line,
    route,
    router_block,
)

def main():
    p = argparse.ArgumentParser(prog="delegation-router")
    sub = p.add_subparsers(dest="command", required=True)
    pc = sub.add_parser("check", help="validate the router block; no network")
    pc.add_argument("--json", action="store_true")
    pd = sub.add_parser("decide", help="recommend one profile; never dispatches it")
    pd.add_argument("--prompt-file", required=True)
    pd.add_argument("--decider", choices=sorted(ROUTER_DECIDERS))
    pd.add_argument("--input", choices=["excerpt", "full"])
    pd.add_argument("--json", action="store_true")
    ps = sub.add_parser("serve", help="OpenAI-compatible endpoint on loopback")
    ps.add_argument("--listen", help="loopback host:port (default: router.listen)")
    pk = sub.add_parser("catalog", help="where the ladder comes from; refresh it")
    pk.add_argument("action", choices=["show", "refresh"])
    pk.add_argument("--key-env", default="AA_API_KEY", help="variable holding the Artificial Analysis key")
    pk.add_argument("--shipped", action="store_true", help="write config/catalog.json (release)")
    pk.add_argument("--json", action="store_true")
    pe = sub.add_parser(
        "eval", help="measure a decider offline on a golden set; never dispatches"
    )
    pe.add_argument("--items", required=True, help="JSONL golden set")
    pe.add_argument("--decider", choices=sorted(ROUTER_DECIDERS))
    pe.add_argument("--input", choices=["excerpt", "full"])
    pe.add_argument("--output", help="directory for report.json and gate.json")
    pe.add_argument("--json", action="store_true")
    a = p.parse_args()
    try:
        if a.command == "catalog":
            return catalog_command(a)
        c = load()
        if a.command == "check":
            result = check(c)
            if a.json:
                print(json.dumps(result, indent=2))
            elif not result["enabled"]:
                print("router: not configured — " + result["summary"])
            else:
                print(decider_line(result["decider"]))
                print(
                    "  governs %d profiles (default %s) on %s, mode %s:"
                    % (
                        len(result["pool"]),
                        result["default"],
                        result["listen"],
                        result["mode"],
                    )
                )
                for m in result["pool"]:
                    print(
                        "    %s: %s/%s tier=%s (%s)%s"
                        % (
                            m["profile"],
                            m["adapter"],
                            m["model"],
                            m["tier"],
                            m.get("tier_source"),
                            " lane=" + m["lane"] if m.get("lane") else "",
                        )
                    )
                print(
                    "  catalog %s (%s)"
                    % (result["catalog_version"], result["catalog_source"])
                )
                for w in result["warnings"]:
                    print("  ! " + w)
            return 0
        router_block(c)
        if a.command == "serve":
            from delegation_router_server import serve

            if a.listen and not LISTEN_PATTERN.fullmatch(a.listen):
                raise ValueError("--listen must be a loopback host:port")
            return serve(c, a.listen)
        if a.command == "eval":
            from delegation_router_eval import evaluate, read_items

            kind = a.decider or c["router"].get("decider", {}).get("kind", "llm")
            report = evaluate(c, read_items(a.items), kind, a.input)
            if a.output:
                out_dir = Path(a.output)
                out_dir.mkdir(parents=True, exist_ok=True)
                (out_dir / "report.json").write_text(json.dumps(report, indent=2) + "\n")
                (out_dir / "gate.json").write_text(
                    json.dumps(report["gate"], indent=2) + "\n"
                )
            if a.json:
                print(json.dumps(report, indent=2))
            else:
                m, b = report["metrics"], report["baseline"]
                print(
                    "%s/%s on %d items (%d prompts): accuracy %s vs baseline %s; cost $%.4f vs $%.4f; optimal %s; robustness %s; p95 %s ms; undecidable %.0f%% → %s"
                    % (
                        report["decider"]["id"],
                        report["decider"]["version"],
                        report["items"],
                        report["prompts"],
                        _pct(m["accuracy"]),
                        _pct(b["accuracy"]),
                        m["cost_usd"],
                        b["cost_usd"],
                        _pct(m["optimal_selection_ratio"]),
                        _pct(m["robustness"]),
                        m["latency_ms"]["p95"],
                        100 * m["undecidable_rate"],
                        "accepted" if report["gate"]["accepted"] else "not accepted",
                    )
                )
                for name, ok in report["gate"]["checks"].items():
                    print("  %s %s" % ("ok " if ok else "NO ", name))
            return 0
        text = Path(a.prompt_file).read_text()
        body = {"messages": [{"role": "user", "content": text}]}
        out, _choice, _feats, _blocked = route(
            c, body, decider_kind=a.decider, input_mode=a.input
        )
        if a.json:
            print(json.dumps(out, indent=2))
        else:
            print(
                "%s (%s, tier %s)%s"
                % (
                    out["chosen"]["profile"],
                    out["chosen"]["model"],
                    out["chosen"]["tier"],
                    " — undecidable, default" if out["undecidable"] else "",
                )
            )
            for reason in out["reasons"]:
                print("  " + reason)
            for warning in out["warnings"]:
                print("  ! " + warning)
        return 0
    except (OSError, ValueError, KeyError, TypeError) as error:
        print("delegation-router: " + str(error), file=sys.stderr)
        return 65


def catalog_command(a):
    import os

    from delegation_config import catalog
    from delegation_router_catalog import (
        AA_KEY_FILE,
        aa_key,
        data_home,
        describe,
        fetch,
        refresh,
        shipped,
        today,
        write,
    )

    if a.action == "show":
        report = describe(catalog())
        if a.json:
            print(json.dumps(report, indent=2))
            return 0
        t = report["tiering"]
        print(
            "catalog %s (%s: %s)"
            % (report["catalog_version"], report["catalog_source"], report["catalog_file"])
        )
        if t:
            print(
                "  ladder: %s — frontier within %s of the best (%s), mid within %s; %s, %s"
                % (
                    t.get("rule"),
                    t.get("frontier_within"),
                    t.get("top_index"),
                    t.get("mid_within"),
                    t.get("source"),
                    t.get("date"),
                )
            )
        print(
            "  %d models with third-party evidence, %d placed by hand"
            % (report["with_evidence"], report["hand_placed"])
        )
        for m in report["models"]:
            print(
                "    %-26s %-9s %s%s"
                % (
                    m["model"],
                    m["tier"],
                    m["tier_source"],
                    " index %s (%s)" % (m["index"], m["variant"]) if m["index"] is not None else "",
                )
            )
        return 0
    key = aa_key(os.environ, a.key_env)
    if not key:
        raise ValueError(
            "no Artificial Analysis key: set %s, or write %s=<key> into %s (mode 600)"
            % (a.key_env, a.key_env, data_home() / "config" / AA_KEY_FILE)
        )
    rows = fetch(key)
    new, unmatched = refresh(shipped(), rows, today())
    path = write(new, shipped=a.shipped)
    summary = {
        "written": str(path),
        "catalog_version": new["catalog_version"],
        "tiering": new["tiering"],
        "matched": len(new["models"]) - len(unmatched),
        "unmatched": unmatched,
        "attribution": new["tiering"]["attribution"],
    }
    if a.json:
        print(json.dumps(summary, indent=2))
    else:
        print(
            "catalog refreshed → %s (%s): %d models placed from Artificial Analysis (top index %s), %d unmatched%s"
            % (
                path,
                new["catalog_version"],
                summary["matched"],
                new["tiering"]["top_index"],
                len(unmatched),
                ": " + ", ".join(unmatched) if unmatched else "",
            )
        )
        print("  data: Artificial Analysis, " + new["tiering"]["attribution"])
    return 0


def _pct(value):
    return "n/a" if value is None else "%.0f%%" % (100 * value)


if __name__ == "__main__":
    sys.exit(main())
