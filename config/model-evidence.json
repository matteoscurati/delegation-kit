    "frontend-builder": {
      "required_metrics": ["webdev.elo"],
      "supporting_metrics": ["coding.deep_swe_pass_pct", "agent.confirmed_success_effect_pct"],
      "note": "WebDev preference is valid only for frontend/product implementation, not general builder work."
