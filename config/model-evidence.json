      "required_metrics": ["agent.steerability_effect_pct", "agent.praise_vs_complaint_effect_pct"],
      "supporting_metrics": ["review.precision_pct", "webdev.elo"],
      "note": "Real-world correction handling and user outcomes are primary; review and taste remain domain-specific."
    },
    "judgement": {
      "required_metrics": [],
      "supporting_metrics": ["agent.steerability_effect_pct", "agent.praise_vs_complaint_effect_pct"],
      "manual_only": true,
      "note": "No public coding leaderboard is sufficient to auto-qualify architecture or final-judgement work."
    }
