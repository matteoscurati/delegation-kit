.DS_Store
*.log
*.bak
.env*
!.env.example
*.token

# Per-checkout agent state is machine-specific and never part of the kit.
.claude/settings.local.json
.kilo/
.hermes/

# Private and one-off evaluation scratch stays outside the frozen evaluation/ archive.
eval/

# Python bytecode from the commands and the test suites.
__pycache__/
*.py[cod]

# A runner invoked from a checkout reads its key file from $ROOT/config/ (see
# docs/user-configuration.md). Nothing writes one here, but never risk it.
config/zai.env
config/deepseek.env
config/qwen-token-plan.env

# Dipylon-specific evaluation packs are generated and owned outside this kit.
evaluation/dipylon-ai-jury-*/
