        "public_services",
        "billing_owner_email",
        "highest_schema_service",
        "latest_release_service",
        "pager_for_search"
      ],
      "properties": {
        "service_count": {"type": "integer"},
        "public_services": {"type": "array", "items": {"type": "string"}},
        "billing_owner_email": {"type": "string"},
        "highest_schema_service": {"type": "string"},
        "latest_release_service": {"type": "string"},
        "pager_for_search": {"type": "string"}
      }
    }
  }
}
